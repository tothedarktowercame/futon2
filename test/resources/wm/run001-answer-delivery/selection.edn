 fire first.\nTrigger (a)'s premise, hole retention feeding declarations, landed on\n2026-09-20 in futon2 3b5557aa.\n\n### tl;dr\n\n- [ ] The A query interface has a WMC backend using cached SDD compilations of the declared common-cause model.\n- [ ] WMC marginal and joint queries match exact enumeration, including the matched-marginal total-G invariance control under point beliefs and product preferences.\n- [ ] Compiled query means and variances match small-model calculations while preserving shared rate-parameter identity.\n- [ ] Compiled joint queries compute the state-observation mutual information needed for total G under spread beliefs.\n- [ ] Compilation cost, memory use, and repeated-query latency are measured on actual candidate families."}], :pinned-at "2026-09-21T03:41:48.035185967Z", :tension-rule :lifecycle-sections}, :pattern-source {:id "/home/joe/code/futon3/library/ukrns/scale-register.flexiarg#c64abbe3367d8ed9d3c5c568347bad0d7f807b6697c7bd01fe4f807d55e7f395", :path "/home/joe/code/futon3/library/ukrns/scale-register.flexiarg", :file "5a71ce65aeda051a16d62ae214052c9a18e96bb01abd8c446bb67a1e3ff89e33-c64abbe3367d8ed9d3c5c568347bad0d7f807b6697c7bd01fe4f807d55e7f395.source", :sha256 "c64abbe3367d8ed9d3c5c568347bad0d7f807b6697c7bd01fe4f807d55e7f395", :revision "7fc6a05004aa3e601e53eba633d62213da0af4b2"}, :retrieval [{:retriever "embedding", :rank 15, :retriever-rank 15, :raw {:pattern_id "ukrns/scale-register", :embedding_rank 15, :relevance 0.40828162866710743, :posterior_mean 0.5, :posterior_n 0, :label "self-graded", :posterior_rank 15}}]}, :proposal-id "7bb0d46dba03519760ce2e1a5262253c26006e125cb9e13f93cfbe68772608f6"} {:schema :wm/cascade-proposal-v1, :status :proposed, :origin :retrieval-proposed, :target "M-a-wmc-scaling", :pattern "war-room/wr-1-three-futon-split", :evidence {:target {:id "M-a-wmc-scaling", :kind :mission, :source "/home/joe/code/futon2/holes/M-a-wmc-scaling.md#40a494e8d9f24c344cc473637f8f0a2ca64feaf4f836092f834493d3044a0220", :