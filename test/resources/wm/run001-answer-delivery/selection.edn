s/the-system-stops-on-schedule" 5], :pattern-id "apparatus/the-system-stops-on-schedule", :occurrence-id ["apparatus/the-system-stops-on-schedule" 5], :target "M-futonzero-prelim-practice", :guard {:status :interpreted, :clauses [{:present #{["M-futonzero-prelim-practice" :pattern-done ["problems/process-conduct-is-unassured" 4]]}, :absent #{}}]}, :produces #{["M-futonzero-prelim-practice" :pattern-done ["apparatus/the-system-stops-on-schedule" 5]]}, :theta 1/2, :theta-record {:status :no-recorded-trials, :unattributed-rows 0}}, ["apparatus/the-system-stops-on-schedule" 10] {:id ["apparatus/the-system-stops-on-schedule" 10], :pattern-id "apparatus/the-system-stops-on-schedule", :occurrence-id ["apparatus/the-system-stops-on-schedule" 10], :target "M-futonzero-prelim-practice", :guard {:status :interpreted, :clauses [{:present #{["M-futonzero-prelim-practice" :pattern-done ["inbox-zero/promote-at-turn-end" 9]]}, :absent #{}}]}, :produces #{["M-futonzero-prelim-practice" :pattern-done ["apparatus/the-system-stops-on-schedule" 10]]}, :theta 1/2, :theta-record {:status :no-recorded-trials, :unattributed-rows 0}}, ["problems/process-conduct-is-unassured" 8] {:id ["problems/process-conduct-is-unassured" 8], :pattern-id "problems/process-conduct-is-unassured", :occurrence-id ["problems/process-conduct-is-unassured" 8], :target "M-futonzero-prelim-practice", :guard {:status :interpreted, :clauses [{:present #{["M-futonzero-prelim-practice" :pattern-done ["problems/r10-scheduled-entrypoint" 6]]}, :absent #{}}]}, :produces #{["M-futonzero-prelim-practice" :pattern-done ["problems/process-conduct-is-unassured" 8]]}, :theta 1/2, :theta-record {:status :no-recorded-trials, :unattributed-rows 0}}}}}, :policy-key-carrier {:status :canonical, :policy-key [:wm/reading-policy-v1 "M-futonzero-prelim-practice" "M-futonzero-prelim-practice/policy-87eb5c880a0b9ab8e194" {:nodes [[["cascade-construction/read-what-exists-first" 0] "cascade-construction/read-what-exists-first"] [["apparatus/