war-machine" :pattern-done ["agent/eat-your-own-tail" 3]] ["M-formal-war-machine" :pattern-done ["agent/scope-before-action" 2]] ["M-formal-war-machine" :pattern-done ["agency/self-attribution" 1]]}, :class-preference {1 #:ending{:not-yet-evaluated 1}, 2 #:ending{:not-yet-evaluated 1}, 3 #:ending{:not-yet-evaluated 1}, 4 {:focused 11/20, :related 7/20, :unrelated 1/20, :stop-the-line 1/20}}, :backend :exact-enumeration}}, :c-source {:source :terminal-class-preference}}}, :horizon-steps 4, :G-cascade 1.4755819764649951, :canonical-cascade {:schema :wm/executable-cascade-v1, :census-digest "5e19017a2f5dd89efa7d23fa882794520f3e6ce03a0793f3b88cb142125acfba", :relations {:application-order [], :guards []}, :structural-digest "405ec7331a0555ce0b59f67482755fc1d5bb28cde2fbd6dbf49e4dedaacdd8d4", :co-application-groups [], :digest "7c9601fd5fa56f7f7774d41cbc58a9b5b3bcc1d977115ab55a11c5c45986ceec", :structural {:reading-order-edges [{:from ["agent/intent-handshake-is-binding" 0], :to ["agency/self-attribution" 1], :kind :reading-order, :relation :goal-precedes, :role nil} {:from ["agency/self-attribution" 1], :to ["agent/scope-before-action" 2], :kind :reading-order, :relation :justified-by, :role nil} {:from ["agent/scope-before-action" 2], :to ["agent/eat-your-own-tail" 3], :kind :reading-order, :relation :condition-enables, :role nil}], :schema :wm/structural-cascade-v1, :policy-id "M-formal-war-machine/policy-95a29538723f94edfa51", :reading-order [["agent/intent-handshake-is-binding" 0] ["agency/self-attribution" 1] ["agent/scope-before-action" 2] ["agent/eat-your-own-tail" 3]], :construction-order [["agent/intent-handshake-is-binding" 0] ["agency/self-attribution" 1] ["agent/scope-before-action" 2] ["agent/eat-your-own-tail" 3]], :digest "405ec7331a0555ce0b59f67482755fc1d5bb28cde2fbd6dbf49e4dedaacdd8d4", :authored-additions [], :alternatives [], :shared-name-candidates [], :nodes [{:occurrence-id ["agent/intent-handshake-is-binding" 0], :pattern "agent/intent-handshake-is-binding", :roles ["goal"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-formal-war-machine/M-formal-war-machine/policy-95a29538723f94edfa51/[\"agent/intent-handshake-is-binding\" 0]", :span {:start 24, :end 67}, :source-text-digest "178c284ec2b789111f4fd2f0b8f52137f90e242fb3dd52e396c26df6d4142848", :analysis-digest "5b73f3901a5992827d5de02646d47e70995ba8ec14e3a8de9530e751b068fda3", :source-sha256 "fb5538c83b04d4150248cb150b6dbb7d087d7166b63dbe3d971387e1fcfc5e26", :square-digest "921c0de7b37e99a1a0a0d251a7daf04cd48b9f7b6d72439c46fc0689da73ad80"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/intent-handshake-is-binding", :objects {:G {:text "    Binding intent makes the run auditable and prevents silent goal drift.\n\n    + evidence: Fulab HUD prompts require an intent restatement (`src/futon3/fulab/hud.clj`), and `fuclaude --intent` passes intent into the HUD.\n", :source {:path "futon3/library/agent/intent-handshake-is-binding.flexiarg", :sha256 "fb5538c83b04d4150248cb150b6dbb7d087d7166b63dbe3d971387e1fcfc5e26"}, :situation-source "Pattern part BECAUSE of agent/intent-handshake-is-binding (binding intent makes the run auditable and prevents silent goal drift).", :theory {:elems #{:g}, :names {:g "A binding contract makes the loop's runs auditable and prevents silent goal drift."}, :axioms #{}}}, :I1 {:text "    The system needs a reliable record of what the agent believes it is doing.\n", :source {:path "futon3/library/agent/intent-handshake-is-binding.flexiarg", :sha256 "fb5538c83b04d4150248cb150b6dbb7d087d7166b63dbe3d971387e1fcfc5e26"}, :situation-source "The mission's title-level deliverable is 'a behavioural contract for the control loop' (fragment at offsets 24–67).", :theory {:elems #{:i1}, :names {:i1 "The mission needs a reliable record of what the control loop is supposed to do."}, :axioms #{}}}, :I2 {:text "    If intent only lives in the prompt or UI, it drifts: agents reinterpret mid-run without explicit renegotiation.\n", :source {:path "futon3/library/agent/intent-handshake-is-binding.flexiarg", :sha256 "fb5538c83b04d4150248cb150b6dbb7d087d7166b63dbe3d971387e1fcfc5e26"}, :situation-source "The mission chooses a written behavioural contract as its artifact rather than relying on the 2026-08-25 chartering conversation (status line, offsets 68–126).", :theory {:elems #{:i2}, :names {:i2 "If the loop's intent lived only in prose or conversation, agents operating the loop could reinterpret it mid-run without renegotiation."}, :axioms #{}}}, :B {:text "    Require a handshake that echoes intent, scope, constraints, and success criteria, and record an acknowledgment. Changes to intent or scope require an explicit renegotiation event before further actions.\n", :source {:path "futon3/library/agent/intent-handshake-is-binding.flexiarg", :sha256 "fb5538c83b04d4150248cb150b6dbb7d087d7166b63dbe3d971387e1fcfc5e26"}, :situation-source "The fragment names the contract as the mission's stated goal with relations ['goal'].", :theory {:elems #{:b}, :names {:b "The mission commits to authoring a behavioural contract stating the loop's obligations and success criteria."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agency/self-attribution" 1], :pattern "agency/self-attribution", :roles ["context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-formal-war-machine/M-formal-war-machine/policy-95a29538723f94edfa51/[\"agency/self-attribution\" 1]", :span {:start 88, :end 126}, :source-text-digest "178c284ec2b789111f4fd2f0b8f52137f90e242fb3dd52e396c26df6d4142848", :analysis-digest "5b73f3901a5992827d5de02646d47e70995ba8ec14e3a8de9530e751b068fda3", :source-sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f", :square-digest "8a33124eb11caa64a2d393da6fe8b1e0a57972e8d8749bc7b077044a058c72f2"}, :square {:schema :wm/three-halves-square-v1, :pattern "agency/self-attribution", :objects {:G {:text "    Proxy posting breaks the audit trail. When output appears under agent X's identity but was posted by the server, you cannot distinguish between \"X said this\" and \"the server said X said this.\" In incident review, this ambiguity makes root cause analysis unreliable. A meeting transcript where one person takes notes for everyone is not the same as each person signing their own statement.\n\n    + EVIDENCE (repo history):\n      - 2026-02-08 169c4bc: /agency/standup initially implemented as \"whistle all agents and collect responses\", putting the server in the position to relay agent content as an intermediary.\n      - 2026-02-08 9acf154: standup redesign explicitly rejects the prior proxy approach as an identity violation and moves to \"agent self-reporting\": each agent acks, invokes itself, and posts to MUSN under its own identity.\n      - 2026-01-31 b2fbb84: mission notes define the first principle that Agency is a continuity layer, not \"the agent itself\", which aligns with self-attribution (coordination vs content authorship).\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "Pattern part BECAUSE of agency/self-attribution (attribution ambiguity makes root cause analysis unreliable).", :theory {:elems #{:g}, :names {:g "Explicit attribution keeps the audit trail: 'Joe and claude-13 chartered this' stays distinguishable from 'the document says so'."}, :axioms #{}}}, :I1 {:text "    You need an agent's output to appear in a shared channel (IRC, MUSN, forum).\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "The charter is recorded in the mission file's opening status line, visible to all readers.", :theory {:elems #{:i1}, :names {:i1 "The mission's charter must appear in the shared mission record under a clear author."}, :axioms #{}}}, :I2 {:text "    The server has access to agent identities and could post on their behalf, making the code simpler. But this creates false attribution: the message appears to come from the agent, but the agent never authored or approved it. If the agent's invocation returned an error, the server might post the error as if the agent said it. If the server's MUSN post fails, the agent has no way to know its update was lost.\n\n    + ANTI-PATTERNS:\n      - Server collects whistle responses and POSTs to MUSN as each agent\n      - Server registers a context-free subprocess under an existing agent's identity\n      - Server reformats or summarizes agent output before posting it as the agent\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "The fragment defuses this by naming both principals: 'CHARTERED 2026-08-25 (Joe + claude-13)' (offsets 88–126).", :theory {:elems #{:i2}, :names {:i2 "An unattributed or ambiguous charter would blur who actually chartered the mission and under whose authority it runs."}, :axioms #{}}}, :B {:text "    The server's role is coordination, not content relay:\n    1. The server creates the rendezvous, sends the bell, tracks acks.\n    2. Each agent independently generates its output and posts it under its own identity.\n    3. The server may post as \"agency\" (its own identity) for announcements.\n    4. If an agent cannot post (no MUSN access, transport failure), the failure is attributed to the agent, not hidden by the server.\n    This applies to all output channels: MUSN, forum, IRC, CRDT documents.\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "The fragment itself: 'CHARTERED 2026-08-25 (Joe + claude-13)'.", :theory {:elems #{:b}, :names {:b "The mission records its chartering authors and date explicitly in the opening line."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/scope-before-action" 2], :pattern "agent/scope-before-action", :roles ["rationale" "condition"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-formal-war-machine/M-formal-war-machine/policy-95a29538723f94edfa51/[\"agent/scope-before-action\" 2]", :span {:start 148, :end 164}, :source-text-digest "178c284ec2b789111f4fd2f0b8f52137f90e242fb3dd52e396c26df6d4142848", :analysis-digest "5b73f3901a5992827d5de02646d47e70995ba8ec14e3a8de9530e751b068fda3", :source-sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea", :square-digest "4f2042cd79555dced91c3146e27d85c4a236c15bbc458080b809d9ad1c394131"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/scope-before-action", :objects {:G {:text "    Declared scope makes progress measurable, side effects auditable, and completion definable. It also protects the broader system from unintended changes.\n\n    + evidence: Fulab HUD prompts require a pre-action plan (`src/futon3/fulab/hud.clj`), and scope boundaries are spelled out in `CLAUDE.md`.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "Pattern part BECAUSE of agent/scope-before-action (declared scope makes progress measurable, side effects auditable, completion definable).", :theory {:elems #{:g}, :names {:g "Declaring the gap crisp makes the mission's starting scope measurable and its entry decision auditable."}, :axioms #{}}}, :I1 {:text "    The agent needs to make progress that can be verified and bounded.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "The status line picks an explicit entry phase: 'Begins at IDENTIFY' (offsets 127–147 of the sentence).", :theory {:elems #{:i1}, :names {:i1 "The mission needs progress that can be verified and bounded, starting from a defined entry point."}, :axioms #{}}}, :I2 {:text "    Without declared scope, \"done\" is undefined, side effects are unpredictable, and observers cannot tell if the agent is on track or wandering.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "The fragment 'the gap is crisp' (offsets 148–164) is given as the justification for the chosen entry.", :theory {:elems #{:i2}, :names {:i2 "Without a crisp statement of the gap, the entry point would be arbitrary and observers could not tell whether the mission starts on track."}, :axioms #{}}}, :B {:text "    Before substantive action, state the scope: what files, concepts, or regions are in-bounds; what is explicitly out-of-bounds; what the exit condition is. Treat scope violations as requiring explicit expansion, not silent drift. Scope defines the territory; budgets and pauses govern what happens inside it.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "The fragment's relations ['rationale','condition'] capture it serving as the stated precondition for skipping HEAD.", :theory {:elems #{:b}, :names {:b "The mission states its scoping condition — a crisp gap — before substantive work begins."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/eat-your-own-tail" 3], :pattern "agent/eat-your-own-tail", :roles ["dependency" "condition"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-formal-war-machine/M-formal-war-machine/policy-95a29538723f94edfa51/[\"agent/eat-your-own-tail\" 3]", :span {:start 169, :end 226}, :source-text-digest "178c284ec2b789111f4fd2f0b8f52137f90e242fb3dd52e396c26df6d4142848", :analysis-digest "5b73f3901a5992827d5de02646d47e70995ba8ec14e3a8de9530e751b068fda3", :source-sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8", :square-digest "698b641e7347a4ea895d4f0232699f650457154bd5d9d374e93813a0e18622ad"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/eat-your-own-tail", :objects {:G {:text "    Warm execution state contains causal information that final artifacts discard. Feeding that state into the agent's next move shortens the interval between failure, diagnosis, and structural repair. Preserving the observation path makes each incident increase the system's ability to reveal itself, so later runs need less operator archaeology.\n\n    + EXAMPLE:\n      Inbox zero emitted a Reazon warning into the operator's Emacs buffer. Joe summoned the responsible agent; the warning led first to the behind-repository defect, then to the dirty-file fast-forward rule, and finally to explicit commit-or-ignore dispositions for generated output. The notifier remained installed after the repair.\n\n    + EXAMPLE:\n      Codex-10 was induced to run the target code under a debugger and debug the executing program, rather than reason only from source and post-run output.\n\n    + EXAMPLE:\n      Codex-11 attached to a remote data-mining process's logs and improved the code while mining continued, rather than waiting for the final dataset before learning from the run.\n\n    + EXAMPLE:\n      Claude-4 constructed a queryable progress measure with a ratchet, so the live process can report its present position and cannot silently present a regressed state as progress.\n\n    + COUNTERFACTUAL:\n      A dashboard nobody reads, logs inspected only after completion, a debugger attached without changing an intervention, or a progress number that may freely decrease does not eat the tail. The loop closes only when live self-observation changes action and leaves a stronger observation path behind.\n\n    + evidence:\n      Operator synthesis, Joe, 2026-10-02, names the four cases above and explicitly cautions that the pattern is not guaranteed to succeed. Inbox-zero has repository witnesses: Futon3c commits `66bb1664` (Reazon notifier), `83b9f463` (dirty-but-disjoint fast-forward), `631561f5` and `ef1a3666` (generated-artifact disposition), followed by sweeper-authored projection commits `4007d7aa` in Futon6 and `751b9b12` in Futon3c.\n", :source {:path "futon3/library/agent/eat-your-own-tail.flexiarg", :sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8"}, :situation-source "Pattern part BECAUSE of agent/eat-your-own-tail (feeding live state into the next move shortens the failure–diagnosis–repair interval and preserves the observation path).", :theory {:elems #{:g}, :names {:g "Applying the mission lifecycle rule to the mission that owns that rule routes live observation into the next action and leaves the rule strengthened by use."}, :axioms #{}}}, :I1 {:text "    The agent can observe the process while it runs and can change either the running intervention or the machinery used on subsequent runs.\n", :source {:path "futon3/library/agent/eat-your-own-tail.flexiarg", :sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8"}, :situation-source "The status line cites the lifecycle rule directly: 'per `futon4/holes/mission-lifecycle.md`' (within offsets 169–226).", :theory {:elems #{:i1}, :names {:i1 "The mission can observe and follow the mission-lifecycle machinery while chartering itself."}, :axioms #{}}}, :I2 {:text "    The usual workflow puts the agent outside the process: wait for completion, inspect a summary, repair the visible result, and declare success. This delays learning until state has gone cold and produces one-off rescues whose evidence never reaches the mechanism that failed. The first useful attempt may still be inefficient; the pattern begins when that failure is routed back into the live apparatus rather than merely remembered.\n", :source {:path "futon3/library/agent/eat-your-own-tail.flexiarg", :sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8"}, :situation-source "The fragment records an explicit deviation — '`HEAD` is skipped' — rather than defaulting to the routine form.", :theory {:elems #{:i2}, :names {:i2 "The usual workflow would write a HEAD section by habit, delaying the question of whether the machinery already covers this case."}, :axioms #{}}}, :B {:text "    Eat the tail in four moves:\n\n    1. Name the process's native live surface: notification, debugger, log stream, progress projection, trace, or invariant trip.\n    2. Attach the responsible agent to that surface before the run ends.\n    3. Let observations from the live run change the next action: patch, probe, reclassify, resume, or stop.\n    4. Preserve the attachment as machinery for the next run, preferably with a ratchet that records the best established state and makes backsliding visible.\n\n    The tail is an observation channel, not a certificate. Keep outcome judgment independent where success could be self-manufactured; use the system's own signals to find and steer the repair, not to waive its acceptance gate.\n", :source {:path "futon3/library/agent/eat-your-own-tail.flexiarg", :sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8"}, :situation-source "The full fragment: '`HEAD` is skipped per `futon4/holes/mission-lifecycle.md`', with relations ['dependency','condition'].", :theory {:elems #{:b}, :names {:b "The mission lets its own lifecycle state (crisp gap at IDENTIFY) change its documentation action: skip HEAD, citing the rule."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}}], :receipts {:construction {:policy-id "M-formal-war-machine/policy-95a29538723f94edfa51", :policy-key [:wm/reading-policy-v1 "M-formal-war-machine" "M-formal-war-machine/policy-95a29538723f94edfa51" {:nodes [[["agent/intent-handshake-is-binding" 0] "agent/intent-handshake-is-binding"] [["agency/self-attribution" 1] "agency/self-attribution"] [["agent/scope-before-action" 2] "agent/scope-before-action"] [["agent/eat-your-own-tail" 3] "agent/eat-your-own-tail"]], :edges [[["agency/self-attribution" 1] ["agent/scope-before-action" 2] :justified-by] [["agent/intent-handshake-is-binding" 0] ["agency/self-attribution" 1] :goal-precedes] [["agent/scope-before-action" 2] ["agent/eat-your-own-tail" 3] :condition-enables]], :order [["agent/intent-handshake-is-binding" 0] ["agency/self-attribution" 1] ["agent/scope-before-action" 2] ["agent/eat-your-own-tail" 3]]}]}, :scoring {:scorer-version nil, :g-terms nil}, :selection {:stage :pre-selector-binding}}, :target "M-formal-war-machine", :gluing [], :census {:open [["agent/intent-handshake-is-binding" 0] ["agency/self-attribution" 1] ["agent/scope-before-action" 2] ["agent/eat-your-own-tail" 3]], :void [], :unread [], :census-digest "5e19017a2f5dd89efa7d23fa882794520f3e6ce03a0793f3b88cb142125acfba"}}, :executable-nodes [{:occurrence-id ["agent/intent-handshake-is-binding" 0], :pattern "agent/intent-handshake-is-binding", :roles ["goal"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-formal-war-machine/M-formal-war-machine/policy-95a29538723f94edfa51/[\"agent/intent-handshake-is-binding\" 0]", :span {:start 24, :end 67}, :source-text-digest "178c284ec2b789111f4fd2f0b8f52137f90e242fb3dd52e396c26df6d4142848", :analysis-digest "5b73f3901a5992827d5de02646d47e70995ba8ec14e3a8de9530e751b068fda3", :source-sha256 "fb5538c83b04d4150248cb150b6dbb7d087d7166b63dbe3d971387e1fcfc5e26", :square-digest "921c0de7b37e99a1a0a0d251a7daf04cd48b9f7b6d72439c46fc0689da73ad80"}, :enactment-status :open-hole, :hole {:owner :wm/enactment-compiler, :question :ope