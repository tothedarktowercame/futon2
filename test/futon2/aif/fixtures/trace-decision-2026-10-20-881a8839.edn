solve-pointers-at-head", :objects {:G {:text "    A certificate about code that exists only in one working tree certifies nothing another agent can use.\n", :source {:path "futon3/library/contracts/resolve-pointers-at-head.flexiarg", :sha256 "3d82a70a2c754b0608368731de96553a266dc01c94712ad0efe4cf7b0d2ecea7"}, :situation-source "Pattern HEAD-resolution rule applied to the mission's operational-binding goal.", :theory {:elems #{:g}, :names {:g "Evaluate a cascade by whether its recommendation bindings resolve to committed, inspectable operational artifacts that another agent can use."}, :axioms #{}}}, :I1 {:text "    A contract bundle is emitted or verified.\n", :source {:path "futon3/library/contracts/resolve-pointers-at-head.flexiarg", :sha256 "3d82a70a2c754b0608368731de96553a266dc01c94712ad0efe4cf7b0d2ecea7"}, :situation-source "contracts/resolve-pointers-at-head IF/THEN contract-bundle rule.", :theory {:elems #{:i1}, :names {:i1 "Contract claims must resolve named forms from committed HEAD state."}, :axioms #{}}}, :I2 {:text "    Working trees hold other owners' in-progress edits.\n", :source {:path "futon3/library/contracts/resolve-pointers-at-head.flexiarg", :sha256 "3d82a70a2c754b0608368731de96553a266dc01c94712ad0efe4cf7b0d2ecea7"}, :situation-source "M-recommendation-bindings title fragment.", :theory {:elems #{:i2}, :names {:i2 "Recommendation Bindings must connect the War Machine's selected next move to operational surfaces."}, :axioms #{}}}, :B {:text "    Read both sides at HEAD and check named forms.\n", :source {:path "futon3/library/contracts/resolve-pointers-at-head.flexiarg", :sha256 "3d82a70a2c754b0608368731de96553a266dc01c94712ad0efe4cf7b0d2ecea7"}, :situation-source "Combined pattern rule and mission title.", :theory {:elems #{:b}, :names {:b "A usable next-move record whose operational targets resolve at HEAD."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["futon-theory/mission-lifecycle" 1], :pattern "futon-theory/mission-lifecycle", :roles ["context" "condition"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-recommendation-bindings/M-recommendation-bindings/policy-7e8a0806fea29fa47914/[\"futon-theory/mission-lifecycle\" 1]", :span {:start 121, :end 159}, :source-text-digest "e8678feb63133e7a13d5d3ed7a2722c430f8ff80f2355b6f98a4d09dd01fe941", :analysis-digest "54558739922fa7db94f035fc7573d430033fbee7e87acce089da6b5f4ed38441", :source-sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001", :square-digest "28c040743eeb30b0333b7bfb62c0779c3b1a78dd973b5d2dbf661ca0e6f51b29"}, :square {:schema :wm/three-halves-square-v1, :pattern "futon-theory/mission-lifecycle", :objects {:G {:text "    - Explicit states prevent invisible drift\n    - Transition requirements create evidence trail\n    - Blocked states surface dependency graphs\n    - Review gates ensure verification before closure\n", :source {:path "futon3/library/futon-theory/mission-lifecycle.flexiarg", :sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001"}, :situation-source "Mission lifecycle transition discipline applied to the recorded DERIVE state.", :theory {:elems #{:g}, :names {:g "Evaluate a cascade by whether it advances the complete mission from DERIVE only when its binding decisions and transition evidence are recorded."}, :axioms #{}}}, :I1 {:text "    You are defining, tracking, or transitioning a mission.\n", :source {:path "futon3/library/futon-theory/mission-lifecycle.flexiarg", :sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001"}, :situation-source "futon-theory/mission-lifecycle THEN state machine and transition requirements.", :theory {:elems #{:i1}, :names {:i1 "Mission progress is represented by explicit states with evidence requirements for transitions."}, :axioms #{}}}, :I2 {:text "    Missions may be blocked by dependencies, split into sub-missions,\n    or merged when scope overlaps. The lifecycle must accommodate these.\n", :source {:path "futon3/library/futon-theory/mission-lifecycle.flexiarg", :sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001"}, :situation-source "M-recommendation-bindings status fragment.", :theory {:elems #{:i2}, :names {:i2 "Recommendation Bindings is open in DERIVE."}, :axioms #{}}}, :B {:text "    Apply the mission state machine:\n\n    ```\n    :greenfield → :scoped → :active → :blocked → :review → :done\n                     ↑          ↓         ↓\n                     └──────────┴─────────┘ (can regress)\n    ```\n\n    State definitions:\n    - :greenfield - Idea captured, no work plan\n    - :scoped - Success criteria, boundaries, dependencies defined\n    - :active - Work in progress, owner assigned\n    - :blocked - Waiting on dependency (cite blocker)\n    - :review - Work complete, awaiting verification\n    - :done - Success criteria met, evidence recorded\n\n    Transition requirements:\n    - greenfield → scoped: Mission doc has success criteria + scope\n    - scoped → active: Owner assigned, dependencies clear\n    - active → blocked: Blocker cited with link to blocking mission\n    - active → review: All success criteria addressed\n    - review → done: Evidence verified by reviewer\n    - Any → :abandoned: Explicit decision with rationale\n", :source {:path "futon3/library/futon-theory/mission-lifecycle.flexiarg", :sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001"}, :situation-source "Combined lifecycle pattern and mission status.", :theory {:elems #{:b}, :names {:b "An auditable DERIVE-stage mission whose next transition depends on recorded binding evidence."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/handoff-preserves-context" 2], :pattern "agent/handoff-preserves-context", :roles ["context" "dependency"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-recommendation-bindings/M-recommendation-bindings/policy-7e8a0806fea29fa47914/[\"agent/handoff-preserves-context\" 2]", :span {:start 160, :end 225}, :source-text-digest "e8678feb63133e7a13d5d3ed7a2722c430f8ff80f2355b6f98a4d09dd01fe941", :analysis-digest "54558739922fa7db94f035fc7573d430033fbee7e87acce089da6b5f4ed38441", :source-sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3", :square-digest "c9775f00d451cc052caa5d8d2db0b9d0760e9fb097b35cfa27f90ad1b6a950b2"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/handoff-preserves-context", :objects {:G {:text "    Handoffs convert ephemeral session state into persistent project state. They enable distributed and asynchronous work without context collapse.\n\n    + evidence: Fulab exports session context to `lab/raw`, `lab/stubs`, and `lab/trace` (`dev/lab-export-claude.clj`), plus summaries via `fulab-summary` and `fulab-session-report`.\n", :source {:path "futon3/library/agent/handoff-preserves-context.flexiarg", :sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3"}, :situation-source "Pattern handoff requirements applied to the named conversation provenance.", :theory {:elems #{:g}, :names {:g "Evaluate a cascade by whether it preserves the War Bulletin context through binding decisions, evidence anchors, and follow-on actions."}, :axioms #{}}}, :I1 {:text "    Continuity matters: the work is incremental, context is expensive to rebuild, or progress would be lost.\n", :source {:path "futon3/library/agent/handoff-preserves-context.flexiarg", :sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3"}, :situation-source "agent/handoff-preserves-context IF/THEN handoff contract.", :theory {:elems #{:i1}, :names {:i1 "Incremental work requires a durable handoff containing decisions, boundaries, next actions, and evidence anchors."}, :axioms #{}}}, :I2 {:text "    Without explicit handoff, successors face cold starts: they repeat discoveries, miss constraints, or contradict prior decisions.\n", :source {:path "futon3/library/agent/handoff-preserves-context.flexiarg", :sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3"}, :situation-source "M-recommendation-bindings owner fragment.", :theory {:elems #{:i2}, :names {:i2 "Joe and an agent own this mission after a War Bulletin 8 conversation handoff."}, :axioms #{}}}, :B {:text "    Define a handoff record that captures: current state hypothesis, decisions made and why, open questions, scope boundaries, next actions, evidence/trail anchors, and any provisional-claim ledger. Emit it at session end or when transferring to another agent.\n", :source {:path "futon3/library/agent/handoff-preserves-context.flexiarg", :sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3"}, :situation-source "Combined handoff pattern and owner field.", :theory {:elems #{:b}, :names {:b "A recommendation-binding mission that successors can continue without reconstructing the originating conversation."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/evidence-over-assertion" 3], :pattern "agent/evidence-over-assertion", :roles ["dependency" "context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-recommendation-bindings/M-recommendation-bindings/policy-7e8a0806fea29fa47914/[\"agent/evidence-over-assertion\" 3]", :span {:start 242, :end 319}, :source-text-digest "e8678feb63133e7a13d5d3ed7a2722c430f8ff80f2355b6f98a4d09dd01fe941", :analysis-digest "54558739922fa7db94f035fc7573d430033fbee7e87acce089da6b5f4ed38441", :source-sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248", :square-digest "bb6eec099f82881e44b1c51b8d079287679af839303eace15323614a20368b22"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/evidence-over-assertion", :objects {:G {:text "    Evidence transforms agent output from \"trust me\" to \"check this.\" It enables verification, correction, and cumulative trust-building.\n\n    + evidence: Fulab PUR/PSR templates require anchors/certificates (`src/futon3/fulab/pattern_competence.clj`), and claim verification is enforced via `fulab-pattern-claim` + `fulab-pattern-check`.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "Pattern evidence rule applied to the upstream-work reference.", :theory {:elems #{:g}, :names {:g "Evaluate a cascade by whether its account of the upstream recommendation cites and remains checkable against War Bulletin 8."}, :axioms #{}}}, :I1 {:text "    The agent's outputs need to be verifiable by other agents, humans, or future selves.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "agent/evidence-over-assertion THEN evidence requirement.", :theory {:elems #{:i1}, :names {:i1 "Substantive claims require concrete evidence anchors and explicit verification paths."}, :axioms #{}}}, :I2 {:text "    Assertions without anchors are indistinguishable from confabulation. Observers cannot tell if the agent is reporting reality or generating plausible-sounding noise.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "M-recommendation-bindings War Bulletin cross-reference.", :theory {:elems #{:i2}, :names {:i2 "War Bulletin 8 is the upstream artifact this mission grounds."}, :axioms #{}}}, :B {:text "    Require every substantive claim to point to evidence: a file path, a trace event, a test result, a quotation. If evidence is unavailable, emit the claim as provisional with an expiry and a verification path. Make \"unsupported claim\" a detectable violation, not just a style preference.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "Combined evidence pattern and War Bulletin reference.", :theory {:elems #{:b}, :names {:b "A grounded recommendation whose origin can be inspected in the named bulletin."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/evidence-over-assertion" 4], :pattern "agent/evidence-over-assertion", :roles ["dependency" "rationale"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-recommendation-bindings/M-recommendation-bindings/policy-7e8a0806fea29fa47914/[\"agent/evidence-over-assertion\" 4]", :span {:start 320, :end 407}, :source-text-digest "e8678feb63133e7a13d5d3ed7a2722c430f8ff80f2355b6f98a4d09dd01fe941", :analysis-digest "54558739922fa7db94f035fc7573d430033fbee7e87acce089da6b5f4ed38441", :source-sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248", :square-digest "44bce2e0c22f1117d87bfa80bd38c5191499d33287d2db34266397f4a1921a7a"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/evidence-over-assertion", :objects {:G {:text "    Evidence transforms agent output from \"trust me\" to \"check this.\" It enables verification, correction, and cumulative trust-building.\n\n    + evidence: Fulab PUR/PSR templates require anchors/certificates (`src/futon3/fulab/pattern_competence.clj`), and claim verification is enforced via `fulab-pattern-claim` + `fulab-pattern-check`.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "Pattern verification requirement applied to the cited War Room sections.", :theory {:elems #{:g}, :names