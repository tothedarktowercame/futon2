 "futon-theory/mission-lifecycle", :objects {:G {:text "    - Explicit states prevent invisible drift\n    - Transition requirements create evidence trail\n    - Blocked states surface dependency graphs\n    - Review gates ensure verification before closure\n", :source {:path "futon3/library/futon-theory/mission-lifecycle.flexiarg", :sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001"}, :situation-source "Lifecycle BECAUSE rationale and the mission’s explicit status.", :theory {:elems #{:g}, :names {:g "A named current state prevents progress or closure from being inferred without evidence."}, :axioms #{}}}, :I1 {:text "    You are defining, tracking, or transitioning a mission.\n", :source {:path "futon3/library/futon-theory/mission-lifecycle.flexiarg", :sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001"}, :situation-source "futon-theory/mission-lifecycle IF/THEN state definitions and transition requirements.", :theory {:elems #{:i1}, :names {:i1 "A mission advances through explicit states backed by transition evidence."}, :axioms #{}}}, :I2 {:text "    Missions may be blocked by dependencies, split into sub-missions,\n    or merged when scope overlaps. The lifecycle must accommodate these.\n", :source {:path "futon3/library/futon-theory/mission-lifecycle.flexiarg", :sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001"}, :situation-source "M-pattern-posteriors opening status “OPEN — IDENTIFY”.", :theory {:elems #{:i2}, :names {:i2 "M-pattern-posteriors is explicitly open in its identification stage."}, :axioms #{}}}, :B {:text "    Apply the mission state machine:\n\n    ```\n    :greenfield → :scoped → :active → :blocked → :review → :done\n                     ↑          ↓         ↓\n                     └──────────┴─────────┘ (can regress)\n    ```\n\n    State definitions:\n    - :greenfield - Idea captured, no work plan\n    - :scoped - Success criteria, boundaries, dependencies defined\n    - :active - Work in progress, owner assigned\n    - :blocked - Waiting on dependency (cite blocker)\n    - :review - Work complete, awaiting verification\n    - :done - Success criteria met, evidence recorded\n\n    Transition requirements:\n    - greenfield → scoped: Mission doc has success criteria + scope\n    - scoped → active: Owner assigned, dependencies clear\n    - active → blocked: Blocker cited with link to blocking mission\n    - active → review: All success criteria addressed\n    - review → done: Evidence verified by reviewer\n    - Any → :abandoned: Explicit decision with rationale\n", :source {:path "futon3/library/futon-theory/mission-lifecycle.flexiarg", :sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001"}, :situation-source "Lifecycle transition requirements applied to the recorded OPEN — IDENTIFY state.", :theory {:elems #{:b}, :names {:b "Retain M-pattern-posteriors in IDENTIFY until its scope, dependencies, and success criteria justify a later transition."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}}], :receipts {:construction {:policy-id "M-pattern-posteriors/policy-2f5c7f6d3345d326aae3", :policy-key [:wm/reading-policy-v1 "M-pattern-posteriors" "M-pattern-posteriors/policy-2f5c7f6d3345d326aae3" {:nodes [[["futon-theory/mission-lifecycle" 0] "futon-theory/mission-lifecycle"]], :edges [], :order [["futon-theory/mission-lifecycle" 0]]}]}, :scoring {:scorer-version nil, :g-terms nil}, :selection {:stage :pre-selector-binding}}, :target "M-pattern-posteriors", :gluing [], :census {:open [["futon-theory/mission-lifecycle" 0]], :void [], :unread [], :census-digest "ee00677583ae63064e3a9c85d84b176c6c8d1ec4418123806d7e5c5c00d55e6f"}}, :executable-nodes [{:occurrence-id ["futon-theory/mission-lifecycle" 0], :pattern "futon-theory/mission-lifecycle", :roles ["context" "condition"], :fragment-indices [], :origin :selected, :provenance {:reading-record-i