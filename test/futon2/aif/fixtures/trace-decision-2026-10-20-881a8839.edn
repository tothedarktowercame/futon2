d6dbf49e4dedaacdd8d4", :co-application-groups [], :digest "7c9601fd5fa56f7f7774d41cbc58a9b5b3bcc1d977115ab55a11c5c45986ceec", :structural {:reading-order-edges [{:from ["agent/intent-handshake-is-binding" 0], :to ["agency/self-attribution" 1], :kind :reading-order, :relation :goal-precedes, :role nil} {:from ["agency/self-attribution" 1], :to ["agent/scope-before-action" 2], :kind :reading-order, :relation :justified-by, :role nil} {:from ["agent/scope-before-action" 2], :to ["agent/eat-your-own-tail" 3], :kind :reading-order, :relation :condition-enables, :role nil}], :schema :wm/structural-cascade-v1, :policy-id "M-formal-war-machine/policy-95a29538723f94edfa51", :reading-order [["agent/intent-handshake-is-binding" 0] ["agency/self-attribution" 1] ["agent/scope-before-action" 2] ["agent/eat-your-own-tail" 3]], :construction-order [["agent/intent-handshake-is-binding" 0] ["agency/self-attribution" 1] ["agent/scope-before-action" 2] ["agent/eat-your-own-tail" 3]], :digest "405ec7331a0555ce0b59f67482755fc1d5bb28cde2fbd6dbf49e4dedaacdd8d4", :authored-additions [], :alternatives [], :shared-name-candidates [], :nodes [{:occurrence-id ["agent/intent-handshake-is-binding" 0], :pattern "agent/intent-handshake-is-binding", :roles ["goal"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-formal-war-machine/M-formal-war-machine/policy-95a29538723f94edfa51/[\"agent/intent-handshake-is-binding\" 0]", :span {:start 24, :end 67}, :source-text-digest "178c284ec2b789111f4fd2f0b8f52137f90e242fb3dd52e396c26df6d4142848", :analysis-digest "5b73f3901a5992827d5de02646d47e70995ba8ec14e3a8de9530e751b068fda3", :source-sha256 "fb5538c83b04d4150248cb150b6dbb7d087d7166b63dbe3d971387e1fcfc5e26", :square-digest "921c0de7b37e99a1a0a0d251a7daf04cd48b9f7b6d72439c46fc0689da73ad80"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/intent-handshake-is-binding", :objects {:G {:text "    Binding intent makes the run auditable and prevents silent goal drift.\n\n    + evidence: Fulab HUD prompts require an intent restatement (`src/futon3/fulab/hud.clj`), and `fuclaude --intent` passes intent into the HUD.\n", :source {:path "futon3/library/agent/intent-handshake-is-binding.flexiarg", :sha256 "fb5538c83b04d4150248cb150b6dbb7d087d7166b63dbe3d971387e1fcfc5e26"}, :situation-source "Pattern part BECAUSE of agent/intent-handshake-is-binding (binding intent makes the run auditable and prevents silent goal drift).", :theory {:elems #{:g}, :names {:g "A binding contract makes the loop's runs auditable and prevents silent goal drift."}, :axioms #{}}}, :I1 {:text "    The system needs a reliable record of what the agent believes it is doing.\n", :source {:path "futon3/library/agent/intent-handshake-is-binding.flexiarg", :sha256 "fb5538c83b04d4150248cb150b6dbb7d087d7166b63dbe3d971387e1fcfc5e26"}, :situation-source "The mission's title-level deliverable is 'a behavioural contract for the control loop' (fragment at offsets 24–67).", :theory {:elems #{:i1}, :names {:i1 "The mission needs a reliable record of what the control loop is supposed to do."}, :axioms #{}}}, :I2 {:text "    If intent only lives in the prompt or UI, it drifts: agents reinterpret mid-run without explicit renegotiation.\n", :source {:path "futon3/library/agent/intent-handshake-is-binding.flexiarg", :sha256 "fb5538c83b04d4150248cb150b6dbb7d087d7166b63dbe3d971387e1fcfc5e26"}, :situation-source "The mission chooses a written behavioural contract as its artifact rather than relying on the 2026-08-25 chartering conversation (status line, offsets 68–126).", :theory {:elems #{:i2}, :names {:i2 "If the loop's intent lived only in prose or conversation, agents operating the loop could reinterpret it mid-run without renegotiation."}, :axioms #{}}}, :B {:text "    Require a handshake that echoes intent, scope, constraints, and success criteria, and record an acknowledgment. Changes to intent or scope require an explicit renegotiation event before further actions.\n", :source {:path "futon3/library/agent/intent-handshake-is-binding.flexiarg", :sha256 "fb5538c83b04d4150248cb150b6dbb7d087d7166b63dbe3d971387e1fcfc5e26"}, :situation-source "The fragment names the contract as the mission's stated goal with relations ['goal'].", :theory {:elems #{:b}, :names {:b "The mission commits to authoring a behavioural contract stating the loop's obligations and success criteria."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agency/self-attribution" 1], :pattern "agency/self-attribution", :roles ["context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-formal-war-machine/M-formal-war-machine/policy-95a29538723f94edfa51/[\"agency/self-attribution\" 1]", :span {:start 88, :end 126}, :source-text-digest "178c284ec2b789111f4fd2f0b8f52137f90e242fb3dd52e396c26df6d4142848", :analysis-digest "5b73f3901a5992827d5de02646d47e70995ba8ec14e3a8de9530e751b068fda3", :source-sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f", :square-digest "8a33124eb11caa64a2d393da6fe8b1e0a57972e8d8749bc7b077044a058c72f2"}, :square {:schema :wm/three-halves-square-v1, :pattern "agency/self-attribution", :objects {:G {:text "    Proxy posting breaks the audit trail. When output appears under agent X's identity but was posted by the server, you cannot distinguish between \"X said this\" and \"the server said X said this.\" In incident review, this ambiguity makes root cause analysis unreliable. A meeting transcript where one person takes notes for everyone is not the same as each person signing their own statement.\n\n    + EVIDENCE (repo history):\n      - 2026-02-08 169c4bc: /agency/standup initially implemented as \"whistle all agents and collect responses\", putting the server in the position to relay agent content as an intermediary.\n      - 2026-02-08 9acf154: standup redesign explicitly rejects the prior proxy approach as an identity violation and moves to \"agent self-reporting\": each agent acks, invokes itself, and posts to MUSN under its own identity.\n      - 2026-01-31 b2fbb84: mission notes define the first principle that Agency is a continuity layer, not \"the agent itself\", which aligns with self-attribution (coordination vs content authorship).\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "Pattern part BECAUSE of agency/self-attribution (attribution ambiguity makes root cause analysis unreliable).", :theory {:elems #{:g}, :names {:g "Explicit attribution keeps the audit trail: 'Joe and claude-13 chartered this' stays distinguishable from 'the document says so'."}, :axioms #{}}}, :I1 {:text "    You need an agent's output to appear in a shared channel (IRC, MUSN, forum).\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "The charter is recorded in the mission file's opening status line, visible to all readers.", :theory {:elems #{:i1}, :names {:i1 "The mission's charter must appear in the shared mission record under a clear author."}, :axioms #{}}}, :I2 {:text "    The server has access to agent identities and could post on their behalf, making the code simpler. But this creates false attribution: the message appears to come from the agent, but the agent never authored or approved it. If the agent's invocation returned an error, the server might post the error as if the agent said it. If the server's MUSN post fails, the agent has no way to know its update was lost.\n\n    + ANTI-PATTERNS:\n      - Server collects whistle responses and POSTs to MUSN as each agent\n      - Server registers a context-free subprocess under an existing agent's identity\n      - Server reformats or summarizes agent output before posting it as the agent\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "The fragment defuses this by naming both principals: 'CHARTERED 2026-08-25 (Joe + claude-13)' (offsets 88–126).", :theory {:elems #{:i2}, :names {:i2 "An unattributed or ambiguous charter would blur who actually chartered the mission and under whose authority it runs."}, :axioms #{}}}, :B {:text "    The server's role is coordination, not content relay:\n    1. The server creates the rendezvous, sends the bell, tracks acks.\n    2. Each agent independently generates its output and posts it under its own identity.\n    3. The server may post as \"agency\" (its own identity) for announcements.\n    4. If an agent cannot post (no MUSN access, transport failure), the failure is attributed to the agent, not hidden by the server.\n    This applies to all output channels: MUSN, forum, IRC, CRDT documents.\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "The fragment itself: 'CHARTERED 2026-08-25 (Joe + claude-13)'.", :theory {:elems #{:b}, :names {:b "The mission records its chartering authors and date explicitly in the opening line."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/scope-before-action" 2], :pattern "agent/scope-before-action", :roles ["rationale" "condition"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-formal-war-machine/M-formal-war-machine/policy-95a29538723f94edfa51/[\"agent/scope-before-action\" 2]", :span {:start 148, :end 164}, :source-text-digest "178c284ec2b789111f4fd2f0b8f52137f90e242fb3dd52e396c26df6d4142848", :analysis-digest "5b73f3901a5992827d5de02646d47e70995ba8ec14e3a8de9530e751b068fda3", :source-sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea", :square-digest "4f2042cd79555dced91c3146e27d85c4a236c15bbc458080b809d9ad1c394131"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/scope-before-action", :objects {:G {:text "    Declared scope makes progress measurable, side effects auditable, and completion definable. It also protects the broader system from unintended changes.\n\n    + evidence: Fulab HUD prompts require a pre-action plan (`src/futon3/fulab/hud.clj`), and scope boundaries are spelled out in `CLAUDE.md`.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "Pattern part BECAUSE of agent/scope-before-action (declared scope makes progress measurable, side effects auditable, completion definable).", :theory {:elems #{:g}, :names {:g "Declaring the gap crisp makes the mission's starting scope measurable and its entry decision auditable."}, :axioms #{}}}, :I1 {:text "    The agent needs to make progress that can be verified and bounded.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "The status line picks an explicit entry phase: 'Begins at IDENTIFY' (offsets 127–147 of the sentence).", :theory {:elems #{:i1}, :names {:i1 "The mission needs progress that can be verified and bounded, starting from a defined entry point."}, :axioms #{}}}, :I2 {:text "    Without declared scope, \"done\" is undefined, side effects are unpredictable, and observers cannot tell if the agent is on track or wandering.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "The fragment 'the gap is crisp' (offsets 148–164) is given as the justification for the chosen entry.", :theory {:elems #{:i2}, :names {:i2 "Without a crisp statement of the gap, the entry point would be arbitrary and observers could not tell whether the mission starts on track."}, :axioms #{}}}, :B {:text "    Before substantive action, state the scope: what files, concepts, or regions are in-bounds; what is explicitly out-of-bounds; what the exit condition is. Treat scope violations as requiring explicit expansion, not silent drift. Scope defines the territory; budgets and pauses govern what happens inside it.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "The fragment's relations ['rationale','condition'] capture it serving as the stated precondition for skipping HEAD.", :theory {:elems #{:b}, :names {:b "The mission states its scoping condition — a crisp gap — before substantive work begins."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/eat-your-own-tail" 3], :pattern "agent/eat-your-own-tail", :roles ["dependency" "condition"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-formal-war-machine/M-formal-war-machine/policy-95a29538723f94edfa51/[\"agent/eat-your-own-tail\" 3]", :span {:start 169, :end 226}, :source-text-digest "178c284ec2b789111f4fd2f0b8f52137f90e242fb3dd52e396c26df6d4142848", :analysis-digest "5b73f3901a5992827d5de02646d47e70995ba8ec14e3a8de9530e751b068fda3", :source-sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8", :square-digest "698b641e7347a4ea895d4f0232699f650457154bd5d9d374e93813a0e18622ad"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/eat-your-own-tail", :objects {:G {:text "    Warm execution state contains causal information that final artifacts discard. Feeding that state into the agent's next move shortens the interval between failure, diagnosis, and structural repair. Preserving the observation path makes each incident increase the system's ability to reveal itself, so later runs need less operator archaeology.\n\n    + EXAMPLE:\n      Inbox zero emitted a Reazon warning into the operator's Emacs buffer. Joe summoned the responsible agent; the warning led first to the behind-repository defect, then to the dirty-file fast-forward rule, and finally to explicit commit-or-ignore dispositions for generated output. The notifier remained installed after the repair.\n\n    + EXAMPLE:\n      Codex-10 was induced to run the target code under a debugger and debug the executing program, rather than reason only from source and post-run output.\n\n    + EXAMPLE:\n      Codex-11 attached to a remote data-mining process's logs and improved the code while mining continued, rather than waiting for the final dataset before learning from the run.\n\n    + EXAMPLE:\n      Claude-4 constructed a queryable progress measure with a ratchet, so the live process can report its present position and cannot silently present a regressed state as progress.\n\n    + COUNTERFACTUAL:\n      A dashboard nobody reads, logs inspected only after completion, a debugger attached without changing an intervention, or a progress number that may freely decrease does not eat the tail. The loop closes only when live self-observation changes action and leaves a stronger observation path behind.\n\n    + evidence:\n      Operator synthesis, Joe, 2026-10-02, names the four cases above and explicitly cautions that the pattern is not guaranteed to succeed. Inbox-zero has repository witnesses: Futon3c commits `66bb1664` (Reazon notifier), `83b9f463` (dirty-but-disjoint fast-forward), `631561f5` and `ef1a3666` (generated-artifact disposition), followed by sweeper-authored projection commits `4007d7aa` in Futon6 and `751b9b12` in Futon3c.\n", :source {:path "futon3/library/agent/eat-your-own-tail.flexiarg", :sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8"}, :situation-source "Pattern part BECAUSE of agent/eat-your-own-tail (feeding live state into the next move shortens the failure–diagnosis–repair interval and preserves the observation path).", :theory {:elems #{:g}, :names {:g "Applying the mission lifecycle rule to the mission that owns that rule routes live observation into the next action and leaves the rule strengthened by use."}, :axioms #{}}}, :I1 {:text "    The agent can observe the process while it runs and can change either the running intervention or the machinery used on subsequent runs.\n", :source {:path "futon3/library/agent/eat-your-own-tail.flexiarg", :sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8"}, :situation-source "The status line cites the lifecycle rule directly: 'per `futon4/holes/mission-lifecycle.md`' (within offsets 169–226).", :theory {:elems #{:i1}, :names {:i1 "The mission can observe and follow the mission-lifecycle machinery while chartering itself."}, :axioms #{}}}, :I2 {:text "    The usual workflow puts the agent outside the process: wait for completion, inspect a summary, repair the visible result, and declare success. This delays learning until state has gone cold and produces one-off rescues whose evidence never reaches the mechanism that failed. The first useful attempt may still be inefficient; the pattern begins when that failure is routed back into the live apparatus rather than merely remembered.\n", :source {:path "futon3/library/agent/eat-your-own-tail.flexiarg", :sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8"}, :situation-source "The fragment records an explicit deviation — '`HEAD` is skipped' — rather than defaulting to the routine form.", :theory {:elems #{:i2}, :names {:i2 "The usual workflow would write a HEAD section by habit, delaying the question of whether the machinery already covers this case."}, :axioms #{}}}, :B {:text "    Eat the tail in four moves:\n\n    1. Name the process's native live surface: notification, debugger, log stream, progress projection, trace, or invariant trip.\n    2. Attach the responsible agent to that surface before the run ends.\n    3. Let observations from the live run change the next action: patch, probe, reclassify, resume, or stop.\n    4. Preserve the attachment as machinery for the next run, preferably with a ratchet that records the best established state and makes backsliding visible.\n\n    The tail is an observation channel, not a certificate. Keep outcome judgment independent where success could be self-manufactured; use the system's own signals to find and steer the repair, not to waive its acceptance gate.\n", :source {:path "futon3/library/agent/eat-your-own-tail.flexiarg", :sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8"}, :situation-source "The full fragment: '`HEAD` is skipped per `futon4/holes/mission-lifecycle.md`', with relations ['dependency','condition'].", :theory {:elems #{:b}, :names {:b "The mission lets its own lifecycle state (crisp gap at IDENTIFY) change its documentation action: skip HEAD, citing the rule."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}}], :receipts {:construction {:policy-id "M-formal-war-machine/policy-95a29538723f94edfa51", :policy-key [:wm/reading-policy-v1 "M-formal-war-machine" "M-formal-war-machine/policy-95a29538723f94edfa51" {:nodes [[["agent/intent-handshake-is-binding" 0] "agent/intent-handshake-is-binding"] [["agency/self-attribution" 1] "agency/self-attribution"] [["agent/scope-before-action" 2] "agent/scope-before-action"] [["agent/eat-your-own-tail" 3] "agent/eat-your-own-tail"]], :edges [[["agency/self-attribution" 1] ["agent/scope-before-action" 2] :justified-by] [["agent/intent-handshake-is-binding" 0] ["agency/self-attribution" 1] :goal-precedes] [["agent/scope-before-action" 2] ["agent/eat-your-own-tail" 3] :condition-enables]], :order [["agent/intent-handshake-is-binding" 0] ["agency/self-attribution" 1] ["agent/scope-before-action" 2] ["agent/eat-your-own-tail" 3]]}]}, :scoring {:scorer-version nil, :g-terms nil}, :selection {:stage :pre-selector-binding}}, :target "M-formal-war-machine", :gluing [], :census {:open [["agent/intent-handshake-is-binding" 0] ["agency/self-attribution" 1] ["agent/scope-before-action" 2] ["agent/eat-your-own-tail" 3]], :void [], :unread [], :census-digest "5e19017a2f5dd89efa7d23fa882794520f3e6ce03a0793f3b88cb142125acfba"}}, :executable-nodes [{:occurrence-id ["agent/intent-handshake-is-binding" 0], :pattern "agent/intent-handshake-is-binding", :roles ["goal"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-formal-war-machine/M-formal-war-machine/policy-95a29538723f94edfa51/[\"agent/intent-handshake-is-binding\" 0]", :span {:start 24, :end 67}, :source-text-digest "178c284ec2b789111f4fd2f0b8f52137f90e242fb3dd52e396c26df6d4142848", :analysis-digest "5b73f3901a5992827d5de02646d47e70995ba8ec14e3a8de9530e751b068fda3", :source-sha256 "fb5538c83b04d4150248cb150b6dbb7d087d7166b63dbe3d971387e1fcfc5e26", :square-digest "921c0de7b37e99a1a0a0d251a7daf04cd48b9f7b6d72439c46fc0689da73ad80"}, :enactment-status :open-hole, :hole {:owner :wm/enactment-compiler, :question :operational-clause-owed, :dependencies [], :re-entry :packet-c-enactment-compiler, :occurrence-id ["agent/intent-handshake-is-binding" 0]}} {:occurrence-id ["agency/self-attribution" 1], :pattern "agency/self-attribution", :roles ["context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-formal-war-machine/M-formal-war-machine/policy-95a29538723f94edfa51/[\"agency/self-attribution\" 1]", :span {:start 88, :end 126}, :source-text-digest "178c284ec2b789111f4fd2f0b8f52137f90e242fb3dd52e396c26df6d4142848", :analysis-digest "5b73f3901a5992827d5de02646d47e70995ba8ec14e3a8de9530e751b068fda3", :source-sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f", :square-digest "8a33124eb11caa64a2d393da6fe8b1e0a57972e8d8749bc7b077044a058c72f2"}, :enactment-status :open-hole, :hole {:owner :wm/enactment-compiler, :question :operational-clause-owed, :dependencies [], :re-entry :packet-c-enactment-compiler, :occurrence-id ["agency/self-attribution" 1]}} {:occurrence-id ["agent/scope-before-action" 2], :pattern "agent/scope-before-action", :roles ["rationale" "condition"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-formal-war-machine/M-formal-war-machine/policy-95a29538723f94edfa51/[\"agent/scope-before-action\" 2]", :span {:start 148, :end 164}, :source-text-digest "178c284ec2b789111f4fd2f0b8f52137f90e242fb3dd52e396c26df6d4142848", :analysis-digest "5b73f3901a5992827d5de02646d47e70995ba8ec14e3a8de9530e751b068fda3", :source-sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea", :square-digest "4f2042cd79555dced91c3146e27d85c4a236c15bbc458080b809d9ad1c394131"}, :enactment-status :open-hole, :hole {:owner :wm/enactment-compiler, :question :operational-clause-owed, :dependencies [], :re-entry :packet-c-enactment-compiler, :occurrence-id ["agent/scope-before-action" 2]}} {:occurrence-id ["agent/eat-your-own-tail" 3], :pattern "agent/eat-your-own-tail", :roles ["dependency" "condition"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-formal-war-machine/M-formal-war-machine/policy-95a29538723f94edfa51/[\"agent/eat-your-own-tail\" 3]", :span {:start 169, :end 226}, :source-text-digest "178c284ec2b789111f4fd2f0b8f52137f90e242fb3dd52e396c26df6d4142848", :analysis-digest "5b73f3901a5992827d5de02646d47e70995ba8ec14e3a8de9530e751b068fda3", :source-sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8", :square-digest "698b641e7347a4ea895d4f0232699f650457154bd5d9d374e93813a0e18622ad"}, :enactment-status :open-hole, :hole {:owner :wm/enactment-compiler, :question :operational-clause-owed, :dependencies [], :re-entry :packet-c-enactment-compiler, :occurrence-id ["agent/eat-your-own-tail" 3]}}], :frontier [], :journal-reference {:cascade-digest :sha256-hex, :node-or-group :occurrence-id-or-co-application-group, :phase :keyword, :evidence {:kind :keyword, :digest :sha256-hex}}, :census {:open [["agent/intent-handshake-is-binding" 0] ["agency/self-attribution" 1] ["agent/scope-before-action" 2] ["agent/eat-your-own-tail" 3]], :void [], :unread []}}, :terms {:risk 0.0736224288115039, :lnE -0.05, :logit -1.0808511830440701, :lnE-components {:resource {:value -0.05, :units :nats, :source-pin {:path "wm://existing-outer-controller-inputs", :sha256 "2e6024e3d0e98235fd47aa4f122789fc54da4d5687e90ec9a8493db8ce520f2e"}}, :cadence {:value -0.0, :units :nats, :source-pin {:path "wm://existing-outer-controller-inputs", :sha256 "2e6024e3d0e98235fd47aa4f122789fc54da4d5687e90ec9a8493db8ce520f2e"}}, :continuation {:value 0.0, :units :nats, :source-pin {:path "wm://existing-outer-controller-inputs", :sha256 "2e6024e3d0e98235fd47aa4f122789fc54da4d5687e90ec9a8493db8ce520f2e"}}}, :ambiguity 1.2833333333333332, :G 1.03085118304407, :gamma 1.0, :novelty 0.32610457910076707, :objective 1.0808511830440701, :units :nats}, :posterior 0.14285714285714285} {:policy-id "M-digital-nomad-patterns/policy-b245606b301fc6ea87bb", :target-id "M-digital-nomad-patterns", :cascade-digest "4372a892317d9a20739d7d0d3817acd396240194bf2cbc90d0d0267409e9a976", :canonical-cascade {:schema :wm/executable-cascade-v1, :census-digest "a7ace136845518a378e9747d4e5261415cb5a7d61ed9a6d45c2652b5394a2c37", :relations {:application-order [], :guards []}, :structural-digest "76b9517601993dd8c35cea555eb9fa69b38dd8d2d561fe4937558b076d37eb1e", :co-application-groups [], :digest "4372a892317d9a20739d7d0d3817acd396240194bf2cbc90d0d0267409e9a976", :structural {:reading-order-edges [{:from ["agent/handoff-preserves-context" 0], :to ["agent/state-is-hypothesis" 1], :kind :reading-order, :relation :contrasts-with, :role nil} {:from ["agent/state-is-hypothesis" 1], :to ["agent/scope-before-action" 2], :kind :reading-order, :relation :context-enables, :role nil} {:from ["agent/scope-before-action" 2], :to ["agent/trail-enables-return" 3], :kind :reading-order, :relation :context-enables, :role nil} {:from ["agent/trail-enables-return" 3], :to ["agent/evidence-over-assertion" 4], :kind :reading-order, :relation :dependency-enables, :role nil} {:from ["agent/evidence-over-assertion" 4], :to ["agent/sense-deliberate-act" 5], :kind :reading-order, :relation :dependency-enables, :role nil} {:from ["agent/sense-deliberate-act" 5], :to ["aif/candidate-pattern-action-space" 6], :kind :reading-order, :relation :contrasts-with, :role nil} {:from ["aif/candidate-pattern-action-space" 6], :to ["agency/self-attribution" 7], :kind :reading-order, :relation :justified-by, :role nil} {:from ["agency/self-attribution" 7], :to ["agent/reduction-to-kernel" 8], :kind :reading-order, :relation :contrasts-with, :role nil}], :schema :wm/structural-cascade-v1, :policy-id "M-digital-nomad-patterns/policy-b245606b301fc6ea87bb", :reading-order [["agent/handoff-preserves-context" 0] ["agent/state-is-hypothesis" 1] ["agent/scope-before-action" 2] ["agent/trail-enables-return" 3] ["agent/evidence-over-assertion" 4] ["agent/sense-deliberate-act" 5] ["aif/candidate-pattern-action-space" 6] ["agency/self-attribution" 7] ["agent/reduction-to-kernel" 8]], :construction-order [["agent/handoff-preserves-context" 0] ["agent/state-is-hypothesis" 1] ["agent/scope-before-action" 2] ["agent/trail-enables-return" 3] ["agent/evidence-over-assertion" 4] ["agent/sense-deliberate-act" 5] ["aif/candidate-pattern-action-space" 6] ["agency/self-attribution" 7] ["agent/reduction-to-kernel" 8]], :digest "76b9517601993dd8c35cea555eb9fa69b38dd8d2d561fe4937558b076d37eb1e", :authored-additions [], :alternatives [], :shared-name-candidates [], :nodes [{:occurrence-id ["agent/handoff-preserves-context" 0], :pattern "agent/handoff-preserves-context", :roles ["context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"agent/handoff-preserves-context\" 0]", :span {:start 3, :end 7}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysis-digest "5732b6410709d25a03f8f4a9edafe8fc95ae708d25f0660ecf8f9642c472f216", :source-sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3", :square-digest "53e0c1f075c9ba4c20c789d3aeae63a4c18920cc0a32b3de39813b567e373b12"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/handoff-preserves-context", :objects {:G {:text "    Handoffs convert ephemeral session state into persistent project state. They enable distributed and asynchronous work without context collapse.\n\n    + evidence: Fulab exports session context to `lab/raw`, `lab/stubs`, and `lab/trace` (`dev/lab-export-claude.clj`), plus summaries via `fulab-summary` and `fulab-session-report`.\n", :source {:path "futon3/library/agent/handoff-preserves-context.flexiarg", :sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3"}, :situation-source "Pattern part BECAUSE of agent/handoff-preserves-context (handoffs convert ephemeral session state into persistent project state), matched by the mission document's persistent HEAD section.", :theory {:elems #{:g}, :names {:g "A fixed HEAD converts the mission's ephemeral framing into persistent project state other readers can resume from."}, :axioms #{}}}, :I1 {:text "    Continuity matters: the work is incremental, context is expensive to rebuild, or progress would be lost.\n", :source {:path "futon3/library/agent/handoff-preserves-context.flexiarg", :sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3"}, :situation-source "Mission HEAD opens with the motivating picture (source offsets 8–148 of the analyzed excerpt) before any directives; the 'HEAD' fragment (offsets 3–7) marks that entry point.", :theory {:elems #{:i1}, :names {:i1 "A reader picking the mission up needs its framing intact; the mission's context is expensive to rebuild from scratch."}, :axioms #{}}}, :I2 {:text "    Without explicit handoff, successors face cold starts: they repeat discoveries, miss constraints, or contradict prior decisions.\n", :source {:path "futon3/library/agent/handoff-preserves-context.flexiarg", :sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3"}, :situation-source "The fragment 'HEAD' (offsets 3–7) exists precisely to give the document a defined head; its absence would leave the framing paragraphs unanchored.", :theory {:elems #{:i2}, :names {:i2 "Without a marked entry header, a successor cold-starts and could re-derive or contradict the mission's framing."}, :axioms #{}}}, :B {:text "    Define a handoff record that captures: current state hypothesis, decisions made and why, open questions, scope boundaries, next actions, evidence/trail anchors, and any provisional-claim ledger. Emit it at session end or when transferring to another agent.\n", :source {:path "futon3/library/agent/handoff-preserves-context.flexiarg", :sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3"}, :situation-source "Mission HEAD content: the Futon City analogy, the two terrain-input file citations, and 'the pattern language ... authored below (Joe, 2026-07-27, verbatim)'.", :theory {:elems #{:b}, :names {:b "The document defines a handoff record: a HEAD section carrying the motivating picture, inputs, and the authored pattern language below it."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/state-is-hypothesis" 1], :pattern "agent/state-is-hypothesis", :roles ["context" "contrast"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"agent/state-is-hypothesis\" 1]", :span {:start 52, :end 81}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysis-digest "5732b6410709d25a03f8f4a9edafe8fc95ae708d25f0660ecf8f9642c472f216", :source-sha256 "3cc0d9eaa1559da2f4f329040753c58bf3c5426b92c9884670ecc6102f0c6f5c", :square-digest "fd92b7b07d713bcb65fb72d78cde6e41faea1c2b0b0e72be5302fb86567d8626"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/state-is-hypothesis", :objects {:G {:text "    Hypothesis-framed state makes the agent self-correcting: surprises trigger learning rather than denial or breakdown.\n\n    + evidence: Fulab PSR forecasts in `src/futon3/fulab/pattern_competence.clj` and belief updates in `dev/lab-session-report.clj` treat state as revisable (prediction error, tau updates).\n", :source {:path "futon3/library/agent/state-is-hypothesis.flexiarg", :sha256 "3cc0d9eaa1559da2f4f329040753c58bf3c5426b92c9884670ecc6102f0c6f5c"}, :situation-source "Pattern part BECAUSE of agent/state-is-hypothesis (hypothesis-framed state makes the agent self-correcting).", :theory {:elems #{:g}, :names {:g "Framing the mapping as a revisable hypothesis lets surprises in the terrain input update the picture instead of breaking it."}, :axioms #{}}}, :I1 {:text "    The agent needs to act under uncertainty and update its understanding as new information arrives.\n", :source {:path "futon3/library/agent/state-is-hypothesis.flexiarg", :sha256 "3cc0d9eaa1559da2f4f329040753c58bf3c5426b92c9884670ecc6102f0c6f5c"}, :situation-source "The mission needs a deep-research 'landscape position' note as terrain input (fragment target 'deep-research landscape position').", :theory {:elems #{:i1}, :names {:i1 "The mission must act under uncertainty about how the research field actually is arranged."}, :axioms #{}}}, :I2 {:text "    Treating state as certain leads to brittleness when observations contradict expectations; the agent either ignores evidence or fails catastrophically.\n", :source {:path "futon3/library/agent/state-is-hypothesis.flexiarg", :sha256 "3cc0d9eaa1559da2f4f329040753c58bf3c5426b92c9884670ecc6102f0c6f5c"}, :situation-source "The fragment text itself hedges: the landscape position 'plays the role' of Futon City — a casting, stated as analogy (relations include 'contrast').", :theory {:elems #{:i2}, :names {:i2 "Treating the Futon City mapping as settled fact would make the mission brittle if the survey's picture turns out wrong."}, :axioms #{}}}, :B {:text "    Represent state as revisable hypotheses with associated confidence. When observations conflict with state, update the hypothesis rather than defending it. Track what would falsify current beliefs.\n", :source {:path "futon3/library/agent/state-is-hypothesis.flexiarg", :sha256 "3cc0d9eaa1559da2f4f329040753c58bf3c5426b92c9884670ecc6102f0c6f5c"}, :situation-source "The mission takes both the landscape-position note and its FINDINGS companion as terrain input (fragments at offsets 149–204 and 213–286).", :theory {:elems #{:b}, :names {:b "The mission treats the landscape position as a revisable model of the terrain, to be re-read against the FINDINGS note."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/scope-before-action" 2], :pattern "agent/scope-before-action", :roles ["context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"agent/scope-before-action\" 2]", :span {:start 117, :end 128}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysis-digest "5732b6410709d25a03f8f4a9edafe8fc95ae708d25f0660ecf8f9642c472f216", :source-sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea", :square-digest "8ed2b26b1f6f07d3cb1862e177873b9d91a0bb137d802d2e3ea03788711d6b31"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/scope-before-action", :objects {:G {:text "    Declared scope makes progress measurable, side effects auditable, and completion definable. It also protects the broader system from unintended changes.\n\n    + evidence: Fulab HUD prompts require a pre-action plan (`src/futon3/fulab/hud.clj`), and scope boundaries are spelled out in `CLAUDE.md`.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "Pattern part BECAUSE of agent/scope-before-action (declared scope makes progress measurable and completion definable).", :theory {:elems #{:g}, :names {:g "Declaring the terrain up front makes the movement answer measurable against a definable territory."}, :axioms #{}}}, :I1 {:text "    The agent needs to make progress that can be verified and bounded.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "The mission asks '*\"what do we do about that\"*' — a demand for a bounded response to the survey (offsets 272–299).", :theory {:elems #{:i1}, :names {:i1 "The mission needs movement decisions whose success can be verified against the surveyed terrain."}, :axioms #{}}}, :I2 {:text "    Without declared scope, \"done\" is undefined, side effects are unpredictable, and observers cannot tell if the agent is on track or wandering.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "The fragment 'a landscape' (offsets 117–128) names the field before the mission asks its question.", :theory {:elems #{:i2}, :names {:i2 "Without naming the terrain first, 'what do we do' has no defined territory and the response would be unbounded wandering."}, :axioms #{}}}, :B {:text "    Before substantive action, state the scope: what files, concepts, or regions are in-bounds; what is explicitly out-of-bounds; what the exit condition is. Treat scope violations as requiring explicit expansion, not silent drift. Scope defines the territory; budgets and pauses govern what happens inside it.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "Sentence order in the source: 'the paper's motivating picture: a landscape. This mission takes ...' (offsets 85–148) precedes the 'what do we do' question.", :theory {:elems #{:b}, :names {:b "The motivating picture is stated first — the field as a landscape — and only then does the mission pose the response question."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/trail-enables-return" 3], :pattern "agent/trail-enables-return", :roles ["dependency"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"agent/trail-enables-return\" 3]", :span {:start 149, :end 204}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysis-digest "5732b6410709d25a03f8f4a9edafe8fc95ae708d25f0660ecf8f9642c472f216", :source-sha256 "30909dc8a4e083e1c7361955d00bbe4ed418835b9bf0f2bc5e4c5db36d942c28", :square-digest "16724da4e89c5ecd143f4a3eec7e50aef2ab3a521d8327d8cdcb9cbeed8b15ba"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/trail-enables-return", :objects {:G {:text "    Trails convert ephemeral navigation into persistent structure. They enable learning, debugging, and graceful recovery.\n\n    + evidence: Fulab session exports write `lab/trace/<session-id>.org` and `lab/raw` (`dev/lab-export-claude.clj`), and `fuclaude` supports `--resume`/`--continue` runs.\n", :source {:path "futon3/library/agent/trail-enables-return.flexiarg", :sha256 "30909dc8a4e083e1c7361955d00bbe4ed418835b9bf0f2bc5e4c5db36d942c28"}, :situation-source "Pattern part BECAUSE of agent/trail-enables-return (trails convert ephemeral navigation into persistent structure).", :theory {:elems #{:g}, :names {:g "The citation converts ephemeral navigation of the field into persistent structure the mission can backtrack to."}, :axioms #{}}}, :I1 {:text "    The agent may need to undo actions, revisit prior states, or learn from dead ends.\n", :source {:path "futon3/library/agent/trail-enables-return.flexiarg", :sha256 "30909dc8a4e083e1c7361955d00bbe4ed418835b9bf0f2bc5e4c5db36d942c28"}, :situation-source "The mission declares the note as durable input for later return: 'takes `~/code/TN-deep-research-landscape-position-2026-07.md` and its ... FINDINGS-2026-07-27.md'.", :theory {:elems #{:i1}, :names {:i1 "The mission may need to revisit the terrain survey that motivated its movement patterns."}, :axioms #{}}}, :I2 {:text "    Without a trail, the agent cannot distinguish \"unexplored\" from \"explored and rejected,\" leading to repeated mistakes or inability to recover.\n", :source {:path "futon3/library/agent/trail-enables-return.flexiarg", :sha256 "30909dc8a4e083e1c7361955d00bbe4ed418835b9bf0f2bc5e4c5db36d942c28"}, :situation-source "The fragment is the full dated path with month and findings date in the filename (offsets 149–204 and 213–243).", :theory {:elems #{:i2}, :names {:i2 "Without the dated citation, 'explored terrain' and 'unexamined guess' become indistinguishable for successors."}, :axioms #{}}}, :B {:text "    Record a trail of moves, decisions, and state transitions with minimal fields (time, state snapshot, decision, action, evidence, reversibility). Make the trail queryable so the agent (or its successors) can backtrack, detect loops, and learn from history.\n", :source {:path "futon3/library/agent/trail-enables-return.flexiarg", :sha256 "30909dc8a4e083e1c7361955d00bbe4ed418835b9bf0f2bc5e4c5db36d942c28"}, :situation-source "The two explicit file citations in the mission HEAD (the TN note and its FINDINGS companion).", :theory {:elems #{:b}, :names {:b "The mission records the exact dated source documents as its trail anchors."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/evidence-over-assertion" 4], :pattern "agent/evidence-over-assertion", :roles ["dependency"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"agent/evidence-over-assertion\" 4]", :span {:start 248, :end 261}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysis-digest "5732b6410709d25a03f8f4a9edafe8fc95ae708d25f0660ecf8f9642c472f216", :source-sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248", :square-digest "d4f2b557ced0ee4687566313bdcd1d1b5aecf54a0054158ecda33e48de03b0e0"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/evidence-over-assertion", :objects {:G {:text "    Evidence transforms agent output from \"trust me\" to \"check this.\" It enables verification, correction, and cumulative trust-building.\n\n    + evidence: Fulab PUR/PSR templates require anchors/certificates (`src/futon3/fulab/pattern_competence.clj`), and claim verification is enforced via `fulab-pattern-claim` + `fulab-pattern-check`.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "Pattern part BECAUSE of agent/evidence-over-assertion (evidence transforms agent output from 'trust me' to 'check this').", :theory {:elems #{:g}, :names {:g "Anchoring on the recorded findings turns the answer from 'trust me' into 'check this'."}, :axioms #{}}}, :I1 {:text "    The agent's outputs need to be verifiable by other agents, humans, or future selves.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "The mission grounds its question in named input documents rather than asserting the terrain from memory (fragments at offsets 149–204, 213–261).", :theory {:elems #{:i1}, :names {:i1 "The mission's movement answer must be verifiable by future readers, not taken on trust."}, :axioms #{}}}, :I2 {:text "    Assertions without anchors are indistinguishable from confabulation. Observers cannot tell if the agent is reporting reality or generating plausible-sounding noise.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "The fragment 'terrain input' (offsets 248–261) explicitly ties the answer to the FINDINGS note rather than to an unanchored impression.", :theory {:elems #{:i2}, :names {:i2 "Claims about the landscape without the findings anchor would be indistinguishable from plausible confabulation."}, :axioms #{}}}, :B {:text "    Require every substantive claim to point to evidence: a file path, a trace event, a test result, a quotation. If evidence is unavailable, emit the claim as provisional with an expiry and a verification path. Make \"unsupported claim\" a detectable violation, not just a style preference.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "Mission phrasing: '`...FINDINGS-2026-07-27.md` as the terrain input' (offsets 213–261).", :theory {:elems #{:b}, :names {:b "The mission requires the survey document as the terrain input before answering."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/sense-deliberate-act" 5], :pattern "agent/sense-deliberate-act", :roles ["goal"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"agent/sense-deliberate-act\" 5]", :span {:start 272, :end 286}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysis-digest "5732b6410709d25a03f8f4a9edafe8fc95ae708d25f0660ecf8f9642c472f216", :source-sha256 "8e8889947713cf92ac48c6c37e1fa55b1ef40157540475199f5ec6d993edfdd9", :square-digest "38f86c874c5d66a3bdaa24f4742dd6f0ccb5c649c18b73d3962c00aa77bbaba7"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/sense-deliberate-act", :objects {:G {:text "    The three-phase structure prevents both impulsive drift and endless deliberation, and makes the agent's reasoning inspectable at phase boundaries.\n\n    + evidence: Fulab HUD prompts force deliberate candidate review before acting (`src/futon3/fulab/hud.clj`), and the session report tracks selection and outcome phases (`dev/lab-session-report.clj`).\n", :source {:path "futon3/library/agent/sense-deliberate-act.flexiarg", :sha256 "8e8889947713cf92ac48c6c37e1fa55b1ef40157540475199f5ec6d993edfdd9"}, :situation-source "Pattern part BECAUSE of agent/sense-deliberate-act (the three-phase structure prevents both impulsive drift and endless deliberation).", :theory {:elems #{:g}, :names {:g "Keeping sense and act as explicit ordered phases makes the response inspectable rather than impulsive."}, :axioms #{}}}, :I1 {:text "    The agent needs to make progress on a goal while responding to a changing environment.\n", :source {:path "futon3/library/agent/sense-deliberate-act.flexiarg", :sha256 "8e8889947713cf92ac48c6c37e1fa55b1ef40157540475199f5ec6d993edfdd9"}, :situation-source "The mission pairs a completed survey (the two input notes) with a demanded response ('what do we do about that').", :theory {:elems #{:i1}, :names {:i1 "The mission must both absorb a changing survey and commit to a movement response."}, :axioms #{}}}, :I2 {:text "    Rushing to act without sensing leads to blind thrashing; sensing without acting leads to analysis paralysis; acting without deliberation leads to incoherent behavior.\n", :source {:path "futon3/library/agent/sense-deliberate-act.flexiarg", :sha256 "8e8889947713cf92ac48c6c37e1fa55b1ef40157540475199f5ec6d993edfdd9"}, :situation-source "The question fragment '\"what do we do' (offsets 272–286) comes after, not before, the terrain citations that supply the sensing.", :theory {:elems #{:i2}, :names {:i2 "Answering before sensing the landscape would be blind thrashing; sensing without answering would be analysis paralysis."}, :axioms #{}}}, :B {:text "    Enforce a rhythm: first gather relevant observations, then weigh options against goals and constraints, then commit to a single action before the next cycle. Make each phase explicit and bounded, and check scope, budget, and confidence gates at phase boundaries.\n", :source {:path "futon3/library/agent/sense-deliberate-act.flexiarg", :sha256 "8e8889947713cf92ac48c6c37e1fa55b1ef40157540475199f5ec6d993edfdd9"}, :situation-source "Source order: terrain citations (149–261) → question (272–299) → 'the answer expressed as a small pattern language' (331–355).", :theory {:elems #{:b}, :names {:b "The mission's rhythm is: read the terrain notes, then ask the response question, then author the movement language."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["aif/candidate-pattern-action-space" 6], :pattern "aif/candidate-pattern-action-space", :roles ["goal" "contrast"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"aif/candidate-pattern-action-space\" 6]", :span {:start 331, :end 355}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysis-digest "5732b6410709d25a03f8f4a9edafe8fc95ae708d25f0660ecf8f9642c472f216", :source-sha256 "110aa7ed57fdaca1558228ba7718124eea54e077f413929d8bac91dd41fabe05", :square-digest "26dc8b51271438d79bfca8f5588608edd5e8f78b81935178db70a9989998d38c"}, :square {:schema :wm/three-halves-square-v1, :pattern "aif/candidate-pattern-action-space", :objects {:G {:text "    Constraining the action space makes downstream scoring meaningful rather than performative.\n", :source {:path "futon3/library/aif/candidate-pattern-action-space.flexiarg", :sha256 "110aa7ed57fdaca1558228ba7718124eea54e077f413929d8bac91dd41fabe05"}, :situation-source "Pattern part BECAUSE of aif/candidate-pattern-action-space (constraining the action space makes downstream scoring meaningful).", :theory {:elems #{:g}, :names {:g "Bounding the answer to a small candidate set makes later evaluation of moves meaningful."}, :axioms #{}}}, :I1 {:text "    You want pattern choice to be legible and comparable, and you want to avoid collapse into one habitual pattern.\n", :source {:path "futon3/library/aif/candidate-pattern-action-space.flexiarg", :sha256 "110aa7ed57fdaca1558228ba7718124eea54e077f413929d8bac91dd41fabe05"}, :situation-source "The mission asks for 'a small pattern language for movement' — a constructed, bounded set of moves (offsets 331–355, 360–367).", :theory {:elems #{:i1}, :names {:i1 "The mission wants movement choices that are legible and comparable, not one habitual response."}, :axioms #{}}}, :I2 {:text "    If the action space is any pattern at any time, evaluation becomes unstructured and selection becomes arbitrary or dominated by recency.\n", :source {:path "futon3/library/aif/candidate-pattern-action-space.flexiarg", :sha256 "110aa7ed57fdaca1558228ba7718124eea54e077f413929d8bac91dd41fabe05"}, :situation-source "The fragment's own contrast: the answer is a pattern language 'rather than as a one-off plan' (relations 'goal', 'contrast').", :theory {:elems #{:i2}, :names {:i2 "If any response at any time were allowed, choosing what to do about the landscape would be arbitrary."}, :axioms #{}}}, :B {:text "    Define (a) as a constructed candidate set of pattern IDs produced by retrieval plus gating rules, with bounded size and explicit reasons for inclusion and exclusion.\n", :source {:path "futon3/library/aif/candidate-pattern-action-space.flexiarg", :sha256 "110aa7ed57fdaca1558228ba7718124eea54e077f413929d8bac91dd41fabe05"}, :situation-source "Mission phrasing: 'the answer expressed as a small pattern language for movement, authored below (Joe, 2026-07-27, verbatim)'.", :theory {:elems #{:b}, :names {:b "The mission constructs the answer as a small pattern language with authored, named movement patterns."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agency/self-attribution" 7], :pattern "agency/self-attribution", :roles ["context" "rationale"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"agency/self-attribution\" 7]", :span {:start 370, :end 412}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysis-digest "5732b6410709d25a03f8f4a9edafe8fc95ae708d25f0660ecf8f9642c472f216", :source-sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f", :square-digest "0ce4adeecebfebf6fd65eeac4c6e7a252bbd7b4275ae09c02dff50a077c840a4"}, :square {:schema :wm/three-halves-square-v1, :pattern "agency/self-attribution", :objects {:G {:text "    Proxy posting breaks the audit trail. When output appears under agent X's identity but was posted by the server, you cannot distinguish between \"X said this\" and \"the server said X said this.\" In incident review, this ambiguity makes root cause analysis unreliable. A meeting transcript where one person takes notes for everyone is not the same as each person signing their own statement.\n\n    + EVIDENCE (repo history):\n      - 2026-02-08 169c4bc: /agency/standup initially implemented as \"whistle all agents and collect responses\", putting the server in the position to relay agent content as an intermediary.\n      - 2026-02-08 9acf154: standup redesign explicitly rejects the prior proxy approach as an identity violation and moves to \"agent self-reporting\": each agent acks, invokes itself, and posts to MUSN under its own identity.\n      - 2026-01-31 b2fbb84: mission notes define the first principle that Agency is a continuity layer, not \"the agent itself\", which aligns with self-attribution (coordination vs content authorship).\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "Pattern part BECAUSE of agency/self-attribution (proxy or unattributed output breaks the audit trail).", :theory {:elems #{:g}, :names {:g "Explicit attribution keeps the audit trail: 'Joe said this' stays distinguishable from 'the document says this'."}, :axioms #{}}}, :I1 {:text "    You need an agent's output to appear in a shared channel (IRC, MUSN, forum).\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "The pattern language is published inside the mission file, below the HEAD section being analyzed.", :theory {:elems #{:i1}, :names {:i1 "The pattern language must appear in the shared mission document under a clear author."}, :axioms #{}}}, :I2 {:text "    The server has access to agent identities and could post on their behalf, making the code simpler. But this creates false attribution: the message appears to come from the agent, but the agent never authored or approved it. If the agent's invocation returned an error, the server might post the error as if the agent said it. If the server's MUSN post fails, the agent has no way to know its update was lost.\n\n    + ANTI-PATTERNS:\n      - Server collects whistle responses and POSTs to MUSN as each agent\n      - Server registers a context-free subprocess under an existing agent's identity\n      - Server reformats or summarizes agent output before posting it as the agent\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "The fragment defuses exactly this: 'authored below (Joe, 2026-07-27, verbatim)' (offsets 370–412).", :theory {:elems #{:i2}, :names {:i2 "An unattributed or ghost-written language would blur who actually authored the movement advice."}, :axioms #{}}}, :B {:text "    The server's role is coordination, not content relay:\n    1. The server creates the rendezvous, sends the bell, tracks acks.\n    2. Each agent independently generates its output and posts it under its own identity.\n    3. The server may post as \"agency\" (its own identity) for announcements.\n    4. If an agent cannot post (no MUSN access, transport failure), the failure is attributed to the agent, not hidden by the server.\n    This applies to all output channels: MUSN, forum, IRC, CRDT documents.\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "The fragment itself: 'authored below (Joe, 2026-07-27, verbatim)'.", :theory {:elems #{:b}, :names {:b "The mission records author, date, and verbatim quotation for the movement language."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/reduction-to-kernel" 8], :pattern "agent/reduction-to-kernel", :roles ["contrast"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"agent/reduction-to-kernel\" 8]", :span {:start 431, :end 443}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysis-digest "5732b6410709d25a03f8f4a9edafe8fc95ae708d25f0660ecf8f9642c472f216", :source-sha256 "623974bb0f6bd46b09bd3fa80f472673613db86c514fe6e89badaf1344eff211", :square-digest "862947f2f32c44dc40cb82c93ab5614079673530f20d175fb13ec36aa1140b00"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/reduction-to-kernel", :objects {:G {:text "      A named conjecture with explicit hypotheses is qualitatively different from \"the\n      proof is stuck.\" It converts an open problem into a precise target that can be:\n      (a) worked on by a different agent with fresh perspective, (b) recognized by someone\n      who knows the relevant technique, (c) connected to existing results via the explicit\n      hypotheses, (d) empirically tested. The reduce phase (all the work that leads to\n      the kernel) is always tractable; the kernel phase may not be — but the reduce phase\n      is still valuable because it converts \"hard problem\" into \"hard problem minus\n      everything tractable.\"\n\n    + EVIDENCE:\n        P6 epsilon-light subsets (futon6, Feb 2026): the full proof (650+ lines) was reduced\n        to GPL-H — a single operator-valued averaging statement with 4 explicit hypotheses\n        (H1: light edges, H2: core regularity, H3: barrier-valid prefix, H4: residual size)\n        and one conclusion (min_v ‖Y_t(v)‖ ≤ θ). A sharper reduction showed that L2* alone\n        (score control) implies the theorem, without needing L3 (drift control). Named\n        conjecture + proved reduction + 2353 trajectory numerical evidence.\n\n        P7 lattices with 2-torsion (futon6, Feb 2026): the S obligation was reduced to a\n        single lattice-existence question: do arithmetic uniform lattices in Isom(H^{2k+1})\n        contain order-2 rotational involutions? This is a number-theoretic question\n        independent of the topology/surgery machinery.\n", :source {:path "futon3/library/agent/reduction-to-kernel.flexiarg", :sha256 "623974bb0f6bd46b09bd3fa80f472673613db86c514fe6e89badaf1344eff211"}, :situation-source "Pattern part BECAUSE of agent/reduction-to-kernel (a named, explicit kernel converts an open problem into a precise target others can work on).", :theory {:elems #{:g}, :names {:g "Reducing the response to a reusable kernel converts 'what do we do' into a precise, transferable target."}, :axioms #{}}}, :I1 {:text "      The proof is mostly complete: the structure is understood, most cases are closed,\n      and the remaining difficulty is localizable to a specific mathematical statement.\n      The statement can be formulated with explicit hypotheses that are already proved\n      or assumed from the problem setup.\n", :source {:path "futon3/library/agent/reduction-to-kernel.flexiarg", :sha256 "623974bb0f6bd46b09bd3fa80f472673613db86c514fe6e89badaf1344eff211"}, :situation-source "The mission's terrain inputs are complete (two cited notes) and the answer form is already chosen — only the concrete response remains.", :theory {:elems #{:i1}, :names {:i1 "The response problem is mostly understood: the terrain is surveyed and the structure of an answer is clear."}, :axioms #{}}}, :I2 {:text "      The reduction must be rigorous. \"It would be enough to prove X\" is not a reduction\n      unless you have proved that X actually implies the desired conclusion. Also: the\n      kernel should be genuinely minimal — if it contains unnecessary hypotheses or can\n      be split into independent parts, simplify further.\n\n    + FAILURE-MODES:\n        - False reduction: the kernel doesn't actually imply the conclusion. Prove the\n          reduction rigorously.\n        - Over-specified kernel: too many hypotheses, some unnecessary. Simplify until each\n          hypothesis is used in the reduction proof.\n        - Under-specified kernel: the kernel is true but insufficient. Check that the\n          reduction covers all cases.\n", :source {:path "futon3/library/agent/reduction-to-kernel.flexiarg", :sha256 "623974bb0f6bd46b09bd3fa80f472673613db86c514fe6e89badaf1344eff211"}, :situation-source "The fragment 'one-off plan' (offsets 431–443) is named precisely as the rejected alternative ('rather than as a one-off plan').", :theory {:elems #{:i2}, :names {:i2 "A one-off plan is the anti-pattern here: an ad-hoc kernel that neither generalizes nor is checked against reuse."}, :axioms #{}}}, :B {:text "      1. Formulate the missing lemma with numbered hypotheses (H1, H2, ...) and a\n         conclusion.\n      2. Prove the reduction: show that the hypotheses are satisfiable from the problem\n         setup and that the conclusion implies the target theorem.\n      3. Check each hypothesis: is it already proved, or does it need work? Mark status.\n      4. Give the conjecture a name (GPL-H, L2*, etc.) and record it in the proof status\n         document.\n      5. Include any numerical evidence that supports the conjecture.\n", :source {:path "futon3/library/agent/reduction-to-kernel.flexiarg", :sha256 "623974bb0f6bd46b09bd3fa80f472673613db86c514fe6e89badaf1344eff211"}, :situation-source "The contrast in the source: 'a small pattern language for movement ... rather than as a one-off plan.'", :theory {:elems #{:b}, :names {:b "The mission replaces the one-off plan with the authored pattern language as its reusable kernel."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}}], :receipts {:construction {:policy-id "M-digital-nomad-patterns/policy-b245606b301fc6ea87bb", :policy-key [:wm/reading-policy-v1 "M-digital-nomad-patterns" "M-digital-nomad-patterns/policy-b245606b301fc6ea87bb" {:nodes [[["agent/handoff-preserves-context" 0] "agent/handoff-preserves-context"] [["agent/state-is-hypothesis" 1] "agent/state-is-hypothesis"] [["agent/scope-before-action" 2] "agent/scope-before-action"] [["agent/trail-enables-return" 3] "agent/trail-enables-return"] [["agent/evidence-over-assertion" 4] "agent/evidence-over-assertion"] [["agent/sense-deliberate-act" 5] "agent/sense-deliberate-act"] [["aif/candidate-pattern-action-space" 6] "aif/candidate-pattern-action-space"] [["agency/self-attribution" 7] "agency/self-attribution"] [["agent/reduction-to-kernel" 8] "agent/reduction-to-kernel"]], :edges [[["agency/self-attribution" 7] ["agent/reduction-to-kernel" 8] :contrasts-with] [["agent/evidence-over-assertion" 4] ["agent/sense-deliberate-act" 5] :dependency-enables] [["agent/handoff-preserves-context" 0] ["agent/state-is-hypothesis" 1] :contrasts-with] [["agent/scope-before-action" 2] ["agent/trail-enables-return" 3] :context-enables] [["agent/sense-deliberate-act" 5] ["aif/candidate-pattern-action-space" 6] :contrasts-with] [["agent/state-is-hypothesis" 1] ["agent/scope-before-action" 2] :context-enables] [["agent/trail-enables-return" 3] ["agent/evidence-over-assertion" 4] :dependency-enables] [["aif/candidate-pattern-action-space" 6] ["agency/self-attribution" 7] :justified-by]], :order [["agent/handoff-preserves-context" 0] ["agent/state-is-hypothesis" 1] ["agent/scope-before-action" 2] ["agent/trail-enables-return" 3] ["agent/evidence-over-assertion" 4] ["agent/sense-deliberate-act" 5] ["aif/candidate-pattern-action-space" 6] ["agency/self-attribution" 7] ["agent/reduction-to-kernel" 8]]}]}, :scoring {:scorer-version nil, :g-terms nil}, :selection {:stage :pre-selector-binding}}, :target "M-digital-nomad-patterns", :gluing [], :census {:open [["agent/handoff-preserves-context" 0] ["agent/state-is-hypothesis" 1] ["agent/scope-before-action" 2] ["agent/trail-enables-return" 3] ["agent/evidence-over-assertion" 4] ["agent/sense-deliberate-act" 5] ["aif/candidate-pattern-action-space" 6] ["agency/self-attribution" 7] ["agent/reduction-to-kernel" 8]], :void [], :unread [], :census-digest "a7ace136845518a378e9747d4e5261415cb5a7d61ed9a6d45c2652b5394a2c37"}}, :executable-nodes [{:occurrence-id ["agent/handoff-preserves-context" 0], :pattern "agent/handoff-preserves-context", :roles ["context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"agent/handoff-preserves-context\" 0]", :span {:start 3, :end 7}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysis-digest "5732b6410709d25a03f8f4a9edafe8fc95ae708d25f0660ecf8f9642c472f216", :source-sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3", :square-digest "53e0c1f075c9ba4c20c789d3aeae63a4c18920cc0a32b3de39813b567e373b12"}, :enactment-status :open-hole, :hole {:owner :wm/enactment-compiler, :question :operational-clause-owed, :dependencies [], :re-entry :packet-c-enactment-compiler, :occurrence-id ["agent/handoff-preserves-context" 0]}} {:occurrence-id ["agent/state-is-hypothesis" 1], :pattern "agent/state-is-hypothesis", :roles ["context" "contrast"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"agent/state-is-hypothesis\" 1]", :span {:start 52, :end 81}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysis-digest "5732b6410709d25a03f8f4a9edafe8fc95ae708d25f0660ecf8f9642c472f216", :source-sha256 "3cc0d9eaa1559da2f4f329040753c58bf3c5426b92c9884670ecc6102f0c6f5c", :square-digest "fd92b7b07d713bcb65fb72d78cde6e41faea1c2b0b0e72be5302fb86567d8626"}, :enactment-status :open-hole, :hole {:owner :wm/enactment-compiler, :question :operational-clause-owed, :dependencies [], :re-entry :packet-c-enactment-compiler, :occurrence-id ["agent/state-is-hypothesis" 1]}} {:occurrence-id ["agent/scope-before-action" 2], :pattern "agent/scope-before-action", :roles ["context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"agent/scope-before-action\" 2]", :span {:start 117, :end 128}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysis-digest "5732b6410709d25a03f8f4a9edafe8fc95ae708d25f0660ecf8f9642c472f216", :source-sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea", :square-digest "8ed2b26b1f6f07d3cb1862e177873b9d91a0bb137d802d2e3ea03788711d6b31"}, :enactment-status :open-hole, :hole {:owner :wm/enactment-compiler, :question :operational-clause-owed, :dependencies [], :re-entry :packet-c-enactment-compiler, :occurrence-id ["agent/scope-before-action" 2]}} {:occurrence-id ["agent/trail-enables-return" 3], :pattern "agent/trail-enables-return", :roles ["dependency"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"agent/trail-enables-return\" 3]", :span {:start 149, :end 204}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysis-digest "5732b6410709d25a03f8f4a9edafe8fc95ae708d25f0660ecf8f9642c472f216", :source-sha256 "30909dc8a4e083e1c7361955d00bbe4ed418835b9bf0f2bc5e4c5db36d942c28", :square-digest "16724da4e89c5ecd143f4a3eec7e50aef2ab3a521d8327d8cdcb9cbeed8b15ba"}, :enactment-status :open-hole, :hole {:owner :wm/enactment-compiler, :question :operational-clause-owed, :dependencies [], :re-entry :packet-c-enactment-compiler, :occurrence-id ["agent/trail-enables-return" 3]}} {:occurrence-id ["agent/evidence-over-assertion" 4], :pattern "agent/evidence-over-assertion", :roles ["dependency"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-digital-nomad-patterns/M-digital-nomad-patterns/policy-b245606b301fc6ea87bb/[\"agent/evidence-over-assertion\" 4]", :span {:start 248, :end 261}, :source-text-digest "c24aa4cea189fb189a0f5284c91f6c1098a4b146bb0bd4932a939deadc5157f9", :analysi