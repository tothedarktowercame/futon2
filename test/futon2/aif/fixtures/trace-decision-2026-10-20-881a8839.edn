ed-name-candidates [], :nodes [{:occurrence-id ["futon-theory/mission-lifecycle" 1], :pattern "futon-theory/mission-lifecycle", :roles ["context" "condition"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-stack-geometry/M-stack-geometry/policy-c7d7518e1e185c2e2318/[\"futon-theory/mission-lifecycle\" 1]", :span {:start 121, :end 136}, :source-text-digest "9c2f467e8d5062961da62bae3a5d3b2b064f048a9354e7be0bfd5dfc025d2aad", :analysis-digest "e183844e1fd2569431413d615fb7b997a8182cdd0b86f14175ed3b83e21e5e4d", :source-sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001", :square-digest "559d9ce843d0b09b316b9f8b005170b91ce1d802366fe48fa4e549d7af4a3119"}, :square {:schema :wm/three-halves-square-v1, :pattern "futon-theory/mission-lifecycle", :objects {:G {:text "    - Explicit states prevent invisible drift\n    - Transition requirements create evidence trail\n    - Blocked states surface dependency graphs\n    - Review gates ensure verification before closure\n", :source {:path "futon3/library/futon-theory/mission-lifecycle.flexiarg", :sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001"}, :situation-source "Lifecycle transition rules and the mission status.", :theory {:elems #{:g}, :names {:g "A named state prevents invisible mission drift."}, :axioms #{}}}, :I1 {:text "    You are defining, tracking, or transitioning a mission.\n", :source {:path "futon3/library/futon-theory/mission-lifecycle.flexiarg", :sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001"}, :situation-source "futon3/library/futon-theory/mission-lifecycle.flexiarg IF/THEN.", :theory {:elems #{:i1}, :names {:i1 "Missions advance through explicit, evidenced states."}, :axioms #{}}}, :I2 {:text "    Missions may be blocked by dependencies, split into sub-missions,\n    or merged when scope overlaps. The lifecycle must accommodate these.\n", :source {:path "futon3/library/futon-theory/mission-lifecycle.flexiarg", :sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001"}, :situation-source "M-stack-geometry.md status: OPEN — IDENTIFY.", :theory {:elems #{:i2}, :names {:i2 "Stack Geometry remains in IDENTIFY."}, :axioms #{}}}, :B {:text "    Apply the mission state machine:\n\n    ```\n    :greenfield → :scoped → :active → :blocked → :review → :done\n                     ↑          ↓         ↓\n                     └──────────┴─────────┘ (can regress)\n    ```\n\n    State definitions:\n    - :greenfield - Idea captured, no work plan\n    - :scoped - Success criteria, boundaries, dependencies defined\n    - :active - Work in progress, owner assigned\n    - :blocked - Waiting on dependency (cite blocker)\n    - :review - Work complete, awaiting verification\n    - :done - Success criteria met, evidence recorded\n\n    Transition requirements:\n    - greenfield → scoped: Mission doc has success criteria + scope\n    - scoped → active: Owner assigned, dependencies clear\n    - active → blocked: Blocker cited with link to blocking mission\n    - active → review: All success criteria addressed\n    - review → done: Evidence verified by reviewer\n    - Any → :abandoned: Explicit decision with rationale\n", :source {:path "futon3/library/futon-theory/mission-lifecycle.flexiarg", :sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001"}, :situation-source "Lifecycle requirements applied to the recorded status.", :theory {:elems #{:b}, :names {:b "Retain IDENTIFY until scope and transition evidence justify advancement."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/evidence-over-assertion" 2], :pattern "agent/evidence-over-assertion", :roles ["dependency" "context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-stack-geometry/M-stack-geometry/policy-c7d7518e1e185c2e2318/[\"agent/evidence-over-assertion\" 2]", :span {:start 205, :end 259}, :source-text-digest "9c2f467e8d5062961da62bae3a5d3b2b064f048a9354e7be0bfd5dfc025d2aad", :analysis-digest "e183844e1fd2569431413d615fb7b997a8182cdd0b86f14175ed3b83e21e5e4d", :source-sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248", :square-digest "58beb4f5213ef58ce9c1e3491e088b19cb3c2f5d5f55ba1146314b1835f4ffc3"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/evidence-over-assertion", :objects {:G {:text "    Evidence transforms agent output from \"trust me\" to \"check this.\" It enables verification, correction, and cumulative trust-building.\n\n    + evidence: Fulab PUR/PSR templates require anchors/certificates (`src/futon3/fulab/pattern_competence.clj`), and claim verification is enforced via `fulab-pattern-claim` + `fulab-pattern-check`.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "Pattern evidence rule and the two file references.", :theory {:elems #{:g}, :names {:g "Conceptual provenance is checkable through cited artifacts."}, :axioms #{}}}, :I1 {:text "    The agent's outputs need to be verifiable by other agents, humans, or future selves.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "futon3/library/agent/evidence-over-assertion.flexiarg THEN.", :theory {:elems #{:i1}, :names {:i1 "Substantive claims require inspectable anchors."}, :axioms #{}}}, :I2 {:text "    Assertions without anchors are indistinguishable from confabulation. Observers cannot tell if the agent is reporting reality or generating plausible-sounding noise.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "M-stack-geometry.md references holistic-argument.sexp and holistic-argument-sketch.md.", :theory {:elems #{:i2}, :names {:i2 "Two predecessor argument files are named."}, :axioms #{}}}, :B {:text "    Require every substantive claim to point to evidence: a file path, a trace event, a test result, a quotation. If evidence is unavailable, emit the claim as provisional with an expiry and a verification path. Make \"unsupported claim\" a detectable violation, not just a style preference.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "Mission cross-reference under the pattern’s file-anchor rule.", :theory {:elems #{:b}, :names {:b "Use both argument files as provenance for the superseded synthesis."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["futon-theory/mission-lifecycle" 3], :pattern "futon-theory/mission-lifecycle", :roles ["contrast" "context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-stack-geometry/M-stack-geometry/policy-c7d7518e1e185c2e2318/[\"futon-theory/mission-lifecycle\" 3]", :span {:start 266, :end 293}, :source-text-digest "9c2f467e8d5062961da62bae3a5d3b2b064f048a9354e7be0bfd5dfc025d2aad", :analysis-digest "e183844e1fd2569431413d615fb7b997a8182cdd0b86f14175ed3b83e21e5e4d", :source-sha256 "78eee0c50b9af03f21a6225c21799b5c724ae873dfd95aee9724be5aac787001", :square-digest "d99c1dcc6b6336cead6130d079894c8bfa3efd413121e018c3c981c746d93f20"}, :square {:schema :wm/three-halves-square-v1, :pattern "futon-theory/mission-lifecycle", :objects {:G {:text "    - Explicit states prevent invisible drift\n    - Transition requirements create evidence trail\n    - Blocked states surface dependency graphs\n    - Review gates ensure verification before closure\n", :source {:path "futon3/library/futon-theory/mission-lifecycle.flexiarg", :sha256 "78eee0c50b9af03f21a6225c