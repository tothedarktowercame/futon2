eory {:elems #{:i1}, :names {:i1 "A computed metric must carry its rule, inputs, and assumptions so a skeptical reader can recompute it."}, :axioms #{}}}, :I2 {:text "      The record carries only the value: the choice of rule, the input\n      window, and the exclusions live in code history and heads — so\n      when the number is disputed (and load-bearing numbers always\n      eventually are), the dispute becomes archaeology or authority\n      instead of arithmetic.\n", :source {:path "futon3/library/measurement/warrant-travels-with-the-number.flexiarg", :sha256 "415a41bc2fc385ebc02e7cae2dc20d0b484790afa9b14a7958fc66853652e7e3"}, :situation-source "M-recommendation-bindings proof-debt counter fragment.", :theory {:elems #{:i2}, :names {:i2 "devmap_readiness.py and boundary.edn produce an active per-prototype proof-debt count."}, :axioms #{}}}, :B {:text "      Attach the warrant to the number where it is stored: the rule\n      (or its id/sha), the inputs (or pointers to them), and the\n      exclusions/assumptions. The test: a skeptical reader can\n      recompute the number from the record alone, or point at exactly\n      which warranted step they reject.\n", :source {:path "futon3/library/measurement/warrant-travels-with-the-number.flexiarg", :sha256 "415a41bc2fc385ebc02e7cae2dc20d0b484790afa9b14a7958fc66853652e7e3"}, :situation-source "Combined measurement pattern and proof-debt counter reference.", :theory {:elems #{:b}, :names {:b "A next-move recommendation whose proof-debt value is reproducible from its cited computation and data."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["measurement/warrant-travels-with-the-number" 11], :pattern "measurement/warrant-travels-with-the-number", :roles ["dependency" "rationale" "action"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-recommendation-bindings/M-recommendation-bindings/polic