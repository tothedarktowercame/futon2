id "M-self-improvement-loop/policy-1bbcf6a06eb2766b5e77", :target-id "M-self-improvement-loop", :cascade-digest "f79e6e5b560469f5f1a5edb69cda2e990a8f33fd6aa6228c13913e06fb031b4f", :canonical-cascade {:schema :wm/executable-cascade-v1, :census-digest "624dabe43fc8671b3f70a405f6c47b9496346c7ce74dba7db2ba3fa49645a3e6", :relations {:application-order [], :guards []}, :structural-digest "efcf8c76cd83e9ed5215acb2dd4608ea06dba1891cd22114ed79df349a5702f3", :co-application-groups [], :digest "f79e6e5b560469f5f1a5edb69cda2e990a8f33fd6aa6228c13913e06fb031b4f", :structural {:reading-order-edges [{:from ["agent/eat-your-own-tail" 0], :to ["agent/trail-enables-return" 1], :kind :reading-order, :relation :goal-precedes, :role nil} {:from ["agent/trail-enables-return" 1], :to ["agent/sense-deliberate-act" 2], :kind :reading-order, :relation :context-enables, :role nil} {:from ["agent/sense-deliberate-act" 2], :to ["agency/self-attribution" 3], :kind :reading-order, :relation :context-enables, :role nil} {:from ["agency/self-attribution" 3], :to ["agent/scope-before-action" 4], :kind :reading-order, :relation :condition-enables, :role nil} {:from ["agent/scope-before-action" 4], :to ["agent/handoff-preserves-context" 5], :kind :reading-order, :relation :condition-enables, :role nil} {:from ["agent/handoff-preserves-context" 5], :to ["agent/state-is-hypothesis" 6], :kind :reading-order, :relation :context-enables, :role nil} {:from ["agent/state-is-hypothesis" 6], :to ["agent/budget-bounds-exploration" 7], :kind :reading-order, :relation :dependency-enables, :role nil}], :schema :wm/structural-cascade-v1, :policy-id "M-self-improvement-loop/policy-1bbcf6a06eb2766b5e77", :reading-order [["agent/eat-your-own-tail" 0] ["agent/trail-enables-return" 1] ["agent/sense-deliberate-act" 2] ["agency/self-attribution" 3] ["agent/scope-before-action" 4] ["agent/handoff-preserves-context" 5] ["agent/state-is-hypothesis" 6] ["agent/budget-bounds-exploration" 7]], :construction-order [["agent/eat-your-own-tail" 0] ["agent/trail-enables-return" 1] ["agent/sense-deliberate-act" 2] ["agency/self-attribution" 3] ["agent/scope-before-action" 4] ["agent/handoff-preserves-context" 5] ["agent/state-is-hypothesis" 6] ["agent/budget-bounds-exploration" 7]], :digest "efcf8c76cd83e9ed5215acb2dd4608ea06dba1891cd22114ed79df349a5702f3", :authored-additions [], :alternatives [], :shared-name-candidates [], :nodes [{:occurrence-id ["agent/eat-your-own-tail" 0], :pattern "agent/eat-your-own-tail", :roles ["goal"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-self-improvement-loop/M-self-improvement-loop/policy-1bbcf6a06eb2766b5e77/[\"agent/eat-your-own-tail\" 0]", :span {:start 11, :end 36}, :source-text-digest "4c99d44c3200d94be835556824b59ab1f027a31c607428839d78723dddee561a", :analysis-digest "27dc8cf394d1c04e3bb6d4a5f5430a40b7e8344744b08b117f7606bccd269112", :source-sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8", :square-digest "aafb69d1f6b15395e4d78dca8bddb525959faf6c9efe27d2d9d64fdcf7304745"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/eat-your-own-tail", :objects {:G {:text "    Warm execution state contains causal information that final artifacts discard. Feeding that state into the agent's next move shortens the interval between failure, diagnosis, and structural repair. Preserving the observation path makes each incident increase the system's ability to reveal itself, so later runs need less operator archaeology.\n\n    + EXAMPLE:\n      Inbox zero emitted a Reazon warning into the operator's Emacs buffer. Joe summoned the responsible agent; the warning led first to the behind-repository defect, then to the dirty-file fast-forward rule, and finally to explicit commit-or-ignore dispositions for generated output. The notifier remained installed after the repair.\n\n    + EXAMPLE:\n      Codex-10 was induced to run the target code under a debugger and debug the executing program, rather than reason only from source and post-run output.\n\n    + EXAMPLE:\n      Codex-11 attached to a remote data-mining process's logs and improved the code while mining continued, rather than waiting for the final dataset before learning from the run.\n\n    + EXAMPLE:\n      Claude-4 constructed a queryable progress measure with a ratchet, so the live process can report its present position and cannot silently present a regressed state as progress.\n\n    + COUNTERFACTUAL:\n      A dashboard nobody reads, logs inspected only after completion, a debugger attached without changing an intervention, or a progress number that may freely decrease does not eat the tail. The loop closes only when live self-observation changes action and leaves a stronger observation path behind.\n\n    + evidence:\n      Operator synthesis, Joe, 2026-10-02, names the four cases above and explicitly cautions that the pattern is not guaranteed to succeed. Inbox-zero has repository witnesses: Futon3c commits `66bb1664` (Reazon notifier), `83b9f463` (dirty-but-disjoint fast-forward), `631561f5` and `ef1a3666` (generated-artifact disposition), followed by sweeper-authored projection commits `4007d7aa` in Futon6 and `751b9b12` in Futon3c.\n", :source {:path "futon3/library/agent/eat-your-own-tail.flexiarg", :sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8"}, :situation-source "Pattern part BECAUSE of agent/eat-your-own-tail (warm execution state contains causal information final artifacts discard).", :theory {:elems #{:g}, :names {:g "Feeding warm execution state of the stack into the next improvement shortens the failure–diagnosis–repair interval and preserves the observation path."}, :axioms #{}}}, :I1 {:text "    The agent can observe the process while it runs and can change either the running intervention or the machinery used on subsequent runs.\n", :source {:path "futon3/library/agent/eat-your-own-tail.flexiarg", :sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8"}, :situation-source "The mission's stated goal is a loop that improves the stack itself (title fragment, offsets 11–36), spanning futon3b/2/5a/4/3c/6 components.", :theory {:elems #{:i1}, :names {:i1 "The mission can observe the running futon stack and change the machinery that produces subsequent runs."}, :axioms #{}}}, :I2 {:text "    The usual workflow puts the agent outside the process: wait for completion, inspect a summary, repair the visible result, and declare success. This delays learning until state has gone cold and produces one-off rescues whose evidence never reaches the mechanism that failed. The first useful attempt may still be inefficient; the pattern begins when that failure is routed back into the live apparatus rather than merely remembered.\n", :source {:path "futon3/library/agent/eat-your-own-tail.flexiarg", :sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8"}, :situation-source "The mission instead names itself a loop that 'bootstraps itself' (offsets 97–114), i.e. uses its own running process as input.", :theory {:elems #{:i2}, :names {:i2 "The usual workflow would wait for stack components to finish, inspect summaries, and repair visible results — cold-state rescues whose evidence never feeds back."}, :axioms #{}}}, :B {:text "    Eat the tail in four moves:\n\n    1. Name the process's native live surface: notification, debugger, log stream, progress projection, trace, or invariant trip.\n    2. Attach the responsible agent to that surface before the run ends.\n    3. Let observations from the live run change the next action: patch, probe, reclassify, resume, or stop.\n    4. Preserve the attachment as machinery for the next run, preferably with a ratchet that records the best established state and makes backsliding visible.\n\n    The tail is an observation channel, not a certificate. Keep outcome judgment independent where success could be self-manufactured; use the system's own signals to find and steer the repair, not to waive its acceptance gate.\n", :source {:path "futon3/library/agent/eat-your-own-tail.flexiarg", :sha256 "1634eb791d9953ec6fdd4485e77ec1f2e1719cc7f844249f6a3ea9115ca738f8"}, :situation-source "The title itself: 'The Self-Improvement Loop' (offsets 11–36), with relations ['goal'].", :theory {:elems #{:b}, :names {:b "The mission is constituted as a self-observation channel: a loop whose outputs are changes to the machinery that runs it."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/trail-enables-return" 1], :pattern "agent/trail-enables-return", :roles ["context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-self-improvement-loop/M-self-improvement-loop/policy-1bbcf6a06eb2766b5e77/[\"agent/trail-enables-return\" 1]", :span {:start 48, :end 58}, :source-text-digest "4c99d44c3200d94be835556824b59ab1f027a31c607428839d78723dddee561a", :analysis-digest "27dc8cf394d1c04e3bb6d4a5f5430a40b7e8344744b08b117f7606bccd269112", :source-sha256 "30909dc8a4e083e1c7361955d00bbe4ed418835b9bf0f2bc5e4c5db36d942c28", :square-digest "51ac872b40798a295838da653f3053ccef86330e8c48decdd58f856255e6fe4b"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/trail-enables-return", :objects {:G {:text "    Trails convert ephemeral navigation into persistent structure. They enable learning, debugging, and graceful recovery.\n\n    + evidence: Fulab session exports write `lab/trace/<session-id>.org` and `lab/raw` (`dev/lab-export-claude.clj`), and `fuclaude` supports `--resume`/`--continue` runs.\n", :source {:path "futon3/library/agent/trail-enables-return.flexiarg", :sha256 "30909dc8a4e083e1c7361955d00bbe4ed418835b9bf0f2bc5e4c5db36d942c28"}, :situation-source "Pattern part BECAUSE of agent/trail-enables-return (trails convert ephemeral navigation into persistent structure).", :theory {:elems #{:g}, :names {:g "The dated header converts ephemeral chartering context into persistent, queryable structure."}, :axioms #{}}}, :I1 {:text "    The agent may need to undo actions, revisit prior states, or learn from dead ends.\n", :source {:path "futon3/library/agent/trail-enables-return.flexiarg", :sha256 "30909dc8a4e083e1c7361955d00bbe4ed418835b9bf0f2bc5e4c5db36d942c28"}, :situation-source "The mission header carries an explicit date field, '2026-02-25' (offsets 48–58).", :theory {:elems #{:i1}, :names {:i1 "The mission's record may need to be revisited to recover when the loop was chartered and what state it started from."}, :axioms #{}}}, :I2 {:text "    Without a trail, the agent cannot distinguish \"unexplored\" from \"explored and rejected,\" leading to repeated mistakes or inability to recover.\n", :source {:path "futon3/library/agent/trail-enables-return.flexiarg", :sha256 "30909dc8a4e083e1c7361955d00bbe4ed418835b9bf0f2bc5e4c5db36d942c28"}, :situation-source "The date appears in the persistent mission file (futon5a/holes/missions/M-self-improvement-loop.md), not in session memory.", :theory {:elems #{:i2}, :names {:i2 "Without the dated header, later readers cannot distinguish an active record from an abandoned one of the same name."}, :axioms #{}}}, :B {:text "    Record a trail of moves, decisions, and state transitions with minimal fields (time, state snapshot, decision, action, evidence, reversibility). Make the trail queryable so the agent (or its successors) can backtrack, detect loops, and learn from history.\n", :source {:path "futon3/library/agent/trail-enables-return.flexiarg", :sha256 "30909dc8a4e083e1c7361955d00bbe4ed418835b9bf0f2bc5e4c5db36d942c28"}, :situation-source "The fragment '**Date:** 2026-02-25' in the mission's opening block.", :theory {:elems #{:b}, :names {:b "The mission records its charter date as a minimal trail field."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/sense-deliberate-act" 2], :pattern "agent/sense-deliberate-act", :roles ["context" "goal"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-self-improvement-loop/M-self-improvement-loop/policy-1bbcf6a06eb2766b5e77/[\"agent/sense-deliberate-act\" 2]", :span {:start 78, :end 115}, :source-text-digest "4c99d44c3200d94be835556824b59ab1f027a31c607428839d78723dddee561a", :analysis-digest "27dc8cf394d1c04e3bb6d4a5f5430a40b7e8344744b08b117f7606bccd269112", :source-sha256 "8e8889947713cf92ac48c6c37e1fa55b1ef40157540475199f5ec6d993edfdd9", :square-digest "ffc2176b0cb1d0acdfe41f0c8561fb865fcbf40e5d3de641f4d50e9967119f7b"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/sense-deliberate-act", :objects {:G {:text "    The three-phase structure prevents both impulsive drift and endless deliberation, and makes the agent's reasoning inspectable at phase boundaries.\n\n    + evidence: Fulab HUD prompts force deliberate candidate review before acting (`src/futon3/fulab/hud.clj`), and the session report tracks selection and outcome phases (`dev/lab-session-report.clj`).\n", :source {:path "futon3/library/agent/sense-deliberate-act.flexiarg", :sha256 "8e8889947713cf92ac48c6c37e1fa55b1ef40157540475199f5ec6d993edfdd9"}, :situation-source "Pattern part BECAUSE of agent/sense-deliberate-act (the three-phase structure prevents both impulsive drift and endless deliberation).", :theory {:elems #{:g}, :names {:g "Explicit, bounded phases make the loop's reasoning inspectable at phase boundaries."}, :axioms #{}}}, :I1 {:text "    The agent needs to make progress on a goal while responding to a changing environment.\n", :source {:path "futon3/library/agent/sense-deliberate-act.flexiarg", :sha256 "8e8889947713cf92ac48c6c37e1fa55b1ef40157540475199f5ec6d993edfdd9"}, :situation-source "The mission is open across two phases simultaneously, IDENTIFY and DERIVE (offsets 78–96).", :theory {:elems #{:i1}, :names {:i1 "The mission must progress on improving the stack while the stack keeps changing under it."}, :axioms #{}}}, :I2 {:text "    Rushing to act without sensing leads to blind thrashing; sensing without acting leads to analysis paralysis; acting without deliberation leads to incoherent behavior.\n", :source {:path "futon3/library/agent/sense-deliberate-act.flexiarg", :sha256 "8e8889947713cf92ac48c6c37e1fa55b1ef40157540475199f5ec6d993edfdd9"}, :situation-source "The status line holds both phases together rather than collapsing to one (fragment 'IDENTIFY + DERIVE ...').", :theory {:elems #{:i2}, :names {:i2 "Deriving fixes without first identifying the stack's live state would be blind thrashing; identifying without ever deriving would be analysis paralysis."}, :axioms #{}}}, :B {:text "    Enforce a rhythm: first gather relevant observations, then weigh options against goals and constraints, then commit to a single action before the next cycle. Make each phase explicit and bounded, and check scope, budget, and confidence gates at phase boundaries.\n", :source {:path "futon3/library/agent/sense-deliberate-act.flexiarg", :sha256 "8e8889947713cf92ac48c6c37e1fa55b1ef40157540475199f5ec6d993edfdd9"}, :situation-source "The fragment 'IDENTIFY + DERIVE (bootstraps itself)' (offsets 78–115).", :theory {:elems #{:b}, :names {:b "The mission declares its phase state explicitly and commits to bootstrapping from its own output as the next cycle's input."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agency/self-attribution" 3], :pattern "agency/self-attribution", :roles ["condition"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-self-improvement-loop/M-self-improvement-loop/policy-1bbcf6a06eb2766b5e77/[\"agency/self-attribution\" 3]", :span {:start 132, :end 179}, :source-text-digest "4c99d44c3200d94be835556824b59ab1f027a31c607428839d78723dddee561a", :analysis-digest "27dc8cf394d1c04e3bb6d4a5f5430a40b7e8344744b08b117f7606bccd269112", :source-sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f", :square-digest "612d0f7b2a48215d974b9ae711a3ee9bf3b2cedb987deb95221565236dc5a2a6"}, :square {:schema :wm/three-halves-square-v1, :pattern "agency/self-attribution", :objects {:G {:text "    Proxy posting breaks the audit trail. When output appears under agent X's identity but was posted by the server, you cannot distinguish between \"X said this\" and \"the server said X said this.\" In incident review, this ambiguity makes root cause analysis unreliable. A meeting transcript where one person takes notes for everyone is not the same as each person signing their own statement.\n\n    + EVIDENCE (repo history):\n      - 2026-02-08 169c4bc: /agency/standup initially implemented as \"whistle all agents and collect responses\", putting the server in the position to relay agent content as an intermediary.\n      - 2026-02-08 9acf154: standup redesign explicitly rejects the prior proxy approach as an identity violation and moves to \"agent self-reporting\": each agent acks, invokes itself, and posts to MUSN under its own identity.\n      - 2026-01-31 b2fbb84: mission notes define the first principle that Agency is a continuity layer, not \"the agent itself\", which aligns with self-attribution (coordination vs content authorship).\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "Pattern part BECAUSE of agency/self-attribution (proxy or ambiguous ownership breaks the audit trail).", :theory {:elems #{:g}, :names {:g "Naming the principal keeps the audit trail: 'Joe owns this' stays distinguishable from 'someone worked on this'."}, :axioms #{}}}, :I1 {:text "    You need an agent's output to appear in a shared channel (IRC, MUSN, forum).\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "The mission file is a shared document read by every seat in the workspace.", :theory {:elems #{:i1}, :names {:i1 "The mission's ownership must be attributable in the shared mission record."}, :axioms #{}}}, :I2 {:text "    The server has access to agent identities and could post on their behalf, making the code simpler. But this creates false attribution: the message appears to come from the agent, but the agent never authored or approved it. If the agent's invocation returned an error, the server might post the error as if the agent said it. If the server's MUSN post fails, the agent has no way to know its update was lost.\n\n    + ANTI-PATTERNS:\n      - Server collects whistle responses and POSTs to MUSN as each agent\n      - Server registers a context-free subprocess under an existing agent's identity\n      - Server reformats or summarizes agent output before posting it as the agent\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "The fragment defuses this explicitly: 'this is the one mission that can't be delegated' (offsets 132–179).", :theory {:elems #{:i2}, :names {:i2 "Leaving ownership implicit would let any seat pick the mission up as if authorized — a false attribution of principal intent."}, :axioms #{}}}, :B {:text "    The server's role is coordination, not content relay:\n    1. The server creates the rendezvous, sends the bell, tracks acks.\n    2. Each agent independently generates its output and posts it under its own identity.\n    3. The server may post as \"agency\" (its own identity) for announcements.\n    4. If an agent cannot post (no MUSN access, transport failure), the failure is attributed to the agent, not hidden by the server.\n    This applies to all output channels: MUSN, forum, IRC, CRDT documents.\n", :source {:path "futon3/library/agency/self-attribution.flexiarg", :sha256 "feeb7236d5ea0c61a81edbf3ae7eef0a67c9904c595b5053e89399193366ef4f"}, :situation-source "The fragment '**Owner:** Joe (this is the one mission that can't be delegated)'.", :theory {:elems #{:b}, :names {:b "The mission records its owner and the no-delegation condition in the opening block."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/scope-before-action" 4], :pattern "agent/scope-before-action", :roles ["condition"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-self-improvement-loop/M-self-improvement-loop/policy-1bbcf6a06eb2766b5e77/[\"agent/scope-before-action\" 4]", :span {:start 197, :end 225}, :source-text-digest "4c99d44c3200d94be835556824b59ab1f027a31c607428839d78723dddee561a", :analysis-digest "27dc8cf394d1c04e3bb6d4a5f5430a40b7e8344744b08b117f7606bccd269112", :source-sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea", :square-digest "612266e08a0febd2521f807807bb9dfcfd9ce773fcce4b65c97a519e651b1246"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/scope-before-action", :objects {:G {:text "    Declared scope makes progress measurable, side effects auditable, and completion definable. It also protects the broader system from unintended changes.\n\n    + evidence: Fulab HUD prompts require a pre-action plan (`src/futon3/fulab/hud.clj`), and scope boundaries are spelled out in `CLAUDE.md`.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "Pattern part BECAUSE of agent/scope-before-action (declared scope makes progress measurable and completion definable).", :theory {:elems #{:g}, :names {:g "Declaring no blockers and a start date makes the mission's progress measurable from a defined point."}, :axioms #{}}}, :I1 {:text "    The agent needs to make progress that can be verified and bounded.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "The status block declares an entry state before any body work (opening lines of the mission).", :theory {:elems #{:i1}, :names {:i1 "The mission needs bounded, verifiable entry into work."}, :axioms #{}}}, :I2 {:text "    Without declared scope, \"done\" is undefined, side effects are unpredictable, and observers cannot tell if the agent is on track or wandering.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "The fragment states both explicitly: '**Blocked by:** Nothing — starts this Sunday' (offsets 197–225).", :theory {:elems #{:i2}, :names {:i2 "Without declaring blockers and a start point, 'started' is undefined and observers cannot tell whether the mission is moving."}, :axioms #{}}}, :B {:text "    Before substantive action, state the scope: what files, concepts, or regions are in-bounds; what is explicitly out-of-bounds; what the exit condition is. Treat scope violations as requiring explicit expansion, not silent drift. Scope defines the territory; budgets and pauses govern what happens inside it.\n", :source {:path "futon3/library/agent/scope-before-action.flexiarg", :sha256 "19be8fbd261bcc722d7feea2af7d84206e7e37c83b5de360ed2936a109ad60ea"}, :situation-source "The fragment itself, with relations ['condition'].", :theory {:elems #{:b}, :names {:b "The mission records its entry condition — no blockers, start this Sunday — before substantive action."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/handoff-preserves-context" 5], :pattern "agent/handoff-preserves-context", :roles ["context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-self-improvement-loop/M-self-improvement-loop/policy-1bbcf6a06eb2766b5e77/[\"agent/handoff-preserves-context\" 5]", :span {:start 226, :end 240}, :source-text-digest "4c99d44c3200d94be835556824b59ab1f027a31c607428839d78723dddee561a", :analysis-digest "27dc8cf394d1c04e3bb6d4a5f5430a40b7e8344744b08b117f7606bccd269112", :source-sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3", :square-digest "8c3f7d19372634ae62cc7a4720d246921685568b20550200c4630a59bf727909"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/handoff-preserves-context", :objects {:G {:text "    Handoffs convert ephemeral session state into persistent project state. They enable distributed and asynchronous work without context collapse.\n\n    + evidence: Fulab exports session context to `lab/raw`, `lab/stubs`, and `lab/trace` (`dev/lab-export-claude.clj`), plus summaries via `fulab-summary` and `fulab-session-report`.\n", :source {:path "futon3/library/agent/handoff-preserves-context.flexiarg", :sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3"}, :situation-source "Pattern part BECAUSE of agent/handoff-preserves-context (handoffs convert ephemeral session state into persistent project state).", :theory {:elems #{:g}, :names {:g "The cross-ref block converts the loop's stack-wide context into persistent project state."}, :axioms #{}}}, :I1 {:text "    Continuity matters: the work is incremental, context is expensive to rebuild, or progress would be lost.\n", :source {:path "futon3/library/agent/handoff-preserves-context.flexiarg", :sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3"}, :situation-source "The cross-ref list names futon3b, futon2, futon5a/P0-P2, futon4, futon3c and futon6 (offsets 226–426).", :theory {:elems #{:i1}, :names {:i1 "The loop's work is incremental across six stack components; its context is expensive to rebuild."}, :axioms #{}}}, :I2 {:text "    Without explicit handoff, successors face cold starts: they repeat discoveries, miss constraints, or contradict prior decisions.\n", :source {:path "futon3/library/agent/handoff-preserves-context.flexiarg", :sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3"}, :situation-source "The '**Cross-ref:**' header (offsets 226–240) exists precisely to carry that list.", :theory {:elems #{:i2}, :names {:i2 "Without the cross-reference list, a successor reading the mission would cold-start and miss which stack components the loop touches."}, :axioms #{}}}, :B {:text "    Define a handoff record that captures: current state hypothesis, decisions made and why, open questions, scope boundaries, next actions, evidence/trail anchors, and any provisional-claim ledger. Emit it at session end or when transferring to another agent.\n", :source {:path "futon3/library/agent/handoff-preserves-context.flexiarg", :sha256 "403a43dfe0b4ae903c1e7ca249ffe8b43715b998b27262f75b3168028a0f3bb3"}, :situation-source "The '**Cross-ref:**' header and the component list that follows it.", :theory {:elems #{:b}, :names {:b "The mission defines a handoff record: a cross-reference header enumerating every related component."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/state-is-hypothesis" 6], :pattern "agent/state-is-hypothesis", :roles ["dependency"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-self-improvement-loop/M-self-improvement-loop/policy-1bbcf6a06eb2766b5e77/[\"agent/state-is-hypothesis\" 6]", :span {:start 324, :end 358}, :source-text-digest "4c99d44c3200d94be835556824b59ab1f027a31c607428839d78723dddee561a", :analysis-digest "27dc8cf394d1c04e3bb6d4a5f5430a40b7e8344744b08b117f7606bccd269112", :source-sha256 "3cc0d9eaa1559da2f4f329040753c58bf3c5426b92c9884670ecc6102f0c6f5c", :square-digest "861ba53c3a4c7060d8d65c065072c9cec962a20c5b75b3b0d8335d7276ab95c7"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/state-is-hypothesis", :objects {:G {:text "    Hypothesis-framed state makes the agent self-correcting: surprises trigger learning rather than denial or breakdown.\n\n    + evidence: Fulab PSR forecasts in `src/futon3/fulab/pattern_competence.clj` and belief updates in `dev/lab-session-report.clj` treat state as revisable (prediction error, tau updates).\n", :source {:path "futon3/library/agent/state-is-hypothesis.flexiarg", :sha256 "3cc0d9eaa1559da2f4f329040753c58bf3c5426b92c9884670ecc6102f0c6f5c"}, :situation-source "Pattern part BECAUSE of agent/state-is-hypothesis (hypothesis-framed state makes the agent self-correcting).", :theory {:elems #{:g}, :names {:g "A revisable self-model makes the loop self-correcting: surprises in the stack trigger updates rather than breakdown."}, :axioms #{}}}, :I1 {:text "    The agent needs to act under uncertainty and update its understanding as new information arrives.\n", :source {:path "futon3/library/agent/state-is-hypothesis.flexiarg", :sha256 "3cc0d9eaa1559da2f4f329040753c58bf3c5426b92c9884670ecc6102f0c6f5c"}, :situation-source "The mission cites the self-representing stack mission in futon4 as a cross-ref (offsets 324–358).", :theory {:elems #{:i1}, :names {:i1 "The loop must act on its model of the futon stack while that stack keeps changing."}, :axioms #{}}}, :I2 {:text "    Treating state as certain leads to brittleness when observations contradict expectations; the agent either ignores evidence or fails catastrophically.\n", :source {:path "futon3/library/agent/state-is-hypothesis.flexiarg", :sha256 "3cc0d9eaa1559da2f4f329040753c58bf3c5426b92c9884670ecc6102f0c6f5c"}, :situation-source "The cited component is literally a self-representing stack — a maintained model, not a fixed fact.", :theory {:elems #{:i2}, :names {:i2 "Treating the stack's self-model as certain would break the loop when the stack's actual behavior contradicts it."}, :axioms #{}}}, :B {:text "    Represent state as revisable hypotheses with associated confidence. When observations conflict with state, update the hypothesis rather than defending it. Track what would falsify current beliefs.\n", :source {:path "futon3/library/agent/state-is-hypothesis.flexiarg", :sha256 "3cc0d9eaa1559da2f4f329040753c58bf3c5426b92c9884670ecc6102f0c6f5c"}, :situation-source "The fragment 'M-self-representing-stack (futon4)' with relations ['dependency'].", :theory {:elems #{:b}, :names {:b "The loop treats the stack's representation as a hypothesis to update, wired through the futon4 self-representing-stack touchpoint."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/budget-bounds-exploration" 7], :pattern "agent/budget-bounds-exploration", :roles ["dependency"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-self-improvement-loop/M-self-improvement-loop/policy-1bbcf6a06eb2766b5e77/[\"agent/budget-bounds-exploration\" 7]", :span {:start 360, :end 388}, :source-text-digest "4c99d44c3200d94be835556824b59ab1f027a31c607428839d78723dddee561a", :analysis-digest "27dc8cf394d1c04e3bb6d4a5f5430a40b7e8344744b08b117f7606bccd269112", :source-sha256 "af17d183b9b9079e0084d4ff36d5ccf06cafe9eafd0c2672d2180e1273a1b806", :square-digest "33d27611c9bf970ea8f29d8b188f91c4676a19f2ca63a29eedaefe8f7bb91bb2"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/budget-bounds-exploration", :objects {:G {:text "    Budgets convert open-ended search into bounded decisions, making progress measurable and preventing silent resource drain.\n\n    + evidence: `fuclaude` enforces `--explore-limit`, and `src/futon3/fulab/hud.clj` caps candidates with `pattern-limit`.\n", :source {:path "futon3/library/agent/budget-bounds-exploration.flexiarg", :sha256 "af17d183b9b9079e0084d4ff36d5ccf06cafe9eafd0c2672d2180e1273a1b806"}, :situation-source "Pattern part BECAUSE of agent/budget-bounds-exploration (budgets convert open-ended search into bounded decisions).", :theory {:elems #{:g}, :names {:g "Budgeting the exploratory phases makes the loop's progress measurable and prevents silent resource drain."}, :axioms #{}}}, :I1 {:text "    The agent must balance discovering new possibilities against making progress on known paths.\n", :source {:path "futon3/library/agent/budget-bounds-exploration.flexiarg", :sha256 "af17d183b9b9079e0084d4ff36d5ccf06cafe9eafd0c2672d2180e1273a1b806"}, :situation-source "The mission cites the futon3c last-mile mission as a touchpoint (offsets 360–388).", :theory {:elems #{:i1}, :names {:i1 "The loop must balance discovering improvements across the stack against finishing known last-mile work."}, :axioms #{}}}, :I2 {:text "    Unbounded exploration leads to wander: the agent keeps looking without ever committing, exhausting resources without output.\n", :source {:path "futon3/library/agent/budget-bounds-exploration.flexiarg", :sha256 "af17d183b9b9079e0084d4ff36d5ccf06cafe9eafd0c2672d2180e1273a1b806"}, :situation-source "The cross-ref pairs a six-component exploration surface with a mission explicitly named 'last-mile' — bounded completion work.", :theory {:elems #{:i2}, :names {:i2 "Unbounded exploration of the whole stack would starve the bounded last-mile obligations of attention and resources."}, :axioms #{}}}, :B {:text "    Assign explicit budgets (time, steps, tokens, reads) to exploratory phases and define reset rules. When budget nears exhaustion, force a decision: commit to best-so-far, escalate to a supervisor, or explicitly expand scope with justification.\n", :source {:path "futon3/library/agent/budget-bounds-exploration.flexiarg", :sha256 "af17d183b9b9079e0084d4ff36d5ccf06cafe9eafd0c2672d2180e1273a1b806"}, :situation-source "The fragment 'M-futon3-last-mile (futon3c)' in the cross-ref list, with relations ['dependency'].", :theory {:elems #{:b}, :names {:b "The loop keeps the last-mile scope