{:request-enrichment {:production-functions [{:role :selection-entrypoint, :var "futon2.aif.full-loop-runner/strategic-selection!", :file "src/futon2/aif/full_loop_runner.clj", :resolvable? true, :arglists "([opts request])", :doc "Request the cache-gated reason-bearing selector, with two delayed retries\n   for TRANSIENT failures only (see selection-failure-class): a deterministic\n   rejection fails fast with :failure-detail :deterministic-rejection instead\n   of replaying the identical request across the ladder. Either terminal\n   throw carries :attempt-failures, one typed summary per failed attempt.\n\n   The default bridge uses HTTP so Futon2 keeps no source dependency on\n   Futon3c. :strategic-selection-invoke-fn replaces only that bridge: it is\n   called with the identical request map and returns the parsed endpoint body\n   {:ok true :selection {...}}. Both paths share the retry ladder. A success\n   after the first "} {:role :required-loop-node-evaluator, :var "futon2.aif.wm.loop-node-exercise/require-complete!", :file "src/futon2/aif/wm/loop_node_exercise.clj", :resolvable? true, :arglists "([decision])", :doc "Compatibility entry point: annotate DECISION with measured node exercise.\n  Under the 2026-10-19 frontier ruling, missing evidence is not a veto.\n  :refused counts remain evidence of absence, never a claim of exercise."} {:role :terminal-routing-entrypoint, :var "futon2.aif.wm.terminal-receipt/terminal-receipt", :file "src/futon2/aif/wm/terminal_receipt.clj", :resolvable? true, :arglists "([record])", :doc "The one terminal receipt for RECORD, validated. A record whose\n  :selection-event says :cascade-selected and which carries no failure and\n  no abstention gets an :action-receipt. Every other record gets a :failure:\n  an abstention, a failure after selection (the receipt names the target),\n  or a record showing neither a selection nor a failure\n  (:no-terminal-state, itself a defect to repair). The RECEIPT is exactly\n  one kind; the record's state never makes this throw (review, claude-1\n  2026-09-30: 35 of 63 past records were both or neither, and a throw here\n  would have left their run records unwritten)."}], :test-harness {:note "Isolated real-input harness the existing acceptance-style tests use (test classpath). The test may use it; nothing else is stubbed.", :entrypoints [{:role :isolated-environment, :var "futon2.aif.meta-self-heal-harness/prepare-environment!", :file "src/futon2/aif/meta_self_heal_harness.clj", :resolvable? true, :arglists "([root])", :doc nil} {:role :isolated-runner-options, :var "futon2.test-support.runner-fixture/isolated-runner-opts", :file "test/futon2/test_support/runner_fixture.clj", :resolvable? true, :arglists "([])", :doc nil} {:role :hermetic-traces, :var "futon2.test-support.runner-fixture/with-hermetic-traces", :file "test/futon2/test_support/runner_fixture.clj", :resolvable? true, :arglists "([f])", :doc "Temporary trace, run-record, learning-ledger, morning-brief and meta-injury\n  roots for a runner test namespace, and a check that the production trace,\n  brief and injury file sets did not change. A futon3c test that drove the\n  runner without this fixture wrote two fixture ticks into the live trace on\n  2026-09-28; on 2026-10-19 four fixture runs wrote injury records and HEAD.edn\n  into data/wm-meta-injuries because this fixture left the injury root live."} {:role :loop-exercise-evidence, :var "futon2.test-support.runner-fixture/with-loop-exercise-evidence", :file "test/futon2/test_support/runner_fixture.clj", :resolvable? true, :arglists "([ranked-entry])", :doc "Augment an existing selector entry at the real loop-evidence field without\n  reconstructing its certificate. In particular, parameter-novelty and other\n  independently produced certificate fields remain byte/field-identical."}], :examples ["test/futon2/aif/meta_self_heal_production_test.clj" "test/futon2/aif/p37_reading_preparation_runtime_test.clj" "test/futon2/test_support/runner_fixture_test.clj"]}, :real-input-authority {:source-record {:path "/home/joe/code/futon2/data/wm-runs/tick-run-record-2026-10-29-5ba921b9-0431-4b85-95a7-6606a01111b8.edn", :sha256 "5b53bad4a0c243fec48e928930d708f5729212335a70f6b0a6f73e1d671e0d2b"}, :injury-ledger "/home/joe/code/futon2/data/wm-meta-injuries-live-2026-10-22/ledger.edn", :note "read-only in the test; isolated copies via the harness"}, :persistence-destination {:note "the test writes only under the harness's temporary roots; canonical data/ and src/ are read-only"}, :repository "/home/joe/code/futon2"}, :schema :wm/meta-acceptance-receipt-v1, :repair-claimed? false, :acceptance-test {:id "f7e97cc6-executed-review-store-evidence-counts", :command ["clojure" "-M:test" "-n" "futon2.aif.meta-acceptance-injury-f7e97cc6-test"], :expected {:exit 0}, :source {:namespace "futon2.aif.meta-acceptance-injury-f7e97cc6-test", :path "test/futon2/aif/meta_acceptance_injury_f7e97cc6_test.clj", :sha256 "29e80714dd0cc15df4dff56807fbf096ed4b2dfdc83f42a3c010e198f99a7f84", :text "(ns futon2.aif.meta-acceptance-injury-f7e97cc6-test\n  \"Acceptance pin for injury/f7e97cc6653b45dda8b492c7e9c7a288a1289831\n   (tick-run-record-2026-10-29-5ba921b9-0431-4b85-95a7-6606a01111b8.edn,\n   sha256 5b53bad4a0c243fec48e928930d708f5729212335a70f6b0a6f73e1d671e0d2b).\n\n   The injury: at :reviewer-wait on target M-reachable-from-boot (commit\n   b7ca069d599778f7c55488ea2514842c1c87b54f) the reviewer returned\n   FULL_LOOP_REVIEW: APPROVE after real repository checks, but the\n   reviewer-falsifier receipt came back :refused — verification returned\n   {:status :refused :reason :reviewer-falsifier-applicable-check-failed}\n   (receipt/id 20b72c422191fdec26e1a0792e5f07f4151b2ca73731dcbe7ec5ca4fede880d1)\n   — and the run closed :build-failed :failure-kind :reviewer-falsifier-failed.\n   The refusing check is :review-execution: the review-execution gate counts\n   tool events only from the job's reported :execution counters and :events\n   ledger, and the reviewer's actual evidence-store interactions were\n   reported as zero tool events because the evidence-store script's grep\n   pattern `[a-z./-]*!store` lacks digits, so the fully-qualified var\n   `futon3c.evidence.store/!store` escaped detection (only alias forms are\n   caught). A genuinely executed code-file review was therefore gated\n   :passed? false, :failure-kind :review-execution-evidence-missing.\n\n   The repaired contract this test pins: a review job for code files whose\n   own retained record shows executed evidence-store invocations naming the\n   fully-qualified var `futon3c.evidence.store/!store` counts as executed\n   tool evidence — the review-execution gate passes, the reviewer-falsifier\n   receipt reconstructs as :verified (its :review-execution check passes),\n   and terminal-receipt routes the approved close as exactly one\n   :action-receipt rather than the injured :failure/:reviewer-falsifier-failed.\n\n   Pre-repair failures are exactly the injury's reason (first acceptance run\n   log f7e97cc6-executed-review-store-evidence-counts-2026-10-29T21-18-25:\n   gate :passed? false/:review-execution-evidence-missing and falsifier\n   :refused/:review-execution failed on the injured seam; the two errors and\n   the extra-checks failure in that run were defects of the first proposal's\n   own fixtures and are fixed here — this proposal asserts nothing else that\n   injured code fails).\n\n   No stubs: the entrypoints exercised are the real production functions\n   futon2.aif.full-loop-runner/strategic-selection! (selection entrypoint,\n   driven through :strategic-selection-invoke-fn, the production injection\n   seam named in its own docstring, replaying the pinned selection shape —\n   one attempt, no retries, no network; phase-replay pins are redirected to\n   a temporary root), futon2.aif.wm.loop-node-exercise/require-complete!\n   (required-loop-node evaluator) and\n   futon2.aif.wm.terminal-receipt/terminal-receipt (terminal-routing\n   entrypoint), with the gate and falsifier the diagnosis names\n   (futon2.aif.task-execution-evidence/review-execution-gate,\n   futon2.aif.reviewer-falsifier/receipt and /verify) at their real seams.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [futon2.aif.full-loop-runner :as runner]\n            [futon2.aif.task-execution-evidence :as task-execution]\n            [futon2.aif.reviewer-falsifier :as reviewer-falsifier]\n            [futon2.aif.wm.loop-node-exercise :as loop-node-exercise]\n            [futon2.aif.wm.terminal-receipt :as terminal-receipt])\n  (:import [java.nio.file Files]\n           [java.nio.file.attribute FileAttribute]))\n\n(def ^:const injury-id \"injury/f7e97cc6653b45dda8b492c7e9c7a288a1289831\")\n\n(def ^:const target \"M-reachable-from-boot\")\n\n(def ^:const commit \"b7ca069d599778f7c55488ea2514842c1c87b54f\")\n\n(def ^:const click-id \"wm-click-b4e9ea0e-b40c-47f7-977c-f0e15f24d99f\")\n\n(def ^:const run-id \"2026-10-29-5ba921b9-0431-4b85-95a7-6606a01111b8\")\n\n(def ^:const refused-receipt-id\n  \"20b72c422191fdec26e1a0792e5f07f4151b2ca73731dcbe7ec5ca4fede880d1\")\n\n(def reviewed-code-files\n  \"The changed code files the reviewer of record checked (code-file-pattern\n  makes these :required? at the gate).\"\n  [\"src/futon3c/evidence/store.clj\"])\n\n(def reviewer-job\n  \"The injured review job's shape, from the pinned record: state done, an\n  APPROVE verdict whose retained record names the fully-qualified store var\n  the reviewer really called, reported execution claiming :executed true but\n  zero counted tool events (the upstream grep `[a-z./-]*!store` lacks\n  digits, so `futon3c.evidence.store/!store` escaped detection), and an\n  empty events ledger. This is exactly the input on which the injured gate\n  said :review-execution-evidence-missing for a genuinely executed review.\"\n  {:agent-id \"wm-reviewer\"\n   :caller \"wm-full-loop\"\n   :job-id \"invoke-1793307618205-7746-83685c15\"\n   :state \"done\"\n   :result-summary\n   (str \"FULL_LOOP_REVIEW: APPROVE FULL_LOOP_REVIEWER_NOTE: evidence-store \"\n        \"script's grep pattern `[a-z./-]*!store` lacks digits, so \"\n        \"fully-qualified `futon3c.evidence.store/!store` escapes detection \"\n        \"(alias forms are caught); pr...\")\n   :result\n   (str \"FULL_LOOP_REVIEW: APPROVE\\n\"\n        \"Executed store checks against the pinned revision:\\n\"\n        \"  futon3c.evidence.store/!store :db-propose {:entity :checklist-item-65}\\n\"\n        \"  futon3c.evidence.store/!store :db-say {:entity :checklist-item-66}\\n\")\n   :execution {:executed true :tool-events 0 :command-events 0}\n   :events []})\n\n(def unexecuted-reviewer-job\n  \"Guard input: an approve verdict with NO execution evidence anywhere —\n  not counted, not reported, not named in the retained record. The repair\n  must not start passing these.\"\n  (-> reviewer-job\n      (assoc :result \"FULL_LOOP_REVIEW: APPROVE\")\n      (assoc :result-summary \"FULL_LOOP_REVIEW: APPROVE\")\n      (assoc :execution {:executed false :tool-events 0 :command-events 0})))\n\n(defn- isolated-opts []\n  {:click-id click-id\n   :phase-replay-input-root\n   (.getCanonicalPath\n    (.toFile (Files/createTempDirectory \"wm-f7e97cc6-replay-\"\n                                        (make-array FileAttribute 0))))\n   :strategic-selection-timeout-ms 5000\n   :strategic-selection-invoke-fn\n   (fn [_request]\n     {:ok true\n      :selection {:status \"selected\"\n                  :target target\n                  :actuation {:status \"enacted\" :authority \"runner\"}}})})\n\n(defn- delete-tree [^java.io.File file]\n  (when (.isDirectory file)\n    (doseq [child (reverse (file-seq file))] (.delete child)))\n  (.delete file))\n\n(defn- falsifier-inputs\n  \"Canonical reviewer-falsifier inputs for this injury's close: ordinary\n  cascade work, verified want outcomes measured authoritatively at the\n  pinned commit, resolved disposition, a corroborating artifact binding, and\n  REVIEW-GATE as the only varying input.\"\n  [review-gate]\n  {:target target\n   :commit commit\n   :mission-standing {:status :consistent\n                      :source \"mission/declarations\"\n                      :declarations []}\n   :work-evidence {:kind :ordinary-cascade}\n   :selected-want-outcomes\n   {:status :verified\n    :receipt/id \"outcome-f7e97cc6\"\n    :target target\n    :selected-wants []\n    :outcomes\n    [{:classification :reached\n      :after\n      {:measurement\n       {:result {:observed true\n                 :evidence {:resolved-sha commit\n                            :repo \"futon3c\"\n                            :path \"src/futon3c/evidence/store.clj\"}}\n        :after-locator {:sha commit}}}}]}\n   :disposition :resolved\n   :artifact-binding {:repo \"futon3c\"\n                      :commit commit\n                      :pre-dispatch-head\n                      \"415e94ba068e2b98db283220ca4efcf741b62c67\"\n                      :observed-head commit\n                      :corroborates? true}\n   :review-gate review-gate})\n\n(deftest selection-entrypoint-replays-the-pinned-selection\n  (testing \"strategic-selection! (selection-entrypoint) returns the selector's recorded choice for this click\"\n    (let [opts (isolated-opts)\n          replay-root (java.io.File. (:phase-replay-input-root opts))]\n      (try\n        (let [selection (runner/strategic-selection! opts\n                                                     {:click/id click-id})]\n          (is (map? selection))\n          (is (= :selected (:status selection)))\n          (is (= target (:target selection)))\n          (is (= :enacted (get-in selection [:actuation :status]))))\n        (finally\n          (delete-tree replay-root))))))\n\n(deftest required-loop-node-evaluator-annotates-the-decision\n  (testing \"loop-node-exercise/require-complete! (required-loop-node-evaluator) annotates without vetoing\"\n    (let [annotated (loop-node-exercise/require-complete!\n                     {:selection-certificate\n                      {:selected-outer-cascade-policy\n                       {:selected-entry\n                        {:class-emission {:model {:horizon 2}}}}}})\n          exercise (get-in annotated\n                           [:selection-certificate :loop-node-exercise])]\n      (is (map? exercise))\n      (is (= :wm/loop-node-exercise-v1 (:schema exercise)))\n      (is (contains? #{:complete :incomplete} (:status exercise))))))\n\n(deftest executed-review-counts-its-fully-qualified-store-evidence\n  (testing \"the injury's exact review job passes the review-execution gate (injury f7e97cc6653b45dda8b492c7e9c7a288a1289831)\"\n    (let [gate (task-execution/review-execution-gate reviewed-code-files\n                                                     reviewer-job)]\n      (is (true? (:required? gate))\n          \"a code-file review requires execution evidence\")\n      (is (true? (:passed? gate))\n          (str \"injured code returns :passed? false with \"\n               \":failure-kind :review-execution-evidence-missing here, because \"\n               \"the reviewer's real `futon3c.evidence.store/!store` calls \"\n               \"escaped the upstream digit-less grep `[a-z./-]*!store`; a \"\n               \"genuinely executed review whose retained record names its \"\n               \"fully-qualified store invocations must count as executed\"))\n      (is (nil? (:failure-kind gate))))))\n\n(deftest falsifier-verified-receipt-for-the-executed-review\n  (testing \"reviewer-falsifier receipt reconstructs :verified and verify accepts it\"\n    (let [gate (task-execution/review-execution-gate reviewed-code-files\n                                                     reviewer-job)\n          inputs (falsifier-inputs gate)\n          receipt (reviewer-falsifier/receipt inputs)]\n      (is (= :verified (:status receipt))\n          (str \"injured code refuses this receipt \"\n               \"(:status :refused, :reason \"\n               \":reviewer-falsifier-applicable-check-failed, receipt/id \"\n               refused-receipt-id \" shape) because the gate undercounts the \"\n               \"reviewer's tool events\"))\n      (is (= :pass (get-in receipt [:checks :review-execution :status])))\n      (is (= [] (:failed-checks receipt)))\n      (is (= :verified\n             (:status (reviewer-falsifier/verify receipt inputs)))))))\n\n(deftest falsifier-still-refuses-a-genuinely-unexecuted-review\n  (testing \"the unchanged falsifier still refuses a review with no execution evidence at all\"\n    (let [gate (task-execution/review-execution-gate reviewed-code-files\n                                                     unexecuted-reviewer-job)\n          inputs (falsifier-inputs gate)\n          receipt (reviewer-falsifier/receipt inputs)]\n      (is (= :refused (:status receipt)))\n      (is (= [:review-execution] (:failed-checks receipt))\n          \"the repair must not start passing reviews with no execution evidence\")\n      (is (= :refused\n             (:status (reviewer-falsifier/verify receipt inputs)))))))\n\n(deftest terminal-routing-emits-exactly-one-receipt-per-close\n  (testing \"terminal-receipt (terminal-routing-entrypoint) routes the repaired close as one :action-receipt\"\n    (let [record {:run/id run-id\n                  :startedAt \"2026-10-29T20:58:51Z\"\n                  :click/id click-id\n                  :selection-event {:event :cascade-selected :target target}\n                  :outcome :built\n                  :decision {:selection-law\n                             {:per-policy-argmax {:action target}}\n                             :selection-certificate\n                             {:scoring {target {:id target :g 1.6584289225641886\n                                                :g-terms {:base 1.6}}}}}\n                  :grounded-commit {:repo \"futon3c\" :sha commit}}\n          receipt (terminal-receipt/terminal-receipt record)]\n      (is (= :action-receipt (:kind receipt)))\n      (is (= click-id (:click-id receipt)))\n      (is (= target (:target receipt)))\n      (is (= :mission (:target-kind receipt)))\n      (is (= :built (:outcome receipt)))))\n  (testing \"and the injured close shape routes as the injury's :failure receipt\"\n    (let [record {:run/id run-id\n                  :startedAt \"2026-10-29T21:01:46Z\"\n                  :click/id click-id\n                  :selection-event {:event :cascade-selected :target target}\n                  :failure {:kind :reviewer-falsifier-failed\n                            :detail {:failure-stage :reviewer-wait}}}\n          receipt (terminal-receipt/terminal-receipt record)]\n      (is (= :failure (:kind receipt)))\n      (is (= :reviewer-falsifier-failed (:failure-kind receipt)))\n      (is (= target (:target receipt))))))\n"}}, :source-record-pin {:path "/home/joe/code/futon2/data/wm-runs/tick-run-record-2026-10-29-5ba921b9-0431-4b85-95a7-6606a01111b8.edn", :sha256 "5b53bad4a0c243fec48e928930d708f5729212335a70f6b0a6f73e1d671e0d2b"}, :review-status :unreviewed, :injury-id "injury/f7e97cc6653b45dda8b492c7e9c7a288a1289831", :diagnosis-evidence-pin {:path "/home/joe/code/futon2/data/wm-meta-injuries-live-2026-10-22/diagnoses/diagnosis-77293ec8807d3a7fab7fdc3f5055feea1ff0c8f4762bbe6edecdb26e56aa8193.edn", :sha256 "77293ec8807d3a7fab7fdc3f5055feea1ff0c8f4762bbe6edecdb26e56aa8193"}, :status :proposed, :result-status :not-run}
