{:schema :wm/peripheral-recognition-sensitivity-sample-v1
 :status :hand-constructed-lean-exemplar
 :scope-warning
 "This proves properties of one interactively constructed example. It is not evidence that the War Machine can perform retrieval, cascade construction, interpretation, or policy-family generation for a new problem."
 :follow-up
 "Per problem, search a pinned snapshot of the whole futon3/library; construct alternative occurrence cascades with evidenced support, meet, and precedence relations; derive their outcome semantics; record exclusions and provenance; generate the Lean term; and prove equality with the runtime policy."
 :purpose
 "Show that a concrete interpretation can recognise operational peripherals and that a fact-token abstraction can lose the distinction."

 :pinned-want
 {:id :state-preserving-efficient-repair
  :timing :fixed-before-policy-construction-and-scoring
  :semantic-preferences
  [{:outcome :repair-completes :weight 4 :mode :soft}
   {:outcome :live-state-preserved :weight 3 :mode :soft}
   {:outcome :observations-typed-and-auditable :weight 2 :mode :soft}
   {:outcome :elapsed-time-low :weight 1 :mode :soft}
   {:outcome :model-token-use-low :weight 1 :mode :soft}]
  :hard-zero-outcomes []
  :note
  "Weights define the first sensitivity fixture, not universal WM preferences. Every outcome retains positive mass because this fixture declares no genuinely forbidden outcome."}

 :pattern-language
 {:snapshot "futon3/library/peripherals"
  :patterns
  ["peripherals/constrained-execution-envelope"
   "peripherals/split-transport-from-embodiment"
   "peripherals/canonical-typed-event-vs-side-channel"
   "peripherals/surface-earns-inhabitation"
   "peripherals/inhabitation-feeds-evolution"
   "peripherals/pattern-becomes-peripheral"]}

 :recognition
 {:principle
  "Peripheral is a role inferred from an evidenced operational relation, not a product-name token or a nominal class."
  :observations
  [:bounded-action-vocabulary
   :entry-condition
   :exit-condition
   :transport-contract
   :typed-events
   :embodiment
   :auditable-trace
   :inhabitation-feedback]
  :roles
  {:execution-peripheral
   {:requires [:bounded-action-vocabulary :entry-condition :exit-condition
               :transport-contract :embodiment]
    :strengthened-by [:typed-events :auditable-trace :inhabitation-feedback]}
   :transport-peripheral
   {:requires [:bounded-action-vocabulary :transport-contract :typed-events]
    :composition-note
    "May be composed with a separate embodiment to form an inhabited execution peripheral."}}}

 :instances
 [{:id :codex-repl
   :candidate-name "Codex REPL"
   :observed
   {:bounded-action-vocabulary true
    :entry-condition true
    :exit-condition true
    :transport-contract true
    :typed-events true
    :embodiment true
    :auditable-trace true
    :inhabitation-feedback true}
   :derived-role :execution-peripheral}
  {:id :claude-repl
   :candidate-name "Claude REPL"
   :observed
   {:bounded-action-vocabulary true
    :entry-condition true
    :exit-condition true
    :transport-contract true
    :typed-events true
    :embodiment true
    :auditable-trace true
    :inhabitation-feedback true}
   :derived-role :execution-peripheral}
  {:id :irc-adapter
   :candidate-name "IRC adapter"
   :observed
   {:bounded-action-vocabulary true
    :entry-condition false
    :exit-condition false
    :transport-contract true
    :typed-events true
    :embodiment false
    :auditable-trace true
    :inhabitation-feedback false}
   :derived-role :transport-peripheral
   :composes-with :repl-or-chat-embodiment}]

 :coarse-token-instance
 {:state-type [:finset :fact-token]
  :retained [:can-send :can-receive :connected]
  :collision
  {:left :codex-repl
   :right :untyped-dumb-pipe
   :same-state #{:can-send :can-receive :connected}
   :lost
   [:bounded-action-vocabulary :entry-condition :exit-condition
    :typed-events :embodiment :auditable-trace :inhabitation-feedback]}
  :consequence
  "Cannot justify peripheral recognition or distinguish an inhabitable REPL from an untyped pipe."}

 :operational-instance
 {:state-type
  {:envelope [:actions :entry :exit]
   :transport [:schema :event-types :reliability]
   :embodiment [:surface :affordances]
   :history [:trace :feedback]
   :resources [:elapsed-ms :model-tokens]}
  :consequence
  "Recognises the two REPLs as execution peripherals and the IRC adapter as a transport peripheral from witnesses, while retaining time and token costs for G."}

 :lean-obligations
 [{:name :recognition-is-name-invariant
   :claim "Renaming an instance without changing its operational witness preserves its derived peripheral role."}
  {:name :coarse-collision
   :claim "The coarse encoding maps Codex REPL and an untyped dumb pipe to the same state."}
  {:name :operational-separation
   :claim "The operational encoding distinguishes them by at least typed events, embodiment, and lifecycle."}
  {:name :adapter-composition
   :claim "A transport peripheral satisfying the composition contract plus a qualifying embodiment satisfies the execution-peripheral requirements."}
  {:name :g-is-instance-sensitive
   :claim "Under the one pinned want, a policy pair differing in lifecycle, duration, or token cost may tie under the coarse instance and rank differently under the operational instance."}
  {:name :want-precedes-policy-scoring
   :claim "The preference distribution is a function of outcomes and the pinned want, not of the candidate policy being scored."}
  {:name :soft-unless-forbidden
   :claim "Every outcome has positive preference mass in this fixture; only an explicitly declared genuinely forbidden outcome may receive zero."}]

 :model-comparison
 {:lean-source "DarkTower/WarMachine/PeripheralSensitivityG.lean"
  :lean-commit "44cb16e712"
  :deterministic
  {:operational :repl-repair-strictly-lower-g
   :coarse :tie}
  :stochastic
  {:success-probability [4 5]
   :fallback-probability [1 5]
   :ambiguity :shared-arbitrary
   :operational :repl-repair-strictly-lower-g
   :coarse :tie}
  :control
  "The coarse preference is the pushforward of the one pinned operational preference, not a separately selected want."}

 :cascade-policy-bridge
 {:lean-source "DarkTower/WarMachine/PeripheralCascadePolicies.lean"
  :lean-commit "7abcc2366b"
  :relations [:support :meet :generative-precedence]
  :policies
  [{:id :direct-drawbridge-repl
    :admissible true
    :interpretation
    {:completion :contains-hot-reload
     :state-preservation :seam-precedes-reload
     :typed-auditability :typed-event-precedes-reload
     :resource-band :low}}
   {:id :irc-mediated-ground-control
    :admissible true
    :interpretation
    {:completion :contains-hot-reload
     :state-preservation :seam-precedes-reload
     :typed-auditability :typed-event-precedes-reload
     :resource-band :high-because-split-transport-hop}}]
  :results
  {:deterministic {:operational :direct-strictly-lower-g :coarse :tie}
   :stochastic {:operational :direct-strictly-lower-g :coarse :tie}}
  :negative-control
  {:id :restart-through-untyped-pipe
   :structurally-well-formed true
   :admissible false
   :reason
   "For the pinned reload-safe problem it lacks the seam and typed-event construction evidence; restart remains valid only across a separately documented reload-safety boundary."}}}
