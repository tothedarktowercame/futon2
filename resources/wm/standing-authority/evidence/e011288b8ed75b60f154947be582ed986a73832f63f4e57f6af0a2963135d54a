, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["hdm/deep-storage-to-active-graph" 19], :pattern "hdm/deep-storage-to-active-graph", :roles ["dependency" "context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-stack-geometry/M-stack-geometry/policy-c7d7518e1e185c2e2318/[\"hdm/deep-storage-to-active-graph\" 19]", :span {:start 1270, :end 1305}, :source-text-digest "9c2f467e8d5062961da62bae3a5d3b2b064f048a9354e7be0bfd5dfc025d2aad", :analysis-digest "e183844e1fd2569431413d615fb7b997a8182cdd0b86f14175ed3b83e21e5e4d", :source-sha256 "5394a281f2def43f04a7643e1ad809a528edf3dfaaa38712902cced71475557f", :square-digest "ecae1c0791493e96111385b293e7db7374229618047c760b3d364b482f985386"}, :square {:schema :wm/three-halves-square-v1, :pattern "hdm/deep-storage-to-active-graph", :objects {:G {:text "      A unified, pattern-indexed graph enables reasoning/learning across boundaries while respecting each project's autonomy and\n      identity.\n", :source {:path "futon3/library/hdm/deep-storage-to-active-graph.flexiarg", :sha256 "5394a281f2def43f04a7643e1ad809a528edf3dfaaa38712902cced71475557f"}, :situation-source "HDM rule and cited excursion.", :theory {:elems #{:g}, :names {:g "A recorded bridge can govern mission-record activation."}, :axioms #{}}}, :I1 {:text "      Open mathematical repositories (\"deep storage\") already exist-PlanetMath, arXiv, nLab, wikis, code archives-holding\n      enormous value but lacking uniform structure and computational affordances.\n", :source {:path "futon3/library/hdm/deep-storage-to-active-graph.flexiarg", :sha256 "5394a281f2def43f04a7643e1ad809a528edf3dfaaa38712902cced71475557f"}, :situation-source "futon3/library/hdm/deep-storage-to-active-graph.flexiarg THEN.", :theory {:elems #{:i1}, :names {:i1 "Activation ingests durable sources while retaining origin links."}, :axioms #{}}}, :I2 {:text "      Treating each repository as its own universe squanders synergies and makes it hard for humans or agents to form a unified\n      mental map of mathematics.\n", :source {:path "futon3/library/hdm/deep-storage-to-active-graph.flexiarg", :sha256 "5394a281f2def43f04a7643e1ad809a528edf3dfaaa38712902cced71475557f"}, :situation-source "M-stack-geometry.md reference to E-webarxana-as-hinge-log-backend.md.", :theory {:elems #{:i2}, :names {:i2 "The WebArxana hinge-log excursion records an ingestion precedent."}, :axioms #{}}}, :B {:text "      Use HDM/FUTON6 as an aggregation + activation layer: ingest key fragments from deep storage into a coherent graph, annotate\n      them with patterns, proof skeletons, and cross-links, and maintain mappings back to origin sites for provenance.\n", :source {:path "futon3/library/hdm/deep-storage-to-active-graph.flexiarg", :sha256 "5394a281f2def43f04a7643e1ad809a528edf3dfaaa38712902cced71475557f"}, :situation-source "Cross-reference interpreted through HDM.", :theory {:elems #{:b}, :names {:b "Reuse the excursion’s bridge for Stack Geometry entities."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["hdm/deep-storage-to-active-graph" 20], :pattern "hdm/deep-storage-to-active-graph", :roles ["dependency" "rationale"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-stack-geometry/M-stack-geometry/policy-c7d7518e1e185c2e2318/[\"hdm/deep-storage-to-active-graph\" 20]", :span {:start 1316, :end 1371}, :source-text-digest "9c2f467e8d5062961da62bae3a5d3b2b064f048a9354e7be0bfd5dfc025d2aad", :analysis-digest "e183844e1fd2569431413d615fb7b997a8182cdd0b86f14175ed3b83e21e5e4d", :source-sha256 "5394a281f2def43f04a7643e1ad809a528edf3dfaaa38712902cced71475557f", :square-digest "3fd38413a0d5651873ec457aee99fc421ff0cf8a627167f12f916f2c915db0eb"}, :square {:schema :wm/three-halves-square-v1, :pattern "hdm/deep-storage-to-active-graph", :objects {:G {:text "      A unified, pattern-indexed graph enables reasoning/learning across bound