t "e8678feb63133e7a13d5d3ed7a2722c430f8ff80f2355b6f98a4d09dd01fe941", :analysis-digest "54558739922fa7db94f035fc7573d430033fbee7e87acce089da6b5f4ed38441", :source-sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248", :square-digest "be574ee2f2dcc5cd65643e84270ab433edda7802887020b385c6a1174996336c"}, :square {:schema :wm/three-halves-square-v1, :pattern "agent/evidence-over-assertion", :objects {:G {:text "    Evidence transforms agent output from \"trust me\" to \"check this.\" It enables verification, correction, and cumulative trust-building.\n\n    + evidence: Fulab PUR/PSR templates require anchors/certificates (`src/futon3/fulab/pattern_competence.clj`), and claim verification is enforced via `fulab-pattern-claim` + `fulab-pattern-check`.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "Pattern evidence requirement applied to the downstream observation dependency.", :theory {:elems #{:g}, :names {:g "Evaluate a cascade by whether the selected portfolio-inference target lands on an operational surface that yields inspectable observations."}, :axioms #{}}}, :I1 {:text "    The agent's outputs need to be verifiable by other agents, humans, or future selves.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "agent/evidence-over-assertion THEN/BECAUSE.", :theory {:elems #{:i1}, :names {:i1 "A claim becomes reliable when it points to evidence and exposes a verification path."}, :axioms #{}}}, :I2 {:text "    Assertions without anchors are indistinguishable from confabulation. Observers cannot tell if the agent is reporting reality or generating plausible-sounding noise.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "M-recommendation-bindings portfolio-inference cross-reference.", :theory {:elems #{:i2}, :names {:i2 "This mission is intended to make the target of M-portfolio-inference's next move meaningfully observable."}, :axioms #{}}}, :B {:text "    Require every substantive claim to point to evidence: a file path, a trace event, a test result, a quotation. If evidence is unavailable, emit the claim as provisional with an expiry and a verification path. Make \"unsupported claim\" a detectable violation, not just a style preference.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "Combined evidence pattern and M-portfolio-inference reference.", :theory {:elems #{:b}, :names {:b "A portfolio next move whose target and resulting observation can be independently checked."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}}], :receipts {:construction {:policy-id "M-recommendation-bindings/policy-7e8a0806fea29fa47914", :policy-key [:wm/reading-policy-v1 "M-recommendation-bindings" "M-recommendation-bindings/policy-7e8a0806fea29fa47914" {:nodes [[["contracts/resolve-pointers-at-head" 0] "contracts/resolve-pointers-at-head"] [["futon-theory/mission-lifecycle" 1] "futon-theory/mission-lifecycle"] [["agent/handoff-preserves-context" 2] "agent/handoff-preserves-context"] [["agent/evidence-over-assertion" 3] "agent/evidence-over-assertion"] [["agent/evidence-over-assertion" 4] "agent/evidence-over-assertion"] [["contracts/resolve-pointers-at-head" 5] "contracts/resolve-pointers-at-head"] [["agent/evidence-over-assertion" 6] "agent/evidence-over-assertion"] [["contracts/resolve-pointers-at-head" 7] "contracts/resolve-pointers-at-head"] [["agent/evidence-over-assertion" 8] "agent/evidence-over-assertion"] [["measurement/warrant-travels-with-the-number" 10] "m