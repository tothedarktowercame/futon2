c9d1238c037c7fad654b6d363"}, :situation-source "M-stack-geometry.md reference to M-mission-control.md.", :theory {:elems #{:i2}, :names {:i2 "Mission Control supplies the observational dependency."}, :axioms #{}}}, :B {:text "    Use pocketwatch-style constraints and explicit external-sorry checks: every stack work item must answer which outside obligation it closes, and stack hours must stay bounded relative to portfolio and consulting hours.\n", :source {:path "futon3/library/war-machine/state-capture.flexiarg", :sha256 "b45598fb80725dfb4b7deadf520355feaca633dc9d1238c037c7fad654b6d363"}, :situation-source "Cross-reference constrained by external-obligation checks.", :theory {:elems #{:b}, :names {:b "Use Mission Control as grounded input, not self-maintenance evidence."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}, :fragment-indices [5], :pattern "war-machine/state-capture"} {:pattern-rationale "The observational layer captures current mission state as input to higher stack layers.", :fragment-span {:start 445, :end 489}, :occurrence-id ["war-machine/state-capture" 6], :roles ["context" "condition"], :source-sha256 "b45598fb80725dfb4b7deadf520355feaca633dc9d1238c037c7fad654b6d363", :sentence-id "s10", :blend-square {:schema :wm/three-halves-square-v1, :pattern "war-machine/state-capture", :objects {:G {:text "    The war machine can be captured by the institution it created. Without an explicit test, the stack quietly redirects nomadic practice toward self-reproduction.\n", :source {:path "futon3/library/war-machine/state-capture.flexiarg", :sha256 "b45598fb80725dfb4b7deadf520355feaca633dc9d1238c037c7fad654b6d363"}, :situation-source "State-capture rule and recorded portfolio scope.", :theory {:elems #{:g}, :names {:g "The active portfolio grounds the geometry’s state."}, :axioms #{}}}, :I1 {:text "    Infrastructure maintenance begins to dominate the work mix and stack activity st