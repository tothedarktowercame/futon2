ibrary/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "M-recommendation-bindings portfolio-inference cross-reference.", :theory {:elems #{:i2}, :names {:i2 "This mission is intended to make the target of M-portfolio-inference's next move meaningfully observable."}, :axioms #{}}}, :B {:text "    Require every substantive claim to point to evidence: a file path, a trace event, a test result, a quotation. If evidence is unavailable, emit the claim as provisional with an expiry and a verification path. Make \"unsupported claim\" a detectable violation, not just a style preference.\n", :source {:path "futon3/library/agent/evidence-over-assertion.flexiarg", :sha256 "28425a05c4a87cbfe3147c1998e83701b8519b42c1796f1d0f25b4b039271248"}, :situation-source "Combined evidence pattern and M-portfolio-inference reference.", :theory {:elems #{:b}, :names {:b "A portfolio next move whose target and resulting observation can be independently checked."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}}], :receipts {:construction {:policy-id "M-recommendation-bindings/policy-7e8a0806fea29fa47914", :policy-key [:wm/reading-policy-v1 "M-recommendation-bindings" "M-recommendation-bindings/policy-7e8a0806fea29fa47914" {:nodes [[["contracts/resolve-pointers-at-head" 0] "contracts/resolve-pointers-at-head"] [["futon-theory/mission-lifecycle" 1] "futon-theory/mission-lifecycle"] [["agent/handoff-preserves-context" 2] "agent/handoff-preserves-context"] [["agent/evidence-over-assertion" 3] "agent/evidence-over-assertion"] [["agent/evidence-over-assertion" 4] "agent/evidence-over-assertion"] [["contracts/resolve-pointers-at-head" 5] "contracts/resolve-pointers-at-head"] [["agent/evidence-over-assertion" 6] "agent/evidence-over-assertion"] [["contracts/resolve-pointers-at-head" 7] "contracts/resolve-pointers-at-head"] [["agent/evid