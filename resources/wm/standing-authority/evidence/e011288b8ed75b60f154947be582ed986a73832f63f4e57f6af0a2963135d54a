643e1ad809a528edf3dfaaa38712902cced71475557f"}, :situation-source "hdm/deep-storage-to-active-graph THEN/BECAUSE.", :theory {:elems #{:i1}, :names {:i1 "Stored fragments gain utility when activated in a coherent, provenance-preserving graph."}, :axioms #{}}}, :I2 {:text "      Treating each repository as its own universe squanders synergies and makes it hard for humans or agents to form a unified\n      mental map of mathematics.\n", :source {:path "futon3/library/hdm/deep-storage-to-active-graph.flexiarg", :sha256 "5394a281f2def43f04a7643e1ad809a528edf3dfaaa38712902cced71475557f"}, :situation-source "Boundary-growth fragment.", :theory {:elems #{:i2}, :names {:i2 "The pair mission supplies substrate-2's boundary-growth interface."}, :axioms #{}}}, :B {:text "      Use HDM/FUTON6 as an aggregation + activation layer: ingest key fragments from deep storage into a coherent graph, annotate\n      them with patterns, proof skeletons, and cross-links, and maintain mappings back to origin sites for provenance.\n", :source {:path "futon3/library/hdm/deep-storage-to-active-graph.flexiarg", :sha256 "5394a281f2def43f04a7643e1ad809a528edf3dfaaa38712902cced71475557f"}, :situation-source "Combined pattern and interface role.", :theory {:elems #{:b}, :names {:b "A provenance-preserving interface from stored pattern records to live boundary growth."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["agent/evidence-over-assertion" 12], :pattern "agent/evidence-over-assertion", :roles ["dependency" "context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-war-machine-wiring/M-war-machine-wiring/policy-2629917c87a61978be8f/[\"agent/evidence-over-assertion\" 12]", :span {:start 1228, :end 1273}, :source-text-digest "bd0f29407a1be7c77a6fb41f33fff97b01e22e9a0b093b4ee693af0197ba9ed4", :analysis-digest "c8402106cd699388b85a9387c851b2a45fd28e0cdf6445524f21fc236efa7