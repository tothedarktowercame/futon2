m/deep-storage-to-active-graph.flexiarg", :sha256 "5394a281f2def43f04a7643e1ad809a528edf3dfaaa38712902cced71475557f"}, :situation-source "Shared ingestion dependency interpreted through HDM.", :theory {:elems #{:b}, :names {:b "Activate trip-journal records through futon1a with provenance intact."}, :axioms #{}}}}, :maps {:a1 #{[:g :i1]}, :a2 #{[:g :i2]}, :b1 #{[:i1 :b]}, :b2 #{[:i2 :b]}}, :auxiliary {:b1 false, :b2 false}}} {:occurrence-id ["problems/operator-turns-become-inference-observations" 12], :pattern "problems/operator-turns-become-inference-observations", :roles ["dependency" "context"], :fragment-indices [], :origin :selected, :provenance {:reading-record-id "M-stack-geometry/M-stack-geometry/policy-c7d7518e1e185c2e2318/[\"problems/operator-turns-become-inference-observations\" 12]", :span {:start 825, :end 872}, :source-text-digest "9c2f467e8d5062961da62bae3a5d3b2b064f048a9354e7be0bfd5dfc025d2aad", :analysis-digest "e183844e1fd2569431413d615fb7b997a8182cdd0b86f14175ed3b83e21e5e4d", :source-sha256 "28cd96e29b84e7698a16ee0c4c020d345c49228dfb1fda6d8bd999ff46707ce9", :square-digest "6564808df6a642ee2de24c920e3044730ec3679560c89b01da9e4b030c97c672"}, :square {:schema :wm/three-halves-square-v1, :pattern "problems/operator-turns-become-inference-observations", :objects {:G {:text "    we know that works for design patterns, and the turn→pattern association will provide enriched material that is grounded in immediate practical considerations\n    ?evidence(required): A pilot has not yet shown that processed operator turns enter the inference vector and change an inference result.\n", :source {:path "futon3/library/problems/operator-turns-become-inference-observations.flexiarg", :sha256 "28cd96e29b84e7698a16ee0c4c020d345c49228dfb1fda6d8bd999ff46707ce9"}, :situation-source "Pattern transformation and mission linkage.", :theory {:elems #{:g}, :names {:g "Turn records are candidate proximity observations."}, :axioms #{}}}, :I1 {:text "    we are capturing operator