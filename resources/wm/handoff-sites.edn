{:schema :wm/handoff-site-index-v1
 :scope :production-war-machine
 :sites
 [{:id :runner/agency-transport
   :producer :full-loop-runner :consumer :agency
   :kind :agent-transport :source "src/futon2/aif/full_loop_runner.clj"
   :anchor "(defn dispatch!"
   :contract :wm/run-local-job-ledger
   :transport :handoff/response-payload :status :verified-adapter}
  {:id :selection/strategic-seat
   :producer :outer-selection :consumer :strategic-selector-seat
   :kind :agent-reply :source "src/futon2/aif/full_loop_runner.clj"
   :anchor ":strategic-selection-invoke-fn"
   :contract :wm/strategic-selection-request
   :transport :handoff/response-payload :status :verified-adapter}
  {:id :reading/selected-target
   :producer :retained-outer-choice :consumer :wm-author
   :kind :agent-reply :source "src/futon2/aif/selected_target_reading.clj"
   :anchor "(handoff/exchange {:contact answer-fn"
   :contract :wm/selected-target-reading-request-v1
   :transport :handoff/exchange :status :verified-shared}
  {:id :reading/selected-policy
   :producer :selected-reading-policy :consumer :wm-author
   :kind :agent-reply :source "src/futon2/aif/full_loop_runner.clj"
   :anchor "(handoff/exchange\n                        {:contact ask"
   :contract :wm/selected-reading-request-v1
   :transport :handoff/exchange :status :verified-shared}
  {:id :interpretation/want
   :producer :mission-want :consumer :interpretation-seat
   :kind :agent-reply :source "src/futon2/aif/flight_runner.clj"
   :anchor "(defn ask-fn"
   :contract :wm/want-interpretation-request-v1
   :transport :handoff/response-payload :status :verified-adapter}
  {:id :interpretation/legacy-action
   :producer :selected-legacy-action :consumer :interpreter
   :kind :agent-reply :source "src/futon2/aif/interpretation_job.clj"
   :anchor "(defn run!"
   :contract :wm/interpretation-contract-manifest-v1
   :transport :handoff/response-payload :status :verified-adapter}
  {:id :execution/author
   :producer :selected-action :consumer :author
   :kind :agent-reply :source "src/futon2/aif/full_loop_runner.clj"
   :anchor "(defn- author-prompt"
   :contract :wm/author-artifact-contract
   :transport :handoff/response-payload :status :verified-adapter}
  {:id :execution/build-cure
   :producer :mechanical-build-failure :consumer :author
   :kind :agent-reply :source "src/futon2/aif/full_loop_runner.clj"
   :anchor "build-cure-prompt"
   :contract :wm/build-cure-contract
   :transport :handoff/response-payload :status :verified-adapter}
  {:id :review/initial
   :producer :authored-commit :consumer :reviewer
   :kind :agent-reply :source "src/futon2/aif/full_loop_runner.clj"
   :anchor "(defn- reviewer-prompt"
   :contract :wm/review-verdict-contract
   :transport :handoff/response-payload :status :verified-adapter}
  {:id :review/revision
   :producer :negative-review :consumer :author-and-reviewer
   :kind :agent-reply :source "src/futon2/aif/full_loop_runner.clj"
   :anchor "revision-reviewer-prompt"
   :contract :wm/revision-review-contract
   :transport :handoff/response-payload :status :verified-adapter}
  {:id :review/standing-decision
   :producer :missing-standing-decision :consumer :reviewer
   :kind :agent-reply :source "src/futon2/aif/full_loop_runner.clj"
   :anchor "(defn- standing-completion-prompt"
   :contract :wm/limb-evidence-standing-decision-v1
   :transport :handoff/response-payload :status :verified-adapter}
  {:id :repair/loop-worker
   :producer :wm-click-repair-loop :consumer :repair-reviewer
   :kind :agent-reply :source "scripts/wm_click_repair_loop.py"
   :anchor "def repair(args, reason"
   :contract :wm/click-repair-verdict-v1
   :transport :agency-send-script :status :registered-exception
   :exception "Python supervisor; explicit cast and terminal verdict are locally gated."}
  {:id :preflight/quota-probe
   :producer :issuing-caller :consumer :cast-member
   :kind :agent-reply :source "scripts/wm_click.sh"
   :anchor "--from \"$ISSUING_CALLER\" --to \"$a\""
   :contract :wm/quota-probe-v1
   :transport :agency-send-script :status :registered-exception
   :exception "Optional shell preflight; sender is the explicit issuing caller and the reply cannot enter selection."}
  {:id :repair/loop-owner-notification
   :producer :wm-click-repair-loop :consumer :owner
   :kind :notification :source "scripts/wm_click_repair_loop.py"
   :anchor "def notify(args, reason"
   :contract :wm/click-loop-stop-notice-v1
   :transport :agency-send-script :status :registered-exception
   :exception "One-way stop notice, not a response consumed by selection."}
  {:id :record/decision-to-requirements
   :producer :runner-decision :consumer :wm-run-facts
   :kind :durable-record :source "scripts/wm_run_facts.clj"
   :anchor "(defn facts-for-record"
   :contract :wm/sealed-requirement-carriers
   :transport :sealed-record :status :verified-record}
  {:id :report/requirements-check
   :producer :wm-run-facts :consumer :requirements-checker
   :kind :service :source "scripts/wm_click.sh"
   :anchor "requirements NOT CHECKED"
   :contract :wm/requirements-check-terminal
   :transport :checked-publication :status :verified-fail-closed}]}
