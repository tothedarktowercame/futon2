  {:id :C5 :kind :checkable :token "the contract bundle at the pinned sha has the named contract-id, and every clojure-locus it declares resolves (file present with at least that many lines at the locus repo HEAD)"
   :check "emitted bundle JSON at pinned sha contains the entry with resolving clojureLocus"
   :check-fn check-registry-entry :inputs {:repo string :sha string :entry string}}
  {:id :J :kind :judgement
   :question "Does this step's stated output exist as an independently locatable artifact satisfying the application's own stated conditions, at cutoff sha X?"
   :verdicts [:exists :does-not-exist :insufficient-evidence :ambiguous]
   :may-see ["cascade node application text" "repository and DAG/registry at pinned cutoff sha" "pattern source"]
   :must-not-see ["DATA-cascade-outcomes recorded outcome" "node :status / author claim" "downstream acceptance/review records" "model posterior"]}]
