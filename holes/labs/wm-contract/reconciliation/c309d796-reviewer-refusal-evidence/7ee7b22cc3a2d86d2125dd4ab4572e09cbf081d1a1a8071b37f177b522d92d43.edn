{:schema :wm/out-of-band-acceptance-v1, :injury-id "injury/c309d796db8291e4a738f931c1c05437756ce74f", :fixed-by "75b0748014729e2bce8db204723a8666645ed23c", :historical-pin {:path "/home/joe/code/futon2/data/wm-runs/tick-run-record-2026-10-31-adc46631-2156-4c84-850f-5abaa3aeb5fd.edn", :sha256 "5c1f97c37ee8cf246d82cd9058d54b7bbfae2f385d26d75121c9f97b5300cdd5"}, :failure-kind :answer-reviewer-mismatch, :failure-stage :cascade-resume, :acceptance-test {:id "injury-c309d796-reviewer-refusal-typed-close", :command ["clojure" "-M:test" "-n" "futon2.aif.meta-acceptance-injury-c309d796-reviewer-refused-test"], :source {:namespace "futon2.aif.meta-acceptance-injury-c309d796-reviewer-refused-test", :path "test/futon2/aif/meta_acceptance_injury_c309d796_reviewer_refused_test.clj", :text "(ns futon2.aif.meta-acceptance-injury-c309d796-reviewer-refused-test\n  \"Out-of-band acceptance for injury c309d796; fixed by 75b074801.\"\n  (:require [cheshire.core :as json]\n            [clojure.edn :as edn]\n            [clojure.test :refer [deftest is]]\n            [futon2.aif.full-loop-runtime :as runtime]\n            [futon2.aif.wm.cascade-patch-delivery :as delivery]))\n\n;; Injury c309d796db8291e4a738f931c1c05437756ce74f (ledger ordinal 138,\n;; :answer-reviewer-mismatch at :cascade-resume, cause record\n;; tick-run-record-2026-10-31-adc46631-2156-4c84-850f-5abaa3aeb5fd.edn)\n;; was opened because the reviewer of run adc46631 (job\n;; invoke-1793473761172-8882-652e3bf0) REFUSED the author's answer — its\n;; retained reply is prose plus one fenced JSON object with\n;; \"accepted\": false, \"accepted-by\": null and a reason (hole 0's\n;; consumes/produces claim diverged from the committed source) — and the\n;; handler's pin merge copied the nil accepted-by onto the author answer\n;; (all three pins matched), so validate-answer closed the click as\n;; :answer-reviewer-mismatch and the terminal classifier opened an injury.\n;; Fix 75b0748014729e2bce8db204723a8666645ed23c closes an explicit reviewer\n;; refusal typed as :open-cascade-review-refused with the reviewer's reason\n;; preserved, and enumerates it as an explicit non-injury kind.\n;;\n;; The reviewer fixture below uses the real retained reply SHAPE: prose,\n;; then exactly one fenced JSON object. The retained text itself is\n;; tail-truncated at the retention bound (\"...[trimmed]\", no closing\n;; fence); the reason is completed here from the reviewer's own prose\n;; bullets in the same reply. Pins echo the requisition as the real reply's\n;; pins did.\n;;\n;; On the fixed tree the refusal closes typed with reviewer, reviewer-job\n;; and reason retained. On the counterfactual (fix reverted) the same reply\n;; yields :answer-reviewer-mismatch with nil reviewer/reason, so the\n;; is-assertions FAIL; nothing in the test body throws on either tree.\n\n(def requisition (edn/read-string (slurp \"test/resources/m2c/requisition.edn\")))\n\n(def refusal-reason\n  \"Hole [\\\"cascade-construction/read-what-exists-first\\\" 0] in the author answer declares consumes=unrecorded-cascade-repair-transition / produces=auditable-mission-state-transition, but the committed source at 7f241c36 declares consumes=bare-mission-identifier / produces=read-anchored-target-identity; acceptance binds the author's decisions to the verified source digest, so I am not accepting.\")\n\n(defn clause [_hole-id]\n  {:operation \"apply-pattern\" :capability :wm/pattern-apply\n   :completion-check \"clause-applied\"})\n\n(defn held-error []\n  (assoc (select-keys requisition [:cascade-digest :phase :holes])\n         :kind :wm/open-cascade-execution-error\n         :attempts []\n         :resume-port {:retry (fn [ctx] {:cascade-digest (:cascade-digest ctx)})}))\n\n(defn reviewer-refusal-text [req]\n  ;; The retained reply shape of job invoke-1793473761172-8882-652e3bf0:\n  ;; prose verification report, then one fenced JSON refusal object.\n  (str \"I verified the committed source and every hole decision, and I'm refusing acceptance on one concrete discrepancy.\\n\\n\"\n       \"**What I verified**: file content SHA-256 equals the source-digest; \"\n       \"the decisions var is a defn of the context map; all hole ids match \"\n       \"the requisition; operations match the author answer for every hole \"\n       \"but hole 0.\\n\\n**Discrepancy — hole 0**: the author answer declares \"\n       \"consumes=unrecorded-cascade-repair-transition but the committed \"\n       \"source declares consumes=bare-mission-identifier. I am not accepting:\\n\\n\"\n       \"```json\\n\"\n       (json/generate-string\n        {:accepted false :accepted-by nil\n         :requisition-id (:requisition-id req)\n         :cascade-digest (:cascade-digest req)\n         :patch {:source-digest (apply str (repeat 64 \"7\"))}\n         :reason refusal-reason})\n       \"\\n```\"))\n\n(defn reviewer-acceptance-text [req]\n  ;; The accepting shape seen on earlier clicks: same pins, accepted true,\n  ;; accepted-by set to the reviewer's own seat id.\n  (str \"Verified the committed source and every hole decision. Accepting:\\n\\n\"\n       \"```json\\n\"\n       (json/generate-string\n        {:accepted true :accepted-by \"wm-reviewer\"\n         :requisition-id (:requisition-id req)\n         :cascade-digest (:cascade-digest req)\n         :patch {:source-digest (apply str (repeat 64 \"7\"))}})\n       \"\\n```\"))\n\n(defn exercise [reviewer-text-fn]\n  (let [seen-req (atom nil)\n        clauses (into {} (map (fn [h] [(:hole-id h) (clause h)])\n                              (:holes requisition)))\n        handler (runtime/open-cascade-resume-handler\n                 {:author \"wm-author\" :reviewer \"wm-reviewer\"\n                  :open-cascade-author-answer-fn\n                  (fn [req]\n                    (reset! seen-req req)\n                    {:requisition-id (:requisition-id req)\n                     :cascade-digest (:cascade-digest req)\n                     :by \"wm-author\"\n                     :decisions (into {} (map (fn [h] [(:hole-id h) (clause h)])\n                                              (:holes requisition)))\n                     :patch {:namespace \"futon2.aif.wm.authored.req-b9e453fd\"\n                             :var \"decisions\"\n                             :source-digest (apply str (repeat 64 \"7\"))}})\n                  :open-cascade-reviewer-answer-fn\n                  (fn [_] {:state \"done\"\n                           :job-id \"reviewer-job-adc46631\"\n                           :result (reviewer-text-fn @seen-req)})\n                  :open-cascade-patch-loader (fn [_] (fn [_] clauses))})]\n    (with-redefs [delivery/check-delivery (fn [_] {:status :delivered})]\n      (let [result (handler (held-error))]\n        {:req @seen-req :result result}))))\n\n(deftest explicit-reviewer-refusal-closes-typed-not-as-mismatch\n  (let [{:keys [req result]} (exercise reviewer-refusal-text)]\n    (is (= :error (:status result)) (pr-str result))\n    (is (= :open-cascade-review-refused (:kind result)) (pr-str result))\n    (is (= \"wm-reviewer\" (:reviewer result)))\n    (is (= \"reviewer-job-adc46631\" (:reviewer-job result)))\n    (is (= refusal-reason (:reason result)))\n    (is (= (:requisition-id req) (:requisition-id result)))\n    ;; the reviewer's whole decoded reply is retained as evidence\n    (is (= false (get-in result [:reviewed-reply :accepted])))))\n\n(deftest accepting-reviewer-still-passes-the-review-seam\n  ;; Regression: an accepting reviewer reply must pass the review seam and\n  ;; reach the resume port; the refusal branch must not fire on\n  ;; :accepted true.  The fixture retry port cannot compile a cascade, so\n  ;; the run stops typed at :resume-incomplete AFTER acceptance — the stop\n  ;; line proves the refusal branch did not intercept the accept path.\n  (let [{:keys [result]} (exercise reviewer-acceptance-text)]\n    (is (= :error (:status result)) (pr-str result))\n    (is (= :resume-incomplete (:kind result)) (pr-str result))))\n"}}}
