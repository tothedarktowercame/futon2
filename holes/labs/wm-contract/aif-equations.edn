  {:symbol :E :meaning "habit prior over policies" :class :stack-defined :glossary "Softmax and controller calibration" :node :R6}
  {:symbol :alpha :meaning "belief-update step size" :class :stack-defined :glossary "Prediction error" :node :R3}
  {:symbol :eps0 :meaning "variance floor in the precision map" :class :stack-defined :glossary "Precision" :node :R7}
