                :verified {:eq2.1 "P(π) = σ(-γ · G(π))" :eq2.7 "belief-update set: s = σ(A·o + B s_{τ-1} + B·s_{τ+1}); π = σ(-F - γ·G); β = β + (π - π₀)·G; γ = 1/β"}
                :note "The habit prior E does NOT appear in this paper; see :friston2016."
                :retrieved "refs/friston2017.pdf"}
  :parr2022 {:cite "Parr, T., Pezzulo, G., & Friston, K. J. (2022). Active Inference: The Free Energy Principle in Mind, Brain, and Behavior. MIT Press."
             :used-for "consolidated discrete notation; THE source that writes the policy posterior with the habit term: π = σ(ln E − F − G)"
             :verified {:eq4.7 "policy prior and expected free energy (ch. 4, pp. 72-74; per C453)" :eq4.9 "risk/ambiguity and information-gain/pragmatic forms (per C453)" :eq4.10 "linear-algebra form with A, C, softmax (per C453)" :eqB.7 "P(π) = Cat(π₀), p. 246" :eqB.8 "F = π · (ln π − ln E + F + G), p. 247" :eqB.9 "π = σ(ln E − F − G), p. 247 -- read from the retrieved PDF by claude-1"}
