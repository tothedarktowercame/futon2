                :verified {:eq42 "G(π) = E_Q(s|π)[H[P(o|s)]] + D_KL[Q(s|π)||P(s)] - novelty (Appendix C)" :eq44 "risk over outcomes: (A s)·(log(A s) - log C), the form used when preferences are over outcomes" :eq45-48 "ambiguity = H · s_π, H := -diag[A·log A]" :eq10 "Q(π) = σ(-G(π)) -- omits E and temperature; footnote 5 gives the fuller σ(−ln E − F − G) per C453 (sign of the E term as transcribed there); A.2 adds γ separately" :eq11 "u_t = argmax_u Σ_π δ_{u,π_t} Q(π)" :eq21 "a = a + Σ_τ o_τ ⊗ s_τ" :eq38 "Q(π) = σ(-G(π; β)), β ≥ 0" :A2 "γ as inverse temperature: σ(-γ G(π))" :A4 "deep temporal (hierarchical) models"}
                :retrieved "refs/dacosta2020.pdf"}
  :friston2017 {:cite "Friston, K., FitzGerald, T., Rigoli, F., Schwartenbeck, P., & Pezzulo, G. (2017). Active inference: a process theory. Neural Computation, 29(1), 1-49."
                :used-for "the perception-evaluation-selection-action loop as a process; precision γ of policy selection and its β update"
                :verified {:eq2.1 "P(π) = σ(-γ · G(π))" :eq2.7 "belief-update set: s = σ(A·o + B s_{τ-1} + B·s_{τ+1}); π = σ(-F - γ·G); β = β + (π - π₀)·G; γ = 1/β"}
                :note "The habit prior E does NOT appear in this paper; see :friston2016."
                :retrieved "refs/friston2017.pdf"}
  :parr2022 {:cite "Parr, T., Pezzulo, G., & Friston, K. J. (2022). Active Inference: The Free Energy Principle in Mind, Brain, and Behavior. MIT Press."
             :used-for "consolidated discrete notation; THE source that writes the policy posterior with the habit term: π = σ(ln E − F − G)"
             :verified {:eq4.7 "policy prior and expected free energy (ch. 4, pp. 72-74; per C453)" :eq4.9 "risk/ambiguity and information-gain/pragmatic forms (per C453)" :eq4.10 "linear-algebra form with A, C, softmax (per C453)" :eqB.7 "P(π) = Cat(π₀), p. 246" :eqB.8 "F = π · (ln π − ln E + F + G), p. 247" :eqB.9 "π = σ(ln E − F − G), p. 247 -- read from the retrieved PDF by claude-1"}
             :retrieved "refs/parr2022.pdf (mirror located by wm-evidence, C453)"}
  :friston2016 {:cite "Friston, K., FitzGerald, T., Rigoli, F., Schwartenbeck, P., O'Doherty, J., & Pezzulo, G. (2016). Active inference and learning. Neuroscience and Biobehavioral Reviews, 68, 862-879."
