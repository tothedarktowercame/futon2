                :used-for "expected free energy G = ambiguity + risk (- novelty); policy posterior softmax over -G; action as argmax; Dirichlet parameter learning; deep temporal models"
                :verified {:eq42 "G(π) = E_Q(s|π)[H[P(o|s)]] + D_KL[Q(s|π)||P(s)] - novelty (Appendix C)" :eq44 "risk over outcomes: (A s)·(log(A s) - log C), the form used when preferences are over outcomes" :eq45-48 "ambiguity = H · s_π, H := -diag[A·log A]" :eq10 "Q(π) = σ(-G(π)) -- omits E and temperature; footnote 5 gives the fuller σ(−ln E − F − G) per C453 (sign of the E term as transcribed there); A.2 adds γ separately" :eq11 "u_t = argmax_u Σ_π δ_{u,π_t} Q(π)" :eq21 "a = a + Σ_τ o_τ ⊗ s_τ" :eq38 "Q(π) = σ(-G(π; β)), β ≥ 0" :A2 "γ as inverse temperature: σ(-γ G(π))" :A4 "deep temporal (hierarchical) models"}
                :retrieved "refs/dacosta2020.pdf"}
  :friston2017 {:cite "Friston, K., FitzGerald, T., Rigoli, F., Schwartenbeck, P., & Pezzulo, G. (2017). Active inference: a process theory. Neural Computation, 29(1), 1-49."
