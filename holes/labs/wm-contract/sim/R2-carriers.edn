   :projection-at "src/futon2/aif/observation.clj:125"
   :reference {:kind :path :path [:graph :dynamics :commit-percentages :stack] :default 0.0}
   :producer "futon2.report.war-machine/scan-graph"
   :producer-at "scripts/futon2/report/war_machine.clj:3862"
   :producer-range :bounded-by-construction
   :producer-range-argument "stack-pct = (:stack ws-commits 0) / total-commits with total-commits = max(1, sum over all workstreams) (war_machine.clj:3861), so the numerator is one summand of the denominator. THE KEY IS A MISNOMER, NOT A SCALE ERROR: :commit-percentages holds ratios in [0,1], not percentages in [0,100], and the channel name :stack-pct and the declared meaning 'commit %' both read as percent."}

