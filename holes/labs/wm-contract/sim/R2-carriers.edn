   :projection-at "src/futon2/aif/observation.clj:122"
   :reference {:kind :path :path [:support-attack :support-coverage] :default 0.0}
   :producer "futon2.report.war-machine/scan-support-attack"
   :producer-at "scripts/futon2/report/war_machine.clj:3359-3362"
   :producer-range :bounded-by-construction
   :producer-range-argument "(count (filter covered? support-claims)) / (count support-claims): a subset count over its own superset count, guarded by (seq support-claims)."}

  {:channel :attack-coverage
