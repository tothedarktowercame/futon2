   :declared-at "src/futon2/aif/observation.clj:18"
   :declared-meaning "overall loop health [0,1] -- from holistic argument"
   :declared-range [0.0 1.0]
   :requirement-paths [[:loop-health :overall]]
   :requirement-at "src/futon2/aif/observation.clj:49"
   :projection-at "src/futon2/aif/observation.clj:121"
   :reference {:kind :path :path [:loop-health :overall] :default 0.0}
   :producer "futon2.report.war-machine/scan-loop-health"
   :producer-at "scripts/futon2/report/war_machine.clj:3275-3277"
   :producer-range :bounded-by-construction
   :producer-range-argument "overall is the arithmetic mean of arrow-health over the loop's arrows (war_machine.clj:3275-3277), and arrow-health is sqrt(freq * fresh) with freq = c/(c+10) in [0,1) and fresh = max(0, 1 - days/window) in [0,1] (war_machine.clj:3226-3233). A mean of values in [0,1) is in [0,1)."}

