   :producer-at "scripts/futon2/report/war_machine.clj:3421-3426"
   :producer-range :bounded-by-construction
   :producer-range-argument "max(0, completion-ratio - 0.5*abandon-penalty - 0.3*block-penalty) with completion-ratio = completed/total <= 1 and both penalties non-negative, so the value is in [0,1]."}

  {:channel :stack-pct
