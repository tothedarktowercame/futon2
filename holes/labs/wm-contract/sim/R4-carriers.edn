  :multi "src/futon2/aif/forward_model.clj:280-310"
  :predict "src/futon2/aif/forward_model.clj:312-369"
  :state-discard "src/futon2/aif/forward_model.clj:330-335"
  :consumer "src/futon2/aif/efe.clj:623-635"
  :live-horizon "scripts/futon2/report/war_machine.clj:6283-6329"
