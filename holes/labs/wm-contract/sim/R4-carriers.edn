;; Independent categorical carrier for V7 slice 8, node R4.
{:id :R4-carriers-v1 :node :R4 :row :V7 :slice 8
 :states [:s0 :s1]
 :outcomes [:good :bad]
 :actions [:advance :hold]
 :A {:s0 {:good 0.75 :bad 0.25}
     :s1 {:good 0.25 :bad 0.75}}
 :B {:advance {:s0 {:s0 0.5 :s1 0.5}
               :s1 {:s0 0.0 :s1 1.0}}
     :hold {:s0 {:s0 1.0 :s1 0.0}
            :s1 {:s0 0.0 :s1 1.0}}}
 :mu {:s0 1.0 :s1 0.0}
 :pi [:advance :advance]
 :T 2
 :production
 ;; REVIEW FIX (wm-build-work, slice 8): the delivered carrier exercised the
 ;; node only under {:type :no-op}, whose predict-effects arm
 ;; (forward_model.clj:65) returns an EMPTY observation delta -- so "the
 ;; observation prediction is unchanged when the belief changes" held for the
 ;; trivial reason that it is unchanged under everything. :acting-action adds an
 ;; arm that DOES move the observation (forward_model.clj:129-141), so the
 ;; belief-independence of the delta itself is what gets measured.
 {:action {:type :no-op}
  :acting-action {:type :address-sorry :target "entity"}
  :state-a {:observation {:sensor-x 0.25}
            :belief {"entity" {:spawned 1.0}}}
  :state-b {:observation {:sensor-x 0.25}
            :belief {"entity" {:strengthened 1.0}}}
  :state-c {:observation {:sensor-x 0.75}
            :belief {"entity" {:spawned 1.0}}}}
 :declaration-sites
 {:registry "holes/labs/wm-contract/aif-equations.edn:126-130"
  :symbols "holes/labs/wm-contract/aif-equations.edn:62-63"
