                  "u23_cascade_catalog_reader.clj (the :tensions carrier)"]

 ;; The record shape, declared in data so the validator and the prose cannot
 ;; drift apart: u41_tension_ledger.bb reads THIS map, it does not hardcode a
 ;; second copy of the schema.
 :ledger/schema
 {:tension
  {:required [:tension/id :tension/poles :tension/statement :tension/statement-source
              :tension/carried-by :tension/status :tension/born-of :tension/provenance]
   :optional [:tension/resolution-path :tension/resolution-key :tension/cashed-by
              :tension/pattern-links :tension/note :tension/refusal
              :tension/minted-by]
   :enums {:tension/status #{:carried :cashed :refuted :dissolved}
           :tension/born-of #{:operator-dictation :refuted-rationale :build-event
                              :refused-prediction}}
   :rules ["poles are exactly two, both non-blank -- a tension with one pole is a plan"
           ":tension/statement is verbatim from :tension/statement-source"
           ":tension/status is the status AT MINT and must equal the type of the mint event"
           ":tension/pattern-links [] means no graduation is claimed; the birth rule proposes and a person writes"]}
  :event
  {:required [:event/id :event/seq :event/tension :event/type :event/at :event/by :event/evidence]
   :optional [:event/row :event/note :event/to-status]
   :enums {:event/type #{:carried :cashed :refuted :dissolved :evidence-added}}
   :rules ["every tension has exactly one :carried mint event, and it is that tension's lowest :event/seq"
           "a status-moving event (:cashed/:refuted/:dissolved) requires a non-empty :event/evidence AND an :event/row -- section 3's 'status moves only with a pointer to the cashing/refuting row'"
           ":evidence-added never moves status; it is how a fact that bears on a carried tension is recorded without ruling on it"
           ":event/seq is unique and ascending across the whole ledger; events are appended, never rewritten"
           "no status-moving event may follow a terminal one (:cashed/:refuted/:dissolved) for the same tension"]}}

