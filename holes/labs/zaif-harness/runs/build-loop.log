   216	(defn mission-default-mode
   217	  "Inter-cycle fallback behavior for the Mission Peripheral.
   218	
   219	   Called when the deliberative tier has nothing to do — between cycles,
   220	   after completion, or when select-pattern abstains.
   221	
   222	   Actions:
   223	   1. Generate PAR for completed cycle
   224	   2. Consult Portfolio Inference for next assignment
   225	   3. Check structural law compliance
   226	   4. Either begin next cycle or signal blocked/complete
   227	
   228	   Returns same shape as select-pattern for drop-in substitution."
   229	  [_state observation]
   230	  (let [channels (:channels observation)
   231	        obligations (or (:obligation-satisfaction channels) 0.0)
   232	        compliance (or (:structural-law-compliance channels) 1.0)]
   233	    (cond
   234	      ;; All obligations satisfied → signal complete
   235	      (>= obligations 0.95)
   145	             mean-effort 0.3]
   146	         ;; Interpolate: (1-epe)*base + epe*mean
   147	         (+ (* (- 1.0 epe) base)
   148	            (* epe mean-effort)))
   149	       base))))
   150	
   151	;; =============================================================================
   152	;; Expected Free Energy
   153	;; =============================================================================
   154	
   155	(defn expected-free-energy
   156	  "Compute G(a) for a single action.
   157	   Lower G = better (minimizing free energy).
   158	
   159	   Returns {:action, :G, :terms {term-name → value}}.
   160	
   161	   :epistemic-override — when supplied, used as the epistemic value instead of
   162	   `epistemic-value`. choose-action passes the real expected-information-gain (the
   163	   action-posterior entropy) for :acquire-patterns this way (M-wm-policies Track 3)."
   164	  [action observation mu-sens precision adjacent-missions upvote-state lambdas
   165	   & {:keys [epistemic-override]}]
   166	  (let [prag (pragmatic-value action observation mu-sens adjacent-missions)
   167	        epis (or epistemic-override (epistemic-value action observation precision))
   168	        upv (upvote-value action upvote-state)
   169	        eff (effort-cost action observation)
   170	        ;; G = negative of value + cost
   171	        ;; Lower G = better, so: G = -(pragmatic + epistemic + upvote) + effort
   172	        G (+ (* (:effort lambdas) eff)
   173	             (- (* (:pragmatic lambdas) prag))
   174	             (- (* (:epistemic lambdas) epis))
   175	             (- (* (:upvote lambdas) upv)))]
   176	    {:action action
   177	     :G G
   178	     :terms {:pragmatic prag
   179	             :epistemic epis
   180	             :upvote upv
   181	             :effort eff}}))
   182	
   183	;; =============================================================================
   184	;; Softmax policy selection
   185	;; =============================================================================
