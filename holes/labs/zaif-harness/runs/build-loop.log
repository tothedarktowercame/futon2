+    (is (= {:q-actand/refusal :q-actand/zero-support-after-kin-pool
+            :grain :arm-session
+            :actand actand-key
+            :action :retrieve
+            :target :gold-judged
+            :kin []}
+           (actand/calibration-density-with-kin
+            (sessions) actand-key :retrieve)))))
