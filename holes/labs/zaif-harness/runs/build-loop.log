    49	(defn pragmatic-value
    50	  "Pragmatic value: how much does this action advance goals?
    51	   Higher for actions that address high-error channels."
    52	  [action observation mu-sens adjacent-missions]
    53	  (case action
    54	    :work-on  (let [gap-error (Math/abs (- (:gap-count observation 0.5)
    55	                                           (:gap-count mu-sens 0.5)))
    56	                    stall-error (Math/abs (- (:stall-count observation 0.5)
    57	                                            (:stall-count mu-sens 0.5)))
    58	                    n-adjacent (count (filter :adjacent? adjacent-missions))]
    59	                ;; Working on missions is most valuable when gaps/stalls are high
    60	                ;; and there are adjacent missions to work on
    61	                (+ (* 0.5 (+ gap-error stall-error))
    62	                   (* 0.3 (obs/clamp01 (/ (double n-adjacent) 5.0)))
    63	                   (* 0.2 (:gap-count observation 0.0))))
    64	    :review   (let [review-error (Math/abs (- (:review-age observation 0.5)
    65	                                              (:review-age mu-sens 0.5)))]
    66	                ;; Review is valuable when review-age is high or observations are stale
    67	                (+ (* 0.6 review-error)
    68	                   (* 0.4 (:review-age observation 0.0))))
    69	    :consolidate (let [spinoff-error (Math/abs (- (:spinoff-pressure observation 0.5)
    70	                                                  (:spinoff-pressure mu-sens 0.5)))]
    71	                   ;; Consolidation when spinoff pressure or entropy is high
    72	                   (+ (* 0.5 spinoff-error)
    73	                      (* 0.3 (:spinoff-pressure observation 0.0))
    74	                      (* 0.2 (- 1.0 (:coverage-pct observation 0.5)))))
    75	    :upvote   0.1  ; small constant — upvoting is always mildly useful
    76	    :acquire-patterns
    77	    ;; Niche-construction has only MILD pragmatic value — it doesn't advance a goal
    78	    ;; directly. It is warranted when there is stalled/gapped work that no current
    79	    ;; action confidently addresses. Kept small so it never hijacks normal operation
    80	    ;; (when a pragmatic action has real value, that action dominates).
    81	    (let [stall (:stall-count observation 0.0)
    82	          gap   (:gap-count observation 0.0)]
    83	      (* 0.2 (obs/clamp01 (* 0.5 (+ stall gap)))))
    84	    :wait     (let [total-error (reduce + (map (fn [k]
    85	                                                 (Math/abs (- (get observation k 0.5)
    86	                                                              (get mu-sens k 0.5))))
    87	                                               obs/channel-keys))]
    88	                ;; Waiting is valuable when everything is calm (low total error)
    89	                (* 0.5 (- 1.0 (obs/clamp01 (/ total-error 3.0)))))))
