    56	  (let [bytes (slurp calibration-path)
    57	        parsed-a (edn/read-string bytes)
    58	        parsed-b (edn/read-string bytes)]
    59	    (is (= (actand/calibration-table parsed-a)
    60	           (actand/calibration-table parsed-b)))))
