    45	;; ---------------------------------------------------------------------------
    46	;; (a) Validation, against the schema the ledger declares about itself.
    47	;; ---------------------------------------------------------------------------
    48	
    49	(defn- blank-string? [x] (and (string? x) (str/blank? x)))
    50	
    51	(defn- check-map
    52	  "Required keys present and non-blank; no key outside required+optional; every
    53	   enum-constrained value inside its declared set."
    54	  [kind spec m]
    55	  (let [{:keys [required optional enums]} spec
    56	        allowed (set (concat required optional))
    57	        id (or (:tension/id m) (:event/id m) m)]
    58	    (concat
    59	     (for [k required :when (or (not (contains? m k)) (nil? (get m k)) (blank-string? (get m k)))]
    60	       {:kind kind :subject id :defect :missing-required-key :key k})
    61	     (for [k (keys m) :when (not (contains? allowed k))]
    62	       {:kind kind :subject id :defect :undeclared-key :key k})
    63	     (for [[k allowed-vals] enums :when (contains? m k)
    64	           :when (not (contains? allowed-vals (get m k)))]
    65	       {:kind kind :subject id :defect :value-outside-declared-set
    66	        :key k :value (get m k) :declared allowed-vals}))))
    67	
    68	(defn validate
    69	  "Every rule the ledger's :rules strings state, mechanised. Returns a vector of
    70	   defect maps; empty means the ledger conforms."
    71	  [ledger]
    72	  (let [schema (:ledger/schema ledger)
    73	        tensions (:tensions ledger)
    74	        events (:events ledger)
    75	        t-ids (set (map :tension/id tensions))
    76	        shape (concat (mapcat #(check-map :tension (:tension schema) %) tensions)
    77	                      (mapcat #(check-map :event (:event schema) %) events))
    78	        by-tension (group-by :event/tension events)]
    79	    (vec
    80	     (concat
    81	      shape
    82	      ;; poles are exactly two, both non-blank
    83	      (for [t tensions
    84	            :let [p (:tension/poles t)]
    85	            :when (not (and (vector? p) (= 2 (count p)) (every? #(and (string? %) (not (str/blank? %))) p)))]
    86	        {:kind :tension :subject (:tension/id t) :defect :poles-are-not-two-named-poles :value p})
    87	      ;; ids unique
    88	      (for [[id n] (frequencies (map :tension/id tensions)) :when (> n 1)]
    89	        {:kind :tension :subject id :defect :duplicate-tension-id :n n})
    90	      (for [[id n] (frequencies (map :event/id events)) :when (> n 1)]
    91	        {:kind :event :subject id :defect :duplicate-event-id :n n})
    92	      ;; seq unique and ascending across the whole ledger
    93	      (for [[s n] (frequencies (map :event/seq events)) :when (> n 1)]
    94	        {:kind :event :subject s :defect :duplicate-event-seq :n n})
    95	      (when (not= (map :event/seq events) (sort (map :event/seq events)))
    96	        [{:kind :ledger :subject :events :defect :event-seq-not-ascending
    97	          :value (mapv :event/seq events)}])
    98	      ;; every event names an existing tension
    99	      (for [e events :when (not (contains? t-ids (:event/tension e)))]
   100	        {:kind :event :subject (:event/id e) :defect :event-names-no-such-tension
   101	         :value (:event/tension e)})
   102	      ;; exactly one mint per tension, and it is that tension's lowest seq
   103	      (mapcat
   104	       (fn [t]
   105	         (let [es (sort-by :event/seq (get by-tension (:tension/id t)))
   106	               mints (filter #(= :carried (:event/type %)) es)]
   107	           (concat
   108	            (when (not= 1 (count mints))
   109	              [{:kind :tension :subject (:tension/id t) :defect :not-exactly-one-mint-event
   110	                :n (count mints)}])
   111	            (when (and (seq es) (seq mints) (not= (:event/id (first es)) (:event/id (first mints))))
   112	              [{:kind :tension :subject (:tension/id t) :defect :mint-is-not-the-first-event
   113	                :first (:event/id (first es))}])
   114	            ;; :tension/status is the status AT MINT
   115	            (when (and (seq mints) (not= (:tension/status t) (:event/type (first mints))))
   116	              [{:kind :tension :subject (:tension/id t) :defect :status-field-is-not-the-mint-status
   117	                :field (:tension/status t) :mint (:event/type (first mints))}]))))
   118	       tensions)
   119	      ;; a status move needs evidence AND the row that moved it
   120	      (for [e events
   121	            :when (and (contains? status-moving (:event/type e))
   122	                       (not= :carried (:event/type e)))
   123	            :when (or (empty? (:event/evidence e)) (nil? (:event/row e)))]
   124	        {:kind :event :subject (:event/id e) :defect :status-move-without-row-or-evidence
   125	         :type (:event/type e) :row (:event/row e) :evidence-count (count (:event/evidence e))})
   126	      ;; :evidence-added never moves status
   127	      (for [e events
   128	            :when (and (= :evidence-added (:event/type e)) (contains? (set (keys e)) :event/to-status))]
   129	        {:kind :event :subject (:event/id e) :defect :evidence-added-carries-a-status})
   130	      ;; nothing follows a terminal event for the same tension
   131	      (mapcat
   132	       (fn [[tid es]]
   133	         (let [es (sort-by :event/seq es)
   134	               terminal-at (first (keep-indexed
   135	                                   (fn [i e] (when (contains? terminal-statuses (:event/type e)) i))
   136	                                   es))]
   137	           (when (and terminal-at (some #(contains? status-moving (:event/type %))
   138	                                        (drop (inc terminal-at) es)))
   139	             [{:kind :tension :subject tid :defect :status-move-after-a-terminal-event}])))
   140	       by-tension)))))
   141	
   142	(defn append-tension!
   143	  "Validated append-only API. Replaying the identical pair is a no-op; any
   144	  partial/conflicting identity or invalid ledger is refused before writing."
   145	  [tension event]
   146	  (let [ledger (edn/read-string (slurp ledger-path))
   147	        existing-defects (validate ledger)
   148	        old-t (some #(when (= (:tension/id tension) (:tension/id %)) %) (:tensions ledger))
   149	        old-e (some #(when (= (:event/id event) (:event/id %)) %) (:events ledger))]
   150	    (when (seq existing-defects)
   151	      (throw (ex-info "existing tension ledger is invalid" {:defects existing-defects})))
   152	    (cond
   153	      (and (= tension old-t) (= event old-e))
   154	      {:status :already-present :tension/id (:tension/id tension)}
   155	
   156	      (or old-t old-e)
   157	      (throw (ex-info "refusal identity conflicts with an existing append"
   158	                      {:tension/id (:tension/id tension) :event/id (:event/id event)}))
   159	
   160	      :else
   161	      (let [next-seq (inc (reduce max 0 (map :event/seq (:events ledger))))
   162	            candidate (-> ledger
   163	                          (update :tensions conj tension)
   164	                          (update :events conj (assoc event :event/seq next-seq)))
   165	            defects (validate candidate)]
   166	        (when (seq defects)
   167	          (throw (ex-info "proposed tension append is invalid" {:defects defects})))
   168	        (let [tmp (io/file lab "tension-ledger.edn.u41-append")]
   169	          (spit tmp (str (with-out-str (pp/pprint candidate))))
   170	          (java.nio.file.Files/move
   171	           (.toPath tmp) (.toPath ledger-path)
   172	           (into-array java.nio.file.CopyOption
   173	                       [java.nio.file.StandardCopyOption/ATOMIC_MOVE
   174	                        java.nio.file.StandardCopyOption/REPLACE_EXISTING])))
   175	        {:status :appended :tension/id (:tension/id tension)}))))
   176	
   177	;; ---------------------------------------------------------------------------
   178	;; (b) The fold: current status is the last status-moving event.
   179	;; ---------------------------------------------------------------------------
   180	
   181	(defn current-status [ledger tension-id]
   182	  (let [es (->> (:events ledger)
   183	                (filter #(= tension-id (:event/tension %)))
   184	                (sort-by :event/seq))
   185	        moves (filter #(contains? status-moving (:event/type %)) es)]
   186	    {:tension tension-id
   187	     :status (:event/type (last moves))
   188	     :status-since (:event/at (last moves))
   189	     :moved-by-row (:event/row (last moves))
   190	     :events (count es)

