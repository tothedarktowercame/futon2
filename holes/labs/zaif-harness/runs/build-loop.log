   185	  "Evaluate all mission actions and select via softmax.
   186	   Returns {:action kw :policies [...] :tau float :abstain? bool}"
   187	  [channels tau]
   188	  (let [lambdas default-lambdas
   189	        abstain-threshold 0.55
