diff --git a/futon3c/test/futon3c/transport/invoke_ledger_atomicity_test.clj b/futon3c/test/futon3c/transport/invoke_ledger_atomicity_test.clj
index 02500980a54bb707df620f60c5f07a20edb090f7..885d2b8bef59e02722687d12257315240a6267cf
--- a/futon3c/test/futon3c/transport/invoke_ledger_atomicity_test.clj
