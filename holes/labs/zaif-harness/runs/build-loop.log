(defn- active-invoke-jobs
  [ledger]
  (let [cached @!active-invoke-job-index
        index (if (identical? ledger (:ledger cached))
                cached
                (rebuild-active-invoke-job-index! ledger))]
    (keep #(get-in ledger [:jobs %]) (:job-ids index))))

