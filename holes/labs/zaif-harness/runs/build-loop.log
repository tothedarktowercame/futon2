    77	  (let [row (actand/calibration-density
    78	             (sessions)
    79	             {:route :gamma :correction-label true}
    80	             :ask)
    81	        bridged (actand/demo-bridge row)
    82	        hydrated (inputs/hydrate-inputs {:actand-query-result bridged})
    83	        decision (controller/decide hydrated)
    84	        expected (* (:act-pragmatic-scale controller/constants)
    85	                    (:gamma-used decision)
    86	                    (- (Math/log (double 9/14)) (Math/log 0.5)))]
