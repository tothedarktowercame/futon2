    98	    (is (= :q-actand/demo-bridge-a4
    99	           (get-in hydrated [:task-belief :bridge])))
   100	    (is (nil? (get-in hydrated [:task-belief :refused])))
   101	    (is (not (zero? (get-in decision [:g-terms :act]))))
   102	    (is (= expected (get-in decision [:g-terms :act])))))

