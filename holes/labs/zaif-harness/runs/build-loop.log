   187	(defn softmax
   188	  "Compute softmax probabilities from logits."
   189	  [logits]
   190	  (let [max-l (apply max logits)
   191	        exps (mapv #(Math/exp (- % max-l)) logits)
   192	        sum (reduce + exps)]
   193	    (mapv #(/ % sum) exps)))
   194	
   195	(defn posterior-entropy
   196	  "Normalized Shannon entropy of the action-posterior P(a) ∝ exp(−G/τ) over a set of
   197	   action G-values. 1.0 = a maximally flat field (every action equally (un)preferred →
   198	   maximal uncertainty over which action helps); 0.0 = a clear winner. This IS the
   199	   expected-information-gain available to a structure-acquiring action (M-wm-policies
   200	   Track 3 / AIF grounding): the uncertainty that acquiring new policy could resolve —
   201	   a real information-theoretic quantity, not a flatness heuristic."
   202	  [gs tau]
   203	  (let [t (max (double (or tau 1.0)) 0.1)
   204	        probs (softmax (mapv (fn [g] (/ (- (double g)) t)) gs))
   205	        n (count probs)

