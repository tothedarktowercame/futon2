 :edges
 [{:from :realtime/liveness-heartbeats
   :to :realtime/listener-leases
   :relation :detection-precedes-expiry
   :source "futon3c/holes/missions/M-IRC-stability.md:37-40,97 and src/futon3c/transport/irc.clj:391-410,629-643"
   :reading "The keepalive loop's PING/PONG stall detection is what fires the reap: liveness detection decides WHICH lease is expired (keepalive-reap at irc.clj:404), and nick-ghost?/kill-ghost! (irc.clj:219-235,274-275) expire the stale instance on reclaim."}
  {:from :realtime/listener-leases
   :to :realtime/loop-failure-signals
   :relation :expiry-surfaces-as-evidence
   :source "futon3c/holes/missions/M-IRC-stability.md:96 and src/futon3c/transport/irc.clj:45,404-409,639-643"
   :reading "Reaping, ghost-killing, and keepalive errors are emitted as evidence tensions through emit-error-evidence! rather than swallowed -- the mission's F3 invariant that no exception is silently discarded anywhere in irc.clj."}]
 :rules
 [{:id :require-server-initiated-liveness-probes
   :member :realtime/liveness-heartbeats
   :then-source "library/realtime/liveness-heartbeats.flexiarg:19"
   :interpretation-class :attested
   :interpretation
   "Require heartbeats with sequence/activity context; a stalled instance (missed PONG beyond the timeout, no traffic resetting the timer) must be flagged with the reason and reconnected or shut down."
   :attestation "futon3c/holes/missions/M-IRC-stability.md:37-40 (F1 'Pattern: realtime/liveness-heartbeats -- server MUST initiate periodic probes') and :112-135 (the implemented keepalive loop: interval, timeout, any-traffic reset); irc.clj:629-643,415-425; irc_test.clj:409+ (section 11)"}
  {:id :expire-stale-instances-not-silently-keep-them
   :member :realtime/listener-leases
   :then-source "library/realtime/listener-leases.flexiarg:19"
   :interpretation-class :attested
   :interpretation
   "Versioned listener identities with expiry: zombie connections are reaped and ghosts killed on nick reclaim, not left indefinitely competing for the nick."
   :attestation "futon3c/holes/missions/M-IRC-stability.md:97 (cross-ref: 'Zombie connections should be reaped, not left indefinitely') and :73-82 (F4 nick reclaim: detect ghost, kill old, register new); irc.clj:219-235,274-275,391-410"}
  {:id :surface-loop-failures-as-evidence
   :member :realtime/loop-failure-signals
   :then-source "library/realtime/loop-failure-signals.flexiarg:19"
   :interpretation-class :attested
   :interpretation
   "Failures in the transport loop are flagged and recorded (evidence tensions), not silently discarded."
   :attestation "futon3c/holes/missions/M-IRC-stability.md:96 (cross-ref: 'Errors must surface at the layer that caused them, not be swallowed') and :138-161 (F3: replace every silent catch with evidence emission); irc.clj:45,404-409,639-643; irc_test.clj:610+ (relay timeout emits tension evidence)"}]
