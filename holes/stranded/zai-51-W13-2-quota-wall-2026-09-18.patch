+(deftest the-scorer-refuses-a-mutated-fold-and-carries-a-valid-one
+  ;; The lane: rank-cascade-actions with a derived :c on the spec. Minimal
+  ;; one-candidate family, same shape as the value-level pin above.
+  (let [d (derived)
+        live-spec (lc/cascade-spec d (conj (:want d) :closed/M-b))
+        produce (first (:want live-spec))
+        state {:cascade-belief {#{} 1}}
+        cand [{:kind :cascade-candidate :id :p1 :precedence
+               [{:id :p1
+                 :guard {:status :interpreted :operator :and
+                         :clauses [{:status :interpreted :present #{} :absent #{}}]}
+                 :transition {:status :interpreted :operator :union :produces #{produce}}
+                 :produces #{produce}}]}]
+        opts+ (fn [c] {:horizon-steps 1 :cascade-spec (assoc live-spec :c c)})
+        run (fn [c] (efe/rank-cascade-actions state cand (opts+ c)))]
+    (testing "a valid derived C scores and the attached spec carries the fold order"
+      (let [r (run {:status :derived :signature "s"})]
+        (is (not (:status r)) (pr-str (select-keys r [:status :kind])))
+        (is (= [:ruled-outcome-c :c-int :c-ser :c-mis]
+               (get-in r [:meta :cascade-scoring :spec :c :ordered-layers])))))
+    (testing "a mutated fold refuses before scoring, typed"
+      (let [r (run {:status :derived :signature "s"
+                    :ordered-layers [:c-int :ruled-outcome-c :c-ser :c-mis]})]
+        (is (= :missing (:status r)))
+        (is (= :preference-layer-revision-mismatch (:kind r)))))
+    (testing "the uniform default path is byte-identical: no :c key scores as before"
+      (let [r (run nil)]
+        (is (not (:status r)))
+        (is (= :uniform-declared-constant
+               (get-in r [:meta :cascade-scoring :spec :c :status])))))))
