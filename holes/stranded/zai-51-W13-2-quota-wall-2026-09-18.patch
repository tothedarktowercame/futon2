diff --git a/src/futon2/aif/ruled_outcome_c.clj b/src/futon2/aif/ruled_outcome_c.clj
index 06ebd0e3..ece411ce 100644
--- a/src/futon2/aif/ruled_outcome_c.clj
+++ b/src/futon2/aif/ruled_outcome_c.clj
@@ -100,6 +100,46 @@
 
 (def machine-preference-schema :wm/machine-preference-v1)
 
+(def fold-layer-order
+  "The authoritative ordered layer identities of the fold declaration, for
+   provenance attachment at the consumer (WM-13-delivery W13-2). This is
+   DECLARATION plumbing only: it makes the family's exact identities, order
+   and composition-axis VISIBLE on the scoring path; it decides nothing
+   about the ruled-sum composition (that is checklist WM-13 behind
+   AUTH-mission-preferences) and it does not adjudicate :c-mis's owed
+   ruling."
+  (mapv :layer/id fold-declaration))
+
+(defn attach-fold-provenance
+  "Validate and complete a DERIVED C's fold provenance (W13-2). Given the
+   {:status :derived …} map a WIRE-3-style caller attaches to the spec's :c:
+   - with no :ordered-layers, attach the authoritative order (the caller
+     derived the whole live C; the fold it rode is the declaration's);
+   - with :ordered-layers present, they must EQUAL the declaration's order
+     exactly -- a mutated, reordered or partial layer list is the typed
+     refusal :preference-layer-revision-mismatch (the same refusal
+     `construct-machine-preference` raises on a mutated `:layers`), never a
+     silent acceptance;
+   - the per-layer declaration (ids, composition-axis, source, folded?,
+     in-ruled-sum) rides along under :fold, so the consumer can see which
+     layers are folded, which are not, and that :c-mis's sum-membership is
+     :undeclared rather than silently decided.
+   Non-derived maps pass through unchanged (byte-identical default path)."
+  [{:keys [status ordered-layers] :as c}]
+  (if (not= :derived status)
+    c
+    (if (and (some? ordered-layers)
+             (not= ordered-layers (mapv :layer/id fold-declaration)))
+      {:status :missing
+       :kind :preference-layer-revision-mismatch
+       :declared ordered-layers
+       :fold (mapv :layer/id fold-declaration)
+       :limitation "a derived C carries the fold declaration's exact layer order; a mutated list is a revision mismatch, not a scoring input"}
+      (assoc c
+             :ordered-layers (mapv :layer/id fold-declaration)
+             :fold (mapv #(select-keys % [:layer/id :composition-axis :source :folded? :in-ruled-sum])
+                         fold-declaration)))))
+
 (defn- refuse!
   [kind path]
   {:ok false :refusal {:kind kind :path path}})
